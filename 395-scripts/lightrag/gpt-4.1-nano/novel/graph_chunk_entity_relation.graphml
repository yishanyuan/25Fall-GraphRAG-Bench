    <node id="Hoop-skirt">
      <data key="d0">Hoop-skirt</data>
      <data key="d1">concept</data>
      <data key="d2">The hoop-skirt was a symbol of loyalty to the Confederacy, often sent by Southern ladies to lukewarm supporters.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88</data>
      <data key="d4">unknown_source</data>
