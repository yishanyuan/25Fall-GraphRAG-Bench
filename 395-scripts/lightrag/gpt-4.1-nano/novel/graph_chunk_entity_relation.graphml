    </node>
    <node id="Old Hickory">
      <data key="d0">Old Hickory</data>
      <data key="d1">person</data>
      <data key="d2">Old Hickory is a nickname for Andrew Jackson, referencing his role in the victory at New Orleans.</data>
      <data key="d3">chunk-63ada5b526daab8bb42bced4bd5ee488</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607664</data>
