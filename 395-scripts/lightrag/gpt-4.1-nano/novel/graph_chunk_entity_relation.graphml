    <node id="Sufficiently Satisfied Human">
      <data key="d0">Sufficiently Satisfied Human</data>
      <data key="d1">person</data>
      <data key="d2">A human being whose primitive wants of nature are mostly satisfied, acting habitually or from immediate promptings rather than deliberate planning.</data>
      <data key="d3">chunk-b32192ddb2993846ee52feb248ad5d6f</data>
