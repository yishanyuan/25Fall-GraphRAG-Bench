    </node>
    <node id="Statue">
      <data key="d0">Statue</data>
      <data key="d1">artifact</data>
      <data key="d2">A headless reclining tiger statue representing a wounded tiger, found during excavation, indicative of ritual or burial practices.&lt;SEP&gt;A colossal headless statue found near the burial site, now housed in the National Museum of Mexico.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf</data>
