    <node id="Mr. Elton">
      <data key="d0">Mr. Elton</data>
      <data key="d1">person</data>
      <data key="d2">Mr. Elton resided in Mazagran for several months and provided an estimate of its population.&lt;SEP&gt;Mr. Elton, a resident of Mazagran, provided population estimates for the town.</data>
      <data key="d3">chunk-6706573dac6e75677a74dc1ef5caf318&lt;SEP&gt;chunk-3fb3f38fdfb7168489cd1fb4adcb2515</data>
