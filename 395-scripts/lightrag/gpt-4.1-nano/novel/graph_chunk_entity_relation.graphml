    <node id="Religious Attitude">
      <data key="d0">Religious Attitude</data>
      <data key="d1">concept</data>
      <data key="d2">Mixtus feels shame about his former religion, viewing it as an old attachment kept in privacy, demonstrating his shifting religious stance.</data>
      <data key="d3">chunk-389b8ee79aa909c057f01fc6f9637036</data>
      <data key="d4">unknown_source</data>
