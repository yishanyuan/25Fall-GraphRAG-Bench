    <node id="Wittenberg">
      <data key="d0">Wittenberg</data>
      <data key="d1">location</data>
      <data key="d2">Wittenberg is a Hamburg journalist who corresponded with Jacobi about the manufacture of horn snuff-boxes and their legends.&lt;SEP&gt;Wittenberg is a location associated with letters and sources related to Sterne.&lt;SEP&gt;Wittenberg is a city, historically significant, mentioned among references.</data>
      <data key="d3">chunk-9e8429a197795773b69fd79fc5921e1e&lt;SEP&gt;chunk-5306de19c5ab05feb0d4d09c44ca2fc1&lt;SEP&gt;chunk-bba52ca6db0e619b578b5cf52494e654</data>
