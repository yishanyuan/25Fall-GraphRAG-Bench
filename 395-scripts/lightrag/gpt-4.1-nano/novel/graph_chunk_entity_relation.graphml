    <node id="Juvenal">
      <data key="d0">Juvenal</data>
      <data key="d1">person</data>
      <data key="d2">Juvenal was a Roman poet who provided insights into Roman social customs, including reclining at meals and the practice of wearing rings.&lt;SEP&gt;Juvenal was a Roman poet, known for his satires that depict Roman society and include references to punishments and social customs.</data>
      <data key="d3">chunk-52ca25c65db54cb74a2c1bd788c198c8&lt;SEP&gt;chunk-5208b8728c96888e457d542e0fba49b2&lt;SEP&gt;chunk-bfdf9595877dab30524e561a06dbcca6</data>
