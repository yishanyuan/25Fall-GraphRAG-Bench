      <data key="d0">Edmund Bailey O'Callaghan</data>
      <data key="d1">person</data>
      <data key="d2">Editor of the Montreal _Vindicator_, supporter of Papineau and the Patriot cause.&lt;SEP&gt;Edmund Bailey O'Callaghan is a lieutenant involved with Papineau and resisting government forces.</data>
      <data key="d3">chunk-1fc668a337064f7982e9ba35184cf528&lt;SEP&gt;chunk-5f60868fc120dda4e8b845c8a6db7921</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
    <node id="Canadian Border">
      <data key="d0">Canadian Border</data>
      <data key="d1">location</data>
      <data key="d2">The Canadian border is the boundary crossing point from the United States into Canada, utilized by the insurgents.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
    <node id="Missisquoi Volunteers">
      <data key="d0">Missisquoi Volunteers</data>
      <data key="d1">organization</data>
      <data key="d2">The Missisquoi Volunteers are a militia unit acting as escort to a convoy of arms and ammunition, commanded by Captain Kemp.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
    <node id="Bouchette">
      <data key="d0">Bouchette</data>
      <data key="d1">person</data>
      <data key="d2">Bouchette was a rebel commander in the advance-guard who was wounded in the engagement at Moore's Corners.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2&lt;SEP&gt;chunk-3e6059f7b6685e9fbba6db55d93c65ee&lt;SEP&gt;chunk-92528df8108a5a90a2c2b6e9d79fa6a7</data>
