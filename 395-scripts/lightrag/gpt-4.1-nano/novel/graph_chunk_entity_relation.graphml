    <node id="Southern Ladies">
      <data key="d0">Southern Ladies</data>
      <data key="d1">person</data>
      <data key="d2">Southern ladies were strong secession supporters who sent hoop skirts as symbols of loyalty.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88</data>
      <data key="d4">unknown_source</data>
