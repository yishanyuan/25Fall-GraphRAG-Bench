    <node id="Strange People">
      <data key="d0">Strange People</data>
      <data key="d1">other</data>
      <data key="d2">Strange People are unidentified visitors emerging from the thicket, possibly indigenous or unknown travelers, observed by the narrator and his men.</data>
      <data key="d3">chunk-f65c2b617b2b75df32a484e145b034fe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606699</data>
      <data key="d6" />
