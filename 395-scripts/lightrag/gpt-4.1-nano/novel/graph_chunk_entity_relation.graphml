    </node>
    <node id="Rocky Mountains">
      <data key="d0">Rocky Mountains</data>
      <data key="d1">location</data>
      <data key="d2">The Rocky Mountains contain abundant and varied marble deposits.&lt;SEP&gt;The Rocky Mountains contain abundant granite, but it is rarely quarried in California.&lt;SEP&gt;The Rocky Mountains are a major mountain range in North America, known for snowy regions and outdoor activities such as hunting and trapping.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7&lt;SEP&gt;chunk-a09a3405b807f7a33064172d2e463326&lt;SEP&gt;chunk-a4ecf42e13f0e671845a3cd5496327f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764612179</data>
      <data key="d6" />
    </node>
    <node id="Wales">
      <data key="d0">Wales</data>
      <data key="d1">location</data>
      <data key="d2">Wales supplies slate used in the United States, historically significant for roofing and gravestones.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611635</data>
      <data key="d6" />
    </node>
    <node id="Northampton County">
      <data key="d0">Northampton County</data>
      <data key="d1">location</data>
      <data key="d2">Northampton County, Pennsylvania, had slate quarries operating as early as 1805.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611635</data>
      <data key="d6" />
    </node>
