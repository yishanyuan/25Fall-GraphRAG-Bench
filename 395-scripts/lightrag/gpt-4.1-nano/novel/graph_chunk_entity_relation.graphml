    </node>
    <node id="Christian Martyrs">
      <data key="d0">Christian Martyrs</data>
      <data key="d1">person</data>
      <data key="d2">Christian martyrs are individuals who chose to face death rather than deny their faith, often burned or massacred for their beliefs.</data>
      <data key="d3">chunk-b6ec6b33bad7d855f63b027ce155c41b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608173</data>
