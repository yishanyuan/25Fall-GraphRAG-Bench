    </node>
    <node id="Aroeris">
      <data key="d0">Aroeris</data>
      <data key="d1">person</data>
      <data key="d2">Aroeris is identified as a brother of Osiris, involved in mythological stories.&lt;SEP&gt;Aroeris is a brother of Osiris, Isis, Typho, and Nephthis, associated with being a peacemaker in mythology.</data>
      <data key="d3">chunk-06e492003a084ec018b849a310a4e995&lt;SEP&gt;chunk-a7dc5cd694c8e04568651d4ad21b8623</data>
