    <node id="Asshur">
      <data key="d0">Asshur</data>
      <data key="d1">deity</data>
      <data key="d2">Asshur is the supreme god of the Assyrians, whose name may derive from the Maya word "Axul," meaning "thy end," representing divine authority.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
