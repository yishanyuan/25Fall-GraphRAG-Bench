      <data key="d3">chunk-03c5035205433abd8b211b1d1712aea6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613935</data>
      <data key="d6" />
    </node>
    <node id="The Oliphant">
      <data key="d0">The Oliphant</data>
      <data key="d1">artifact</data>
      <data key="d2">A hunting horn, with fine specimens in the South Kensington collection, used for hunting signals.</data>
      <data key="d3">chunk-03c5035205433abd8b211b1d1712aea6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613935</data>
      <data key="d6" />
    </node>
    <node id="The Sackbut">
      <data key="d0">The Sackbut</data>
      <data key="d1">artifact</data>
      <data key="d2">Old musical instrument, likely made of metal, capable of altering pitch by lengthening or shortening, resembling the modern trombone, with origins possibly from _sambuca_.</data>
      <data key="d3">chunk-03c5035205433abd8b211b1d1712aea6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613935</data>
      <data key="d6" />
    </node>
    <node id="Medieval Wind Instruments">
      <data key="d0">Medieval Wind Instruments</data>
      <data key="d1">content</data>
      <data key="d2">Medieval wind instruments include the _chorus_, _flutes_, _syrinx_, _frestle_, _fretel_, and _fretiau_, demonstrating a variety of forms and constructions used during the Middle Ages.</data>
      <data key="d3">chunk-03c5035205433abd8b211b1d1712aea6</data>
      <data key="d4">unknown_source</data>
