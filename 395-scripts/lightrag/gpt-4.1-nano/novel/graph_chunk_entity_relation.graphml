    <node id="Vow">
      <data key="d0">Vow</data>
      <data key="d1">concept</data>
      <data key="d2">A vow is a promise or prayer made to the gods, signified by placing the hand in liquid and pressing it on temple walls.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606695</data>
