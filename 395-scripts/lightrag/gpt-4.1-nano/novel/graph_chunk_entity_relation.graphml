      <data key="d1">concept</data>
      <data key="d2">Ganeza is a deity represented with an elephant's head, worshipped in Hindu tradition, related to similar symbols in other cultures.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606695</data>
