    <node id="Water Currents">
      <data key="d0">Water Currents</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Subterranean water currents are found in caves and senotes, some are dry, others contain thermal mineral water, and they connect to underground sources.</data>
      <data key="d3">chunk-8a980d05b1d871a902a88d111d028517</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606705</data>
      <data key="d6" />
    </node>
    <node id="Ancient City of Mayapan">
      <data key="d0">Ancient City of Mayapan</data>
      <data key="d1">location</data>
      <data key="d2">Nearby small sheets of water or aguadas near Mayapan are fed by underground streams; these areas are historically significant and contain water sources.</data>
      <data key="d3">chunk-8a980d05b1d871a902a88d111d028517</data>
      <data key="d4">unknown_source</data>
