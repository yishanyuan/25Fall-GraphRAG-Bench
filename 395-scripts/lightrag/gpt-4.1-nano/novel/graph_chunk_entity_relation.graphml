    <node id="Le Canadien">
      <data key="d0">Le Canadien</data>
      <data key="d1">organization</data>
      <data key="d2">Le Canadien was a newspaper founded in 1806 to defend French Canadians' interests and oppose British and provincial authorities.&lt;SEP&gt;Le Canadien was a newspaper involved in political conflicts, publishing notes about the governor and the House of Assembly, and was suppressed by Craig.</data>
      <data key="d3">chunk-b39e2cfb1e3f641af2dc7d617761e850&lt;SEP&gt;chunk-c71f776a39a2f6e419cd9e7dc482a99e</data>
