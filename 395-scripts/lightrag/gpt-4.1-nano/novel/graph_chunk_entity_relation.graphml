    </node>
    <node id="Dr. Foster">
      <data key="d0">Dr. Foster</data>
      <data key="d1">person</data>
      <data key="d2">Dr. Foster was the editor of the Minnesotian, a powerful and irascible figure in Minnesota politics.&lt;SEP&gt;Dr. Foster is a critic of Governor Sibley, questioning his sincerity and denouncing him during political campaigns.&lt;SEP&gt;Dr. Foster was involved in the rivalry between the Minnesotian and the St. Paul Daily Press, eventually surrendering to the latter.&lt;SEP&gt;Dr. Foster bought interest in the Minnesotian from George W. Moore in 1860.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42&lt;SEP&gt;chunk-46289654522dd0ee1ffdeb77be06722d&lt;SEP&gt;chunk-13efecfdb402b12d9a005785fb5d0e8f&lt;SEP&gt;chunk-2a3ab772f4c7d1211b5007a6c92e23da</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610007</data>
      <data key="d6" />
    </node>
    <node id="George W. Armstrong">
      <data key="d0">George W. Armstrong</data>
      <data key="d1">person</data>
      <data key="d2">George W. Armstrong was a well-dressed printer, foreman of the old Pioneer, and later involved in real estate.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610007</data>
