      <data key="d5">1764614596</data>
      <data key="d6" />
    </node>
    <node id="Ground/Grass">
      <data key="d0">Ground/Grass</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Tufts of grass and irregularities of ground serve as additional grasp points for the hawk when capturing prey.</data>
      <data key="d3">chunk-712990bb2ebe5d62b532d770bfe4b95c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614596</data>
