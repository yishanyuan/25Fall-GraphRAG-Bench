      <data key="d0">Jeewan Shah</data>
      <data key="d1">person</data>
      <data key="d2">Jeewan Shah was a renowned virtuoso on the vina, active approximately one hundred years ago.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613899</data>
      <data key="d6" />
    </node>
    <node id="Hindu Musical Scale">
      <data key="d0">Hindu Musical Scale</data>
      <data key="d1">concept</data>
      <data key="d2">Hindus traditionally divided their musical scale into intervals called sruti, which are smaller than modern semitones and comparable to chromatic intervals.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613899</data>
      <data key="d6" />
    </node>
    <node id="Ravanastron">
      <data key="d0">Ravanastron</data>
      <data key="d1">artifact</data>
      <data key="d2">The Ravanastron is an ancient Hindu string instrument played with a bow, believed to be invented about five thousand years ago by the king Ravanon of Ceylon.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613899</data>
      <data key="d6" />
    </node>
    <node id="Chinese Fiddle (Ur-Heen)">
      <data key="d0">Chinese Fiddle (Ur-Heen)</data>
      <data key="d1">artifact</data>
      <data key="d2">The Ur-heen is a Chinese string instrument with two strings and a body made from a small hollowed wood block covered with serpent skin, closely related to the Ravanastron.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613899</data>
      <data key="d6" />
    </node>
    <node id="Poongi">
      <data key="d0">Poongi</data>
      <data key="d1">artifact</data>
      <data key="d2">The Poongi, also called Toumrie and Magoudi, is a high antiquity Hindu instrument similar to a bagpipe, made with gourds or Cuddos nuts and used by snake charmers.&lt;SEP&gt;The Poongi is a traditional Hindu musical instrument made from a hollowed gourd or Cuddos nut with two pipes inserted, resembling a bagpipe in appearance and used by snake charmers.&lt;SEP&gt;Poongi is a Hindu wind instrument.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6&lt;SEP&gt;chunk-662dfab4657790a73298dc9f0446a502&lt;SEP&gt;chunk-e04d5c85cef72f59528c1fcf81f532ec</data>
      <data key="d4">unknown_source</data>
