      <data key="d0">Ttahuatyn-suyu</data>
      <data key="d1">location</data>
      <data key="d2">Ttahuatyn-suyu refers to the four provinces governed by a great king, linking political organization with the symbolism of four in ancient civilizations.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606704</data>
      <data key="d6" />
