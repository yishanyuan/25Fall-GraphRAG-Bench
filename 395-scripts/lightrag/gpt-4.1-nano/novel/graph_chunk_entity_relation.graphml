    <node id="Tierra de Guerra">
      <data key="d0">Tierra de Guerra</data>
      <data key="d1">location</data>
      <data key="d2">Tierra de Guerra is a land area where tribes like the Itzaes and others preserve their ancient customs, language, and manners.&lt;SEP&gt;The Tierra de Guerra refers to a region in Yucatan where the indigenous inhabitants continue to wear traditional dress.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28&lt;SEP&gt;chunk-965b5b39cb58a29f56a43495ef18b6ff</data>
