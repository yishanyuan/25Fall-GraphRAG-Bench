      <data key="d0">Gaze of Gazelles</data>
      <data key="d1">creature</data>
      <data key="d2">Gazelles are fast animals migrating across plains, observed during camp excursions and capable of outrunning greyhounds.</data>
      <data key="d3">chunk-232907dd57f71debadc62dcfe71c8543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614600</data>
