      <data key="d1">concept</data>
      <data key="d2">Social questions encompass Mixtus’s reflections on social duties, charity, and the fluctuation of his own social views.</data>
      <data key="d3">chunk-389b8ee79aa909c057f01fc6f9637036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608170</data>
