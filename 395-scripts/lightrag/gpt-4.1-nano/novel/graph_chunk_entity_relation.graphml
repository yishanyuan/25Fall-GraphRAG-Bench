    <node id="Rollitt's Woman's Suffrage Bill">
      <data key="d0">Rollitt's Woman's Suffrage Bill</data>
      <data key="d1">concept</data>
      <data key="d2">A legislative bill related to women's suffrage introduced by Rollitt, representing an effort to secure voting rights for women.</data>
      <data key="d3">chunk-0440f793586398094204255524bc8f27</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607234</data>
