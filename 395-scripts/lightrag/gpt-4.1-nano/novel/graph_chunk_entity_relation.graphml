    <node id="Fort Lafayette">
      <data key="d0">Fort Lafayette</data>
      <data key="d1">location</data>
      <data key="d2">Fort Lafayette was a prison in New York where Wentworth was incarcerated after his dismissal from the First Minnesota regiment.&lt;SEP&gt;Fort Lafayette is a military prison where some political prisoners, including the subject, were held.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42&lt;SEP&gt;chunk-be8b49c919bf06f613da48187833e98b</data>
