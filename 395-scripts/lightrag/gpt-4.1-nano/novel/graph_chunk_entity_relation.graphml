    </node>
    <node id="Boilers">
      <data key="d0">Boilers</data>
      <data key="d1">organization</data>
      <data key="d2">Boilers generate steam for engines and other equipment in industrial settings, integral to steam power systems.</data>
      <data key="d3">chunk-71cddd01942506b370eb0f0964d4bbe0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611679</data>
      <data key="d6" />
    </node>
    <node id="Transmission">
      <data key="d0">Transmission</data>
      <data key="d1">method</data>
      <data key="d2">Transmission refers to the systems used to transfer power from engines and boilers to machinery, including shafting and gearing.</data>
      <data key="d3">chunk-71cddd01942506b370eb0f0964d4bbe0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611679</data>
