      <data key="d0">Negress Slaves</data>
      <data key="d1">other</data>
      <data key="d2">Negress slaves are part of the population in Nefta, indicating social and racial composition.</data>
      <data key="d3">chunk-54d2a15489fc52241d68e4fa40e99203</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614544</data>
      <data key="d6" />
    </node>
    <node id="Blad-Sidi-Hasham">
      <data key="d0">Blad-Sidi-Hasham</data>
      <data key="d1">location</data>
      <data key="d2">Blad-Sidi-Hasham is a district that forms a free and quasi-independent state, founded in 1810 by the Emir Hasham.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
    <node id="Emir Hasham">
      <data key="d0">Emir Hasham</data>
      <data key="d1">person</data>
      <data key="d2">Emir Hasham is the founder of the district of Blad-Sidi-Hasham and son of Shereef Ahmed Ben Mousa.&lt;SEP&gt;Emir Hasham, son of Shereef Ahmed Ben Mousa, founded the semi-independent state of Sous-el-Aksa.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-67512ea13edfd2cab9973f3ae5f8c75d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
    <node id="Shereef Ahmed Ben Mousa">
      <data key="d0">Shereef Ahmed Ben Mousa</data>
      <data key="d1">person</data>
      <data key="d2">Shereef Ahmed Ben Mousa is the ancestor and father of Emir Hasham, associated with the founding of Blad-Sidi-Hasham.&lt;SEP&gt;Shereef Ahmed Ben Mousa is the father of Emir Hasham, associated with the founding of Sous-el-Aksa.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-67512ea13edfd2cab9973f3ae5f8c75d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
    <node id="Talent">
      <data key="d0">Talent</data>
      <data key="d1">location</data>
      <data key="d2">Talent is the residence of Emir Hasham, situated on the declivity of a hill near the river Wad-el-Mesah.&lt;SEP&gt;Talent is the strong city and capital of the province of Sous-el-Aksa, situated on a hill near the district of Sous.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-67512ea13edfd2cab9973f3ae5f8c75d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
