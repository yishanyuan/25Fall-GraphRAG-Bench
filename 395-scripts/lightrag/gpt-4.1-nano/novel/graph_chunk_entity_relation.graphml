    <node id="Hebrew Prophets">
      <data key="d0">Hebrew Prophets</data>
      <data key="d1">person</data>
      <data key="d2">Hebrew prophets are biblical figures who proclaimed God's demand for mercy over sacrifices and emphasized spiritual pre-eminence.</data>
