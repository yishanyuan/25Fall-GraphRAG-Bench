    <node id="Invitation">
      <data key="d0">Invitation</data>
      <data key="d1">event</data>
      <data key="d2">An invitation from Carrie Clark to attend her wedding, indicating social connection and upcoming celebration.</data>
      <data key="d3">chunk-8442dd0527e82eb09ee5eeff266010ae</data>
