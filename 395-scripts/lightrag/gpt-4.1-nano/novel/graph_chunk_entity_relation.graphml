    <node id="Sse-yo">
      <data key="d0">Sse-yo</data>
      <data key="d1">location</data>
      <data key="d2">Sse-yo is the ancient name for China, meaning "the four parts of the empire," symbolizing its territorial division into four regions.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
