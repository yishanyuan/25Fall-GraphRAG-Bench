    <node id="Phallic Worship">
      <data key="d0">Phallic Worship</data>
      <data key="d1">concept</data>
      <data key="d2">Phallic worship is a religious practice identified in the ruins of Uxmal, associated with the Nahualts.</data>
      <data key="d3">chunk-002cf134516b6f6702e5dfec7413096b</data>
