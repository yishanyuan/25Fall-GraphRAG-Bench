    <node id="The 'Patriotes' of '37">
      <data key="d0">The 'Patriotes' of '37</data>
      <data key="d1">content</data>
      <data key="d2">The Patriotes were a political and revolutionary group active during the 1837 rebellion in Lower Canada.&lt;SEP&gt;A work describing the Patriotes movement and the 1837 rebellion advocating for French-Canadian rights.</data>
      <data key="d3">chunk-3fa64029ed13db1a5648cfa72d3549d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609476</data>
