    <node id="Trajan">
      <data key="d0">Trajan</data>
      <data key="d1">person</data>
      <data key="d2">Trajan was a Roman emperor who reconstructed the Circus Maximus, enhancing its grandeur after Nero’s reign.&lt;SEP&gt;Roman emperor who rebuilt the Circus Maximus, restoring it to greater magnificence and capacity.</data>
      <data key="d3">chunk-eb4eb8f1e4cf05e01dcfb95969a6bb79&lt;SEP&gt;chunk-adc0c02df8cb82b091fb73a066662a32</data>
