    </node>
    <node id="Aztecs">
      <data key="d0">Aztecs</data>
      <data key="d1">location</data>
      <data key="d2">The Aztecs were a Nahuatl-speaking civilization in Mexico, known for their preserved musical instruments like pipes and flutes.&lt;SEP&gt;Ancient civilization in Mexico known for their cultural practices, including paying tribute using objects like bells.&lt;SEP&gt;Ancient civilization known for their cultural achievements, including music and elaborate festivals.</data>
      <data key="d3">chunk-93589ec60a74676e9a13006653f3b90f&lt;SEP&gt;chunk-73ed7c284b3a9d9caa2237f4d2af971d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613912</data>
