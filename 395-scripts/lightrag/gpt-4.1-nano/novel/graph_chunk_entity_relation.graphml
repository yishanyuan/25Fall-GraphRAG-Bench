    <node id="Hindu">
      <data key="d0">Hindu</data>
      <data key="d1">location</data>
      <data key="d2">Hindu refers to a member of the religion or culture originating from Hindostan, associated with the mythological and religious context of the text.&lt;SEP&gt;Hindu relates to Indian culture and musical instruments.</data>
      <data key="d3">chunk-f83c27282913cff5172f6cf0dfa303eb&lt;SEP&gt;chunk-662dfab4657790a73298dc9f0446a502</data>
      <data key="d4">unknown_source</data>
