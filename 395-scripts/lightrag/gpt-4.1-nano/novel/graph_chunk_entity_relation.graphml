    <node id="Fatima">
      <data key="d0">Fatima</data>
      <data key="d1">person</data>
      <data key="d2">Fatima is identified as the wife of Ali-Ben-Abou-Thaleb and daughter of Mahomet.&lt;SEP&gt;Fatima was a historical figure whose descendants, including Edris Ben Abdalluh, are highly venerated in Islamic tradition.</data>
      <data key="d3">chunk-feec165bb57c6356de7d23684253d46b&lt;SEP&gt;chunk-5b31b92f9b032efc61f97bef8d8b3ec2</data>
