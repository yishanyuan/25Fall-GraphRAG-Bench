    </node>
    <node id="Telegraph">
      <data key="d0">Telegraph</data>
      <data key="d1">method</data>
      <data key="d2">A communication method used to transmit news and speeches, but initially costly and exclusive.&lt;SEP&gt;The telegraph was the expected method of rapid communication, not available at the time of Minnesota's admission.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e&lt;SEP&gt;chunk-c49b770a2f437d2a1478f52b0f2747ef</data>
