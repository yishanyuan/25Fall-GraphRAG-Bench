      <data key="d0">Private Goods</data>
      <data key="d1">concept</data>
      <data key="d2">Private goods are benefits confined to individuals that can threaten societal wellbeing if overly prioritized at the expense of the public good.</data>
      <data key="d3">chunk-b9481c4e9169907102e1a6a63fadb365</data>
      <data key="d4">unknown_source</data>
