    <node id="Mayan">
      <data key="d0">Mayan</data>
      <data key="d1">culture</data>
      <data key="d2">The Mayas are an indigenous civilization known for their religious practices, art, and customs such as circumcision, as referenced in the narrative.</data>
      <data key="d3">chunk-f65c2b617b2b75df32a484e145b034fe&lt;SEP&gt;chunk-3cf3140092a745267effea6e9a53aa65&lt;SEP&gt;chunk-90130c63183d6c112f655e298f1be97a&lt;SEP&gt;chunk-f83c27282913cff5172f6cf0dfa303eb</data>
