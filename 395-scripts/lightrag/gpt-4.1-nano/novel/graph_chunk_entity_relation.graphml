      <data key="d13" />
    </edge>
    <edge source="Caustic Potash" target="Caustic Soda">
      <data key="d7">1.0</data>
      <data key="d8">Caustic potash and caustic soda are chemically different, though similar in appearance, with the former producing softer, more neutral soap.</data>
      <data key="d9">chemical comparison</data>
      <data key="d10">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764611728</data>
      <data key="d13" />
    </edge>
    <edge source="Pure Caustic Potash" target="Modern Soap Making">
      <data key="d7">1.0</data>
      <data key="d8">Modern process involves dissolving pure caustic potash in water for producing neutral soap.</data>
      <data key="d9">ingredient,process</data>
      <data key="d10">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
      <data key="d11">unknown_source</data>
