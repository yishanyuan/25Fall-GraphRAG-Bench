    <node id="Nahualts">
      <data key="d0">Nahualts</data>
      <data key="d1">people</data>
      <data key="d2">Nahualts are an ancient civilization or influence in Yucatan, associated with the worship of certain symbols and religious practices.&lt;SEP&gt;The Nahualts are a group that invaded the country, destroyed high civilization, and introduced symbols and idolatrous rites.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28&lt;SEP&gt;chunk-002cf134516b6f6702e5dfec7413096b</data>
