    </node>
    <node id="Assyrian Musicians">
      <data key="d0">Assyrian Musicians</data>
      <data key="d1">person</data>
      <data key="d2">The largest known group of Assyrian musicians includes eleven performers playing instruments like harps, dulcimer, double-pipe, and drums, along with singers.</data>
      <data key="d3">chunk-aef18eb73774c5f975cff80e5f2ce51f</data>
