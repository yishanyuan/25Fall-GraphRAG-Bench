    <node id="Potomac">
      <data key="d0">Potomac</data>
      <data key="d1">location</data>
      <data key="d2">Potomac is a river region where soldiers served during the Civil War, associated with the army of the Potomac.&lt;SEP&gt;Potomac area has deposits of inferior sandstone, used historically in construction.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42&lt;SEP&gt;chunk-a09a3405b807f7a33064172d2e463326</data>
