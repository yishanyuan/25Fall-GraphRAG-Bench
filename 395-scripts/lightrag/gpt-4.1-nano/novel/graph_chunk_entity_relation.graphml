    <node id="F">
      <data key="d0">F</data>
      <data key="d1">organization</data>
      <data key="d2">F is an additional crane used for placing ingots into the soaking pits when there is an extraordinarily large output.</data>
      <data key="d3">chunk-c8158e0db68586c52c3a94ca3b5a762c</data>
