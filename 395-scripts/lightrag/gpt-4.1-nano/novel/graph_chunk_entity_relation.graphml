    <node id="Mound Builders">
      <data key="d0">Mound Builders</data>
      <data key="d1">other</data>
      <data key="d2">The Mound Builders refer to ancient peoples who constructed earthworks across the American continent, possibly connected to early architectural developments.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="Sun Circles">
      <data key="d0">Sun Circles</data>
      <data key="d1">content</data>
      <data key="d2">Sun circles are prehistoric ancient monuments, similar across America, Asia, and Egypt, reflecting shared cultural or architectural concepts.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
