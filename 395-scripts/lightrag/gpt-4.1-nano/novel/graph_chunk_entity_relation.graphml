      <data key="d4">unknown_source</data>
      <data key="d5">1764613896</data>
      <data key="d6" />
    </node>
    <node id="Peru">
      <data key="d0">Peru</data>
      <data key="d1">location</data>
      <data key="d2">Peru is the country where priests dramatized scenes from the life of Christ with music during Pizarro’s expedition.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613896</data>
      <data key="d6" />
    </node>
    <node id="Pizarro">
      <data key="d0">Pizarro</data>
      <data key="d1">person</data>
      <data key="d2">Pizarro was a Spanish conquistador whose expedition involved priests using music to convert and fascinate the native Peruvians.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613896</data>
      <data key="d6" />
    </node>
    <node id="Indian Christians">
      <data key="d0">Indian Christians</data>
      <data key="d1">people</data>
      <data key="d2">Indian Christians are the indigenous people of America who continue to perform sacred musical entertainments today.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613896</data>
      <data key="d6" />
    </node>
    <node id="North American Indians">
      <data key="d0">North American Indians</data>
      <data key="d1">people</data>
      <data key="d2">North American Indians are native inhabitants of North America who traditionally use musical instruments like rattles, drums, flutes, and whistles.&lt;SEP&gt;North American Indians who demonstrated innate musical talent prior to oppression and conversion.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68&lt;SEP&gt;chunk-82544a13bf6799b0efc4d2f2a5e62661</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613896</data>
      <data key="d6" />
    </node>
    <node id="Kensington Museum">
      <data key="d0">Kensington Museum</data>
      <data key="d1">organization</data>
      <data key="d2">The Kensington Museum is a museum housing specimens of musical instruments used by North American Indians.&lt;SEP&gt;Kensington Museum is a museum where a cast of a sculpture depicting musicians is kept, associated with historical musical instruments.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68&lt;SEP&gt;chunk-001c1f1b3eee1ad8a7fbb7cf02acea78</data>
      <data key="d4">unknown_source</data>
