      <data key="d0">Woolf Reed Nelson</data>
      <data key="d1">person</data>
      <data key="d2">Wolfred Nelson was a rebel involved in the Canadian rebellion who suffered a milder fate than others.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
