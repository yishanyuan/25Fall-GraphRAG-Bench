      <data key="d0">The Sintominie Hotel</data>
      <data key="d1">location</data>
      <data key="d2">The Sintominie Hotel is a building situated at the corner of Sixth and John streets, constructed by the late C.W. Borup, and was the second hotel visited by the fire king.</data>
      <data key="d3">chunk-5fbf9f440f0bef7a0809b533af91c73a</data>
