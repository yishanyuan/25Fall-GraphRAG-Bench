    <node id="The Register">
      <data key="d0">The Register</data>
      <data key="d1">content</data>
      <data key="d2">The Register was an early Minnesota newspaper that Capt. Shelly was employed by before the consolidation with the Democrat.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610024</data>
