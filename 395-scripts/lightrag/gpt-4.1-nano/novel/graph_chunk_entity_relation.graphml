    </node>
    <node id="Galatea">
      <data key="d0">Galatea</data>
      <data key="d1">goddess</data>
      <data key="d2">Galatea is a Nereid goddess invoked for favorable winds and safe passage.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610596</data>
      <data key="d6" />
    </node>
    <node id="Nereus">
      <data key="d0">Nereus</data>
      <data key="d1">person</data>
      <data key="d2">Nereus is the father of Nereids, invoked for blessings on ships and sailors.&lt;SEP&gt;Nereus is a sea god whose daughter Egeria was associated with Numa, symbolizing divine or mythological companionship.&lt;SEP&gt;Nereus is a Greek divine figure associated with water and credited with creating the lyre from a tortoise-shell.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d&lt;SEP&gt;chunk-4958bc3b034dd7b59c1c0df2fab2b8d5&lt;SEP&gt;chunk-f440a8129c9633e91b0a40eef56e62b1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613910</data>
      <data key="d6" />
    </node>
    <node id="The Sea">
      <data key="d0">The Sea</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Sea is the body of water that surrounds the voyage that Corinna prepares to undertake, emphasizing its dangers.&lt;SEP&gt;The Sea refers to the open water along which the sampan travels, featuring in the scene with the steamer and natural scenery.&lt;SEP&gt;The Sea is the vast body of water surrounding the vessel, providing the setting for the narrative's events and encounters.&lt;SEP&gt;The sea around St. Michael's Mount is described as shallow, safe, and capable of rapid subsidence.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d&lt;SEP&gt;chunk-91f76d58d4ab3a913092d955df41ac90&lt;SEP&gt;chunk-85a79afa2951041547dfe3b8f02f3836&lt;SEP&gt;chunk-cbf86751a46c4cce678f972d8be38307&lt;SEP&gt;chunk-9947d8e5a23dab49c88d36cae1db57a3</data>
      <data key="d4">unknown_source</data>
