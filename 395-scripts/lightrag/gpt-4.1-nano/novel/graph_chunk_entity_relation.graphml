    <node id="Greeley Party">
      <data key="d0">Greeley Party</data>
      <data key="d1">organization</data>
      <data key="d2">The Greeley Party was a group of Arctic explorers who suffered from starvation and freezing and were eventually rescued.</data>
      <data key="d3">chunk-c40e9d9d6bed631bcdf0022bea513804</data>
      <data key="d4">unknown_source</data>
