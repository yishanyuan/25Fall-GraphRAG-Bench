    <node id="Ginkgo">
      <data key="d0">Ginkgo</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Ginkgo is a tree with peculiar venation, with which the described tree has an affinity.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
