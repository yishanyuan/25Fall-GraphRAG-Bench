    <node id="Sir George Cartier">
      <data key="d0">Sir George Cartier</data>
      <data key="d1">person</data>
      <data key="d2">Sir George Cartier was a notable figure who pointed out Mondelet's inclusion in the Executive Council as a step towards responsible government.</data>
