    </node>
    <node id="Wood Yard">
      <data key="d0">Wood Yard</data>
      <data key="d1">location</data>
      <data key="d2">A wood yard on the Mississippi river where Don and Dan Carlo establish a business, near Shirt-Tail Bend.&lt;SEP&gt;A place where wood is bought and sold, central to the community's economy and disputes; run by Don and Dan Carlo.</data>
      <data key="d3">chunk-029587962a0e769bf41beb4d2b181466&lt;SEP&gt;chunk-9a9445e78fa0e5990fbfc82fd7af0897</data>
