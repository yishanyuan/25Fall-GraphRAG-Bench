      <data key="d0">Abiram</data>
      <data key="d1">person</data>
      <data key="d2">Abiram is a Hebrew who, along with Korah and Dathan, challenged divine authority, symbolizing resistance.</data>
      <data key="d3">chunk-03c71c290709c5f72698f04e1bf6628a</data>
