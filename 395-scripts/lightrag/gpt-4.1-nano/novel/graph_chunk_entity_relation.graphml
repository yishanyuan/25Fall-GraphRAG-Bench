      <data key="d0">Jew'ls</data>
      <data key="d1">content</data>
      <data key="d2">Jew'ls refer to the diamonds and pearls, specifically those belonging to the Countess, involved in the theft suspicion and story.</data>
      <data key="d3">chunk-f09ec85f1d57b3ac80db5f54db6bb6f2</data>
