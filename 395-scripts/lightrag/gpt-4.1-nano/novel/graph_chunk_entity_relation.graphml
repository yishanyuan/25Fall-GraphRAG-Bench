    <node id="Naso">
      <data key="d0">Naso</data>
      <data key="d1">person</data>
      <data key="d2">Naso is a character who inscribes curses and religious messages on tablets, expressing emotions related to his inscriptions and interactions with his mistress.&lt;SEP&gt;Naso is a figure who offers vows and prayers for the preservation and well-being of Corinna during labor, involved in divine supplication.</data>
