    <node id="Indian War">
      <data key="d0">Indian War</data>
      <data key="d1">event</data>
      <data key="d2">The Indian War refers to the conflict between U.S. military forces and the Sioux tribe during the outbreak period.&lt;SEP&gt;The conflict involving the Sioux and the U.S. military, considered the only real battle of the war.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-7096033ca5d17f317a3de07c28f9b0bc&lt;SEP&gt;chunk-68a152136647fcdc06015572bf449dc8</data>
