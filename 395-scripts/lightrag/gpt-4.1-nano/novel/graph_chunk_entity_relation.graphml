    <node id="Ugab">
      <data key="d0">Ugab</data>
      <data key="d1">content</data>
      <data key="d2">The _ugab_ is a probable representation of a Hebrew organ or pipe, found on ancient terra-cottas, dated around 2000 years ago.</data>
      <data key="d3">chunk-18c204bf67b073ba131e7e3917e9d273</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613932</data>
