    <node id="Afghanistan">
      <data key="d0">Afghanistan</data>
      <data key="d1">location</data>
      <data key="d2">Afghanistan is a country where Maya tribes are said to inhabit, sharing cultural and linguistic similarities with American-Maya names.&lt;SEP&gt;Afghanistan is mentioned as a region where some Maya tribes emigrated after leaving Hindostan.</data>
      <data key="d3">chunk-23ba6980ac19f47019ce87374bfbf5be&lt;SEP&gt;chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606669</data>
      <data key="d6" />
    </node>
    <node id="Kabul">
      <data key="d0">Kabul</data>
      <data key="d1">location</data>
      <data key="d2">Kabul is the capital city of Afghanistan, also the name of an ancient shrine and a river, connected to cultural and religious symbolism involving hand marks and Maya influence.&lt;SEP&gt;Kabul is the city on the north bank of the river where descendants of Maya tribes are said to live.</data>
      <data key="d3">chunk-23ba6980ac19f47019ce87374bfbf5be&lt;SEP&gt;chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606670</data>
      <data key="d6" />
    </node>
    <node id="Ethiopia">
      <data key="d0">Ethiopia</data>
      <data key="d1">location</data>
      <data key="d2">Ethiopia is referenced as a destination reached by some Maya tribes traveling west and northwest.</data>
      <data key="d3">chunk-23ba6980ac19f47019ce87374bfbf5be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606670</data>
      <data key="d6" />
    </node>
    <node id="Persian Gulf">
      <data key="d0">Persian Gulf</data>
      <data key="d1">location</data>
      <data key="d2">The Persian Gulf is indicated as a region where Maya tribes landed and established settlements.</data>
      <data key="d3">chunk-23ba6980ac19f47019ce87374bfbf5be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606670</data>
