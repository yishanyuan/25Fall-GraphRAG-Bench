    </node>
    <node id="Creator">
      <data key="d0">Creator</data>
      <data key="d1">concept</data>
      <data key="d2">The Creator is depicted as the divine being responsible for the vast and ordered universe that astronomy reveals.</data>
      <data key="d3">chunk-fe2e999d42ae24fd88802c534f3fd8d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607643</data>
      <data key="d6" />
    </node>
    <node id="Angel Choir">
      <data key="d0">Angel Choir</data>
      <data key="d1">content</data>
      <data key="d2">Angel choir is a group of angels performing hymns in heaven, symbolizing divine praise.</data>
      <data key="d3">chunk-fe2e999d42ae24fd88802c534f3fd8d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607643</data>
