    <node id="Musk-Rat">
      <data key="d0">Musk-Rat</data>
      <data key="d1">creature</data>
      <data key="d2">The Musk-rat is an animal alleged by the Owl to produce honey, revealing a secret of nature.</data>
      <data key="d3">chunk-ab5a2da379766b69f7bf3153cb0f2c47</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608171</data>
