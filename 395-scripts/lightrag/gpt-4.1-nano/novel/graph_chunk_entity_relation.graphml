    </node>
    <node id="Assyria">
      <data key="d0">Assyria</data>
      <data key="d1">location</data>
      <data key="d2">Assyria was an ancient civilization, whose name and origins are linked to the Maya etymology of its name.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606704</data>
