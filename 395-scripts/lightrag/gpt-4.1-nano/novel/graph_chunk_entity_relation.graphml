    </node>
    <node id="St. Leger's Indians">
      <data key="d0">St. Leger's Indians</data>
      <data key="d1">creature</data>
      <data key="d2">St. Leger's Indians are Native American warriors who participated in the conflict at Fort Stanwix, making warwhoops during the scene.</data>
      <data key="d3">chunk-63ada5b526daab8bb42bced4bd5ee488</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607663</data>
