      <data key="d0">Chaldees</data>
      <data key="d1">people</data>
      <data key="d2">The Chaldees are an ancient people known for their use of specific characters in inscriptions and their polytheistic religion.</data>
      <data key="d3">chunk-1d7d407dd88d4f39cbd7f09e60b40325</data>
