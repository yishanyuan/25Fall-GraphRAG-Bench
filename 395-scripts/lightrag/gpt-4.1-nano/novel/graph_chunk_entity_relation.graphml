    <node id="Sir Gavial">
      <data key="d0">Sir Gavial</data>
      <data key="d1">person</data>
      <data key="d2">Sir Gavial is described as a moral, charitable, and blameless family man who made good use of his money.</data>
      <data key="d3">chunk-d98dca421f9ad7bdbf89c28e679535b6</data>
