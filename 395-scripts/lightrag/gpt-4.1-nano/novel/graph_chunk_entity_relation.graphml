    <node id="Egyptian Harps">
      <data key="d0">Egyptian Harps</data>
      <data key="d1">artifact</data>
      <data key="d2">Egyptian harps were musical instruments depicted in sculptures and paintings, some up to six and a half feet high, with elegant shapes and elaborate decoration, often without a front pillar.</data>
      <data key="d3">chunk-409162d6c592b356035008418a8c62af</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613904</data>
