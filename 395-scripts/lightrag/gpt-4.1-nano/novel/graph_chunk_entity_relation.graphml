    <node id="Heating Furnace">
      <data key="d0">Heating Furnace</data>
      <data key="d1">artifact</data>
      <data key="d2">A heating furnace is a traditional device used in steelworks to heat ingots prior to rolling, typically requiring fuel.</data>
