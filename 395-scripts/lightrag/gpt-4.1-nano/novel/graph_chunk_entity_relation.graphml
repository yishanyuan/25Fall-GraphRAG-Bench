      <data key="d0">Four Races</data>
      <data key="d1">concept</data>
      <data key="d2">The Four Races refer to the divisions of humanity under a great king in ancient tradition, symbolizing diversity and unity.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
