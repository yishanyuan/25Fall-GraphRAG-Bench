    </node>
    <node id="Steamer Favorite">
      <data key="d0">Steamer Favorite</data>
      <data key="d1">artifact</data>
      <data key="d2">The steamer Favorite was used to transport condemned Indians, and its passage was secretly arranged to evade public reception.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610016</data>
