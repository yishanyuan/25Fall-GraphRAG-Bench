    <node id="Peal-ringing">
      <data key="d0">Peal-ringing</data>
      <data key="d1">method</data>
      <data key="d2">A traditional English method of ringing multiple bells in sequence, often with rings of eight, ten, or twelve bells.</data>
      <data key="d3">chunk-4839098cd46c452a68e1941bee57dab0</data>
