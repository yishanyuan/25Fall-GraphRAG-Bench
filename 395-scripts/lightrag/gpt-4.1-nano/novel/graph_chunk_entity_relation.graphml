      <data key="d5">1764609484</data>
      <data key="d6" />
    </node>
    <node id="Robert Bouchette">
      <data key="d0">Robert Bouchette</data>
      <data key="d1">person</data>
      <data key="d2">Robert Bouchette was associated with the rebellion, likely one of its leaders or supporters.&lt;SEP&gt;Robert Bouchette was a supporter of Durham who believed his policy was humane.&lt;SEP&gt;Robert Bouchette was a rebel leader who expressed loyalty and fought for the rights of the people during the rebellion.&lt;SEP&gt;Robert Bouchette was a Patriote leader who recovered from a wound and became a customs commissioner at Ottawa.&lt;SEP&gt;Robert Bouchette is a person who recovered from a serious wound sustained at Moore's Corners and later became Her Majesty's commissioner of customs at Ottawa.</data>
      <data key="d3">chunk-3e6059f7b6685e9fbba6db55d93c65ee&lt;SEP&gt;chunk-1d3c806038738c5cf824708ed3cfff5e&lt;SEP&gt;chunk-5baf8115ec01000bf9bea26709c3f099&lt;SEP&gt;chunk-58ea9058e9ed8c78aad18db9d953d662</data>
