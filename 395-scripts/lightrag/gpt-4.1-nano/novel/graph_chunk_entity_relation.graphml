    <node id="Coal Dust">
      <data key="d0">Coal Dust</data>
      <data key="d1">content</data>
      <data key="d2">Coal dust is mixed with grains and broken coal pitch to form a fuel mixture.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
