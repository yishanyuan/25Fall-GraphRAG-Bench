      <data key="d0">Mr Barabbas</data>
      <data key="d1">person</data>
      <data key="d2">Mr Barabbas is depicted as a man with a questionable lifestyle, associated with actresses and morally objectionable conduct.</data>
      <data key="d3">chunk-d98dca421f9ad7bdbf89c28e679535b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608136</data>
