    <node id="Nashville">
      <data key="d0">Nashville</data>
      <data key="d1">location</data>
      <data key="d2">Nashville was a city where young Bailie Peyton was insulted and hissed at for showing loyalty to the Union.&lt;SEP&gt;A city in Tennessee where Gen. Zollicoffer was a citizen and active before secession.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88&lt;SEP&gt;chunk-074a1e4bc4fa465f80f20624b8ddeb17</data>
