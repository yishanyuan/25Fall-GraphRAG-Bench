    <node id="Cosmopolitan Hotel">
      <data key="d0">Cosmopolitan Hotel</data>
      <data key="d1">organization</data>
      <data key="d2">The Cosmopolitan Hotel was a hotel built from the remodeled building at a cost of about $20,000 and was well patronized.</data>
      <data key="d3">chunk-a3b2fb8cc8d028b5cd15ca31eb42884f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609993</data>
      <data key="d6" />
    </node>
