    <node id="Devouring hearts">
      <data key="d0">Devouring hearts</data>
      <data key="d1">content</data>
      <data key="d2">The Maya are documented as practicing the devouring of enemies' hearts as part of their rituals.</data>
      <data key="d3">chunk-0986a653a68c393fd5247a90b35adc69</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606717</data>
