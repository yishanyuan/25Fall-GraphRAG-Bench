    </node>
    <node id="Tityus">
      <data key="d0">Tityus</data>
      <data key="d1">other</data>
      <data key="d2">Tityus is a mythological figure extended over space, associated with Tityus's myth of eternal punishment.&lt;SEP&gt;Tityus is a giant mythologically known for being punished in the Underworld with his liver fed to a vulture.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-442f3a60382a33a67c2d1a47639643cf</data>
