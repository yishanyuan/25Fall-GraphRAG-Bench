    <node id="Sanitary Fair">
      <data key="d0">Sanitary Fair</data>
      <data key="d1">event</data>
      <data key="d2">A large-scale entertainment held during winter of 1864 to benefit the sanitary fund, involving halls erected by Charles N. Mackubin.</data>
      <data key="d3">chunk-f51a7160323c912396ad629e58d01cca</data>
      <data key="d4">unknown_source</data>
