    <node id="Hemo de Graeberg">
      <data key="d0">Hemo de Graeberg</data>
      <data key="d1">person</data>
      <data key="d2">Hemo de Graeberg was a long-time Consul at Tangier who wrote a statistical and geographical account of the empire of Morocco.</data>
      <data key="d3">chunk-6706573dac6e75677a74dc1ef5caf318</data>
