    <node id="Malea">
      <data key="d0">Malea</data>
      <data key="d1">location</data>
      <data key="d2">Malea is a gulf in the sea, associated with maritime danger.&lt;SEP&gt;Malea is a promontory in Laconia, associated with dangerous coastlines.&lt;SEP&gt;Malea is a dangerous promontory located in the south of Laconia, associated with hazardous coastal features.</data>
