    </node>
    <node id="Valmiki">
      <data key="d0">Valmiki</data>
      <data key="d1">person</data>
      <data key="d2">Valmiki was an ancient poet who authored the Ramayana, describing the land inhabited by the Mayas and their territories.&lt;SEP&gt;Valmiki is the poet who authored the Ramayana, describing the land of the Mayas and related legends.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="Hema">
      <data key="d0">Hema</data>
      <data key="d1">person</data>
      <data key="d2">Hema was a nymph married to Maya, according to the Ramayana story, symbolizing a divine or mythological figure.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="Pourandura">
      <data key="d0">Pourandura</data>
      <data key="d1">person</data>
      <data key="d2">Pourandura is a deity who killed Maya with a thunderbolt in the mythological narrative.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="Mines of Silver and Gold">
      <data key="d0">Mines of Silver and Gold</data>
      <data key="d1">content</data>
      <data key="d2">Mines of silver, gold, and precious stones are attributed to the Maya and other ancient regions described in the Ramayana.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="China">
      <data key="d0">China</data>
      <data key="d1">location</data>
      <data key="d2">China is a country where ancient architectural structures, similar to American monuments, can be found, showing cultural links.&lt;SEP&gt;China is the distant and mysterious land Rudolf is destined for, symbolizing a place of mystery and future destiny.&lt;SEP&gt;China is described as a desolate, inhospitable land border, facing the river.&lt;SEP&gt;China is the setting for the narrative, featuring traditional landscapes, architecture, and cultural symbols.&lt;SEP&gt;China is an ancient civilization that possessed long-before-our-Christian-era musical instruments attributed to a high antiquity.</data>
      <data key="d3">chunk-eea61287f7c7aac52c315ee2cca003fc&lt;SEP&gt;chunk-763eb7a8c18113dee91f1409786d898e&lt;SEP&gt;chunk-e3f2c3ab9f6fe4aa540535b1858e6332&lt;SEP&gt;chunk-34306d993bc2674501696f34c01cc91c&lt;SEP&gt;chunk-d034b0ebc70d115fe140d386b94caa9e</data>
