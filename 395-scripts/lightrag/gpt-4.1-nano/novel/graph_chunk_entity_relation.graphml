    <node id="The Hacienda">
      <data key="d0">The Hacienda</data>
      <data key="d1">location</data>
      <data key="d2">The Hacienda is an old Spanish landholding farm located on the outskirts of the town, featuring a patio, stable-yard, and general shop.</data>
      <data key="d3">chunk-39facf182f4a5fa24e4d960518506e65</data>
