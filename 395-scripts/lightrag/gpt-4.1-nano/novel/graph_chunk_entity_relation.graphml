    <node id="Mankind">
      <data key="d0">Mankind</data>
      <data key="d1">concept</data>
      <data key="d2">Mankind refers to humans generally, whose actions are often routine and unreflective, driven by habit rather than conscious objectives.</data>
      <data key="d3">chunk-b32192ddb2993846ee52feb248ad5d6f&lt;SEP&gt;chunk-31da8cb91afdafc694b4c1cdbd4ffa94</data>
