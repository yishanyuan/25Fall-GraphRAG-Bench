      <data key="d6" />
    </node>
    <node id="Warrior">
      <data key="d0">Warrior</data>
      <data key="d1">person</data>
      <data key="d2">The monument and sculptures suggest it was raised in memory of a warrior with a shield covered with round dots, possibly the tomb it contains.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606714</data>
