      <data key="d0">The Planters</data>
      <data key="d1">organization</data>
      <data key="d2">Refers to S. S. Simon and his community of landowners and farmers.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611986</data>
      <data key="d6" />
    </node>
    <node id="The Old Man">
      <data key="d0">The Old Man</data>
      <data key="d1">person</data>
      <data key="d2">A character referenced as having fallen asleep against a fence and died from exposure.&lt;SEP&gt;The Old Man is a figure sitting on a large stone, calmly smoking a pipe, indicating a tranquil observer role.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74&lt;SEP&gt;chunk-cbf86751a46c4cce678f972d8be38307&lt;SEP&gt;chunk-f14dbef413cc17a6b6cd1e7d1b659eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764615498</data>
      <data key="d6" />
    </node>
    <node id="Old Ball">
      <data key="d0">Old Ball</data>
      <data key="d1">creature</data>
      <data key="d2">The frightened dog that caused an old man to be injured and presumably contributed to his death.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74</data>
      <data key="d4">unknown_source</data>
