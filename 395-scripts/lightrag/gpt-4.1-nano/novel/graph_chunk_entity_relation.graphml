    </node>
    <node id="Old Brick">
      <data key="d0">Old Brick</data>
      <data key="d1">artifact</data>
      <data key="d2">The Old Brick is a historic building or structure in Goshen where the writer is situated.</data>
      <data key="d3">chunk-d483764952d7db72ab6b8abd0b9b597f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607641</data>
      <data key="d6" />
    </node>
