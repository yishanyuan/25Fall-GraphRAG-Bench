      <data key="d0">Sir Robert Milnes</data>
      <data key="d1">person</data>
      <data key="d2">Sir Robert Milnes was a British figure who noted the declining number of English-speaking members in the assembly by 1800.</data>
      <data key="d3">chunk-41f4557b5a58dc496c18ce0c8f8f2c88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609516</data>
      <data key="d6" />
    </node>
    <node id="Canadian Revolutionaries">
      <data key="d0">Canadian Revolutionaries</data>
      <data key="d1">people</data>
      <data key="d2">While not explicitly named, Canadians who helped defend the city in 1775, speaking only French, demonstrated their loyalty to their sovereign.</data>
      <data key="d3">chunk-41f4557b5a58dc496c18ce0c8f8f2c88</data>
      <data key="d4">unknown_source</data>
