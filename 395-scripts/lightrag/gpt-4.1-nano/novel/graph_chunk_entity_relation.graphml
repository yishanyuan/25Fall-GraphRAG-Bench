      <data key="d1">artifact</data>
      <data key="d2">Midieval wind instrument, possibly a type of flute or pipe, popular with French musicians in the twelfth and thirteenth centuries.</data>
      <data key="d3">chunk-03c5035205433abd8b211b1d1712aea6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613935</data>
      <data key="d6" />
    </node>
