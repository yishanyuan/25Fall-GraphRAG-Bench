      <data key="d1">content</data>
      <data key="d2">Dictionaries are collections of words and meanings, which currently include the word _morality_ used to denote duties of man to man.</data>
      <data key="d3">chunk-b9481c4e9169907102e1a6a63fadb365</data>
      <data key="d4">unknown_source</data>
