      <data key="d0">Stars of Leda</data>
      <data key="d1">content</data>
      <data key="d2">The stars of Leda are invoked for guidance and good fortune during sea voyages, associated with celestial influence.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610596</data>
