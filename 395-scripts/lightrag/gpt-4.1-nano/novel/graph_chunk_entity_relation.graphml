    <node id="The &quot;Universal&quot; Gas Engine">
      <data key="d0">The "Universal" Gas Engine</data>
      <data key="d1">event</data>
      <data key="d2">A newly invented type of gas engine characterized by a simple rotary ignition valve.</data>
      <data key="d3">chunk-f30cb2bffa149e8d3e9c6f156dd6bbc9</data>
