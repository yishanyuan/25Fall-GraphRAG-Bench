      <data key="d0">Spoon</data>
      <data key="d1">artifact</data>
      <data key="d2">A utensil used by Toto to feed the hermit jelly, representing human aid and kindness.</data>
      <data key="d3">chunk-8c686441b3937cff685f4451d4cd9685</data>
