    </node>
    <node id="Charles H. Williams">
      <data key="d0">Charles H. Williams</data>
      <data key="d1">person</data>
      <data key="d2">Charles H. Williams was the superindendent of the fire department during the event.&lt;SEP&gt;Charles H. Williams served as assistant chief engineer of Pioneer Hook and Ladder Company No. 1.</data>
      <data key="d3">chunk-dd4d3267de3b8b12b0a038535bf2353c&lt;SEP&gt;chunk-d26c30cc3102d9679f3880d6b7c95b61</data>
