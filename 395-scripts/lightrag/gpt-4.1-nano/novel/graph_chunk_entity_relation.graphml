    <node id="Isaiah">
      <data key="d0">Isaiah</data>
      <data key="d1">person</data>
      <data key="d2">Isaiah is an ancient prophet included among the exemplary figures in a hypothetical gathering meant to foster discussion.&lt;SEP&gt;Isaiah is a prophet who experienced a vision in the Temple, illustrating the distinction between external facts and internal, ideal vision.</data>
      <data key="d3">chunk-6a7b8e5007a6fc7408c5fb336be05812&lt;SEP&gt;chunk-f81cfeed72c9cc766e8d6605bb4860f2</data>
