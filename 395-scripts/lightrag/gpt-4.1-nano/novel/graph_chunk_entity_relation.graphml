      <data key="d0">Houses</data>
      <data key="d1">other</data>
      <data key="d2">Houses mentioned in the text include the Emmert house and Mansion House, serving as hotels or boarding places.</data>
      <data key="d3">chunk-a3b2fb8cc8d028b5cd15ca31eb42884f&lt;SEP&gt;chunk-01fb77c42a6cfd618f0d29c057ae2768</data>
