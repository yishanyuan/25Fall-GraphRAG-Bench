      <data key="d0">Proletaries</data>
      <data key="d1">person</data>
      <data key="d2">Proletaries refer to the working class, perceived by Mixtus as obstructive to progress and often viewed with some hostility.</data>
      <data key="d3">chunk-389b8ee79aa909c057f01fc6f9637036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608170</data>
