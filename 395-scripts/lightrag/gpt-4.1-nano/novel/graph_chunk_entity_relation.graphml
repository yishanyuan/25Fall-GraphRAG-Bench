      <data key="d1">location</data>
      <data key="d2">A house built by order of the Bey where the remains of Sidi Amour Abeda are to be deposited for future visitation.</data>
      <data key="d3">chunk-232907dd57f71debadc62dcfe71c8543</data>
      <data key="d4">unknown_source</data>
