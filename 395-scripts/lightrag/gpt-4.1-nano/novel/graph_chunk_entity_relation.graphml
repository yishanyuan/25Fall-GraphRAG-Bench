      <data key="d1">person</data>
      <data key="d2">Carlos Bolelli was a Roman who perished during the sack of Mogador.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Port of Mogador">
      <data key="d0">Port of Mogador</data>
      <data key="d1">location</data>
      <data key="d2">The Port of Mogador exports valuable local products including almonds, gums, wool, and ostrich feathers.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Port of Tangier">
      <data key="d0">Port of Tangier</data>
      <data key="d1">location</data>
      <data key="d2">The Port of Tangier imports a variety of goods such as cotton, silk, dyes, tea, coffee, and others, and exports hides, wax, wool, and fruits.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="British ships">
      <data key="d0">British ships</data>
      <data key="d1">data</data>
      <data key="d2">In 1856, 203 British ships entered and 207 ships cleared Tangier, with specified tonnage.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Foreign ships">
      <data key="d0">Foreign ships</data>
      <data key="d1">data</data>
      <data key="d2">In 1856, 110 foreign ships entered and cleared Tangier, with specified tonnage.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Exotic exports">
      <data key="d0">Exotic exports</data>
      <data key="d1">content</data>
      <data key="d2">Exports from Mogador include almonds, gums, wool, olive-oil, seeds, skins, ostrich feathers, and maize.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Imports into Mogador">
      <data key="d0">Imports into Mogador</data>
      <data key="d1">content</data>
      <data key="d2">Imports include Manchester cotton goods, long cloths, fabrics, sugar, tea, coffee, spices, drugs, nails, beads, woollen cloth, cotton wool, and small mirrors.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="British ports">
      <data key="d0">British ports</data>
      <data key="d1">data</data>
      <data key="d2">In 1855, exports from Mogador to British ports included L228,112 3_s_. 2_d_.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Foreign ports">
      <data key="d0">Foreign ports</data>
      <data key="d1">data</data>
      <data key="d2">In 1855, exports from Mogador to foreign ports included L55,965 13_s_. 1_d_.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Manchester cotton goods">
      <data key="d0">Manchester cotton goods</data>
      <data key="d1">content</data>
      <data key="d2">Manchester cotton goods are among the imported products into Mogador, replacing East India long cloths.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Exports in 1855">
      <data key="d0">Exports in 1855</data>
      <data key="d1">data</data>
      <data key="d2">In 1855, exports from Mogador to British ports amounted to L228,112 3_s_. 2_d_; to foreign ports, L55,965 13_s_. 1_d_.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614633</data>
      <data key="d6" />
    </node>
    <node id="Imports">
      <data key="d0">Imports</data>
      <data key="d1">content</data>
      <data key="d2">Imports into Mogador include Manchester cotton goods, fabrics, sugar, tea, coffee, spices, drugs, nails, beads, wool, cotton wool, and small mirrors.</data>
      <data key="d3">chunk-ea2d548d08b4129bfc47eab34719160b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Mr. Saferty">
      <data key="d0">Mr. Saferty</data>
      <data key="d1">person</data>
      <data key="d2">Mr. Saferty is a Gibraltar merchant who was adjudicated and sentenced in Morocco, later rescued by friends after a dispute with Moorish authorities.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Moorish Authorities">
      <data key="d0">Moorish Authorities</data>
      <data key="d1">organization</data>
      <data key="d2">The Moorish Authorities are the ruling officials in Morocco responsible for judicial decisions and enforcement, often exercising vast power over Europeans and locals.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Court of Morocco">
      <data key="d0">Court of Morocco</data>
      <data key="d1">organization</data>
      <data key="d2">The Court of Morocco is the judicial body to which disputes involving foreign nationals are referred, with the Emperor acting as the final judge.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Mohammedan Law">
      <data key="d0">Mohammedan Law</data>
      <data key="d1">concept</data>
      <data key="d2">Mohammedan Law is the legal system used in Morocco that prescribes harsh punishments for offenses, including punishments such as amputation and death.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Treaty">
      <data key="d0">Treaty</data>
      <data key="d1">content</data>
      <data key="d2">A treaty between England and Morocco grants the Moroccan Emperor the power to act as a final judge over disputes involving British subjects.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Article X">
      <data key="d0">Article X</data>
      <data key="d1">content</data>
      <data key="d2">Article X of the treaty states that renegades from the English nation or subjects who convert to Islam and are of unsound mind shall not be admitted as Moors and may revert to their former religion, but if they choose to remain Moors, they must accept the consequences.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Moroccan Legal System">
      <data key="d0">Moroccan Legal System</data>
      <data key="d1">concept</data>
      <data key="d2">The Moroccan legal system is based on Mohammedan Law, which prescribes harsh punishments such as amputation and death for various offenses.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614634</data>
      <data key="d6" />
    </node>
    <node id="Moroccan Court">
      <data key="d0">Moroccan Court</data>
      <data key="d1">organization</data>
      <data key="d2">The Moroccan Court is a judicial body responsible for resolving disputes, exercising authority delegated by the Emperor and operating under Moroccan law.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="Kaessaria">
      <data key="d0">Kaessaria</data>
      <data key="d1">location</data>
      <data key="d2">Kaessaria is the extensive commercial quarter exhibiting various manufactures and natural products.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="Imperial Palace">
      <data key="d0">Imperial Palace</data>
      <data key="d1">location</data>
      <data key="d2">The Imperial palace is outside the city, fortified with strong walls, and has gardens where the Emperor receives merchants and diplomatic agents.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="River Tensift">
      <data key="d0">River Tensift</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The River Tensift flows from the gorges of the Atlas and supplies water to the city via an aqueduct.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="Sedjelmasa">
      <data key="d0">Sedjelmasa</data>
      <data key="d1">location</data>
      <data key="d2">Sedjelmasa was an ancient region that retained its name until 1530 A.D., serving as a historical precursor to Tafilett.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="Ghourlan">
      <data key="d0">Ghourlan</data>
      <data key="d1">location</data>
      <data key="d2">Ghourlan is one of the towns in Tafilett, known for its magnificent gateway decorated with Dutch tiles.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="L'Eksebi">
      <data key="d0">L'Eksebi</data>
      <data key="d1">location</data>
      <data key="d2">L'Eksebi is a town in Tafilett, with a population of approximately eleven or twelve thousand.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614635</data>
      <data key="d6" />
    </node>
    <node id="Sosso">
      <data key="d0">Sosso</data>
      <data key="d1">location</data>
      <data key="d2">Sosso is a town in Tafilett, with a population similar to Ghourlan.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Boheim">
      <data key="d0">Boheim</data>
      <data key="d1">location</data>
      <data key="d2">Boheim is a town in Tafilett, also with a population estimated around eleven or twelve thousand.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Kesar">
      <data key="d0">Kesar</data>
      <data key="d1">location</data>
      <data key="d2">Kesar is a castle-town on the left side of the river Zig, inhabited entirely by the family of the Prophet and under control of the Shereefs.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Beladesh-Sherfa">
      <data key="d0">Beladesh-Sherfa</data>
      <data key="d1">concept</data>
      <data key="d2">Beladesh-Sherfa is the ancient name meaning "country of the Shereefs," referring to the region around Tafilett and its ruling family.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Filal">
      <data key="d0">Filal</data>
      <data key="d1">person</data>
      <data key="d2">Filal was an Arab immigrant who improved the culture of dates in Tafilett, giving the district its modern name.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Zig">
      <data key="d0">Zig</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Zig is a river that flows through Tafilett, spanned by a bridge built by a Spaniard.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Shereefian Throne">
      <data key="d0">Shereefian Throne</data>
      <data key="d1">concept</data>
      <data key="d2">The Shereefian throne is the royal authority of the family of the Prophet, central to the political hierarchy of Tafilett and Morocco.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Revolt">
      <data key="d0">Revolt</data>
      <data key="d1">event</data>
      <data key="d2">A potential upheaval in Morocco, which exerts influence on the decision to exile royal family members to Tafilett.</data>
      <data key="d3">chunk-203f252ae42306fa9f42171f8e2f0f23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Libyan">
      <data key="d0">Libyan</data>
      <data key="d1">concept</data>
      <data key="d2">Libyan refers to the possible origin of ancient rude statues of women found at Malta, indicating cultural or geographical connection.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Jewess">
      <data key="d0">Jewess</data>
      <data key="d1">person</data>
      <data key="d2">A Jewish woman who is knowledgeable about Jewish and Moorish families in Mogador.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259&lt;SEP&gt;chunk-8a3a39ae3aa8492d1ce85349e33fe6e9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Aged Parents">
      <data key="d0">Aged Parents</data>
      <data key="d1">person</data>
      <data key="d2">Aged parents are maintained by impoverished Moors and Jews in their own homes, often neglected in terms of filial reverence.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614636</data>
      <data key="d6" />
    </node>
    <node id="Marriage Settlements">
      <data key="d0">Marriage Settlements</data>
      <data key="d1">concept</data>
      <data key="d2">Marriage settlements among Jews are based on mercenary arrangements, often fragile and subject to dispute.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="Old Ugly Man">
      <data key="d0">Old Ugly Man</data>
      <data key="d1">person</data>
      <data key="d2">An old, mean, and villainous man preferred over a handsome youth by a Jewish or Moorish girl.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="Handsome Youth">
      <data key="d0">Handsome Youth</data>
      <data key="d1">person</data>
      <data key="d2">A young, virtuous, and pleasant character of a man who is often rejected in favor of an older, uglier man.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="Superstitions">
      <data key="d0">Superstitions</data>
      <data key="d1">concept</data>
      <data key="d2">Salt and other practices such as drinking brandy are linked to superstitions related to protection and morality.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="White Brandy">
      <data key="d0">White Brandy</data>
      <data key="d1">content</data>
      <data key="d2">White brandy is consumed in Moorish society, stimulating immorality and perceived as an incentive to vice.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="_Acqua Ardiente_">
      <data key="d0">_Acqua Ardiente_</data>
      <data key="d1">content</data>
      <data key="d2">_Acqua ardiente_ is Spanish for spirits of strong liquor, produced by Jews in this context, contributing to intoxication and crime.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614637</data>
      <data key="d6" />
    </node>
    <node id="Vizier">
      <data key="d0">Vizier</data>
      <data key="d1">person</data>
      <data key="d2">The Vizier is an official who humorously puts on the Sultan's hat during an event in the royal gardens.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614638</data>
      <data key="d6" />
    </node>
    <node id="Images">
      <data key="d0">Images</data>
      <data key="d3">chunk-73c170ba2d6f65788ae52ee29483e59d</data>
      <data key="d2">The images used in the publication were made available by the Bibliotheque nationale de France.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614638</data>
      <data key="d6" />
    </node>
    <node id="Travel Book">
      <data key="d0">Travel Book</data>
      <data key="d3">chunk-73c170ba2d6f65788ae52ee29483e59d</data>
      <data key="d2">The travel book "Travels in Morocco" was written by James Richardson, describing his experiences in Morocco.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614638</data>
      <data key="d6" />
    </node>
    <node id="European Diplomacy">
      <data key="d0">European Diplomacy</data>
      <data key="d3">chunk-73c170ba2d6f65788ae52ee29483e59d</data>
      <data key="d2">The Moroccan sultans engaged in diplomatic relations with European powers such as France and England.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614638</data>
      <data key="d6" />
    </node>
    <node id="Moroccan Rivers">
      <data key="d0">Moroccan Rivers</data>
      <data key="d3">chunk-73c170ba2d6f65788ae52ee29483e59d</data>
      <data key="d2">The Shebbel is a species of fish native to the rivers of Morocco.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614638</data>
      <data key="d6" />
    </node>
    <node id="Moroccan Monarchs">
      <data key="d0">Moroccan Monarchs</data>
      <data key="d3">chunk-73c170ba2d6f65788ae52ee29483e59d</data>
      <data key="d2">The Moroccan sultans engaged in diplomatic relations with European powers such as France and England.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614639</data>
      <data key="d6" />
    </node>
    <node id="local figure">
      <data key="d0">local figure</data>
      <data key="d3">chunk-f946791371663ec7aa99ab19596abfd1</data>
      <data key="d2">The Boab describes local marriage and divorce laws and customs, including his own multiple wives.</data>
      <data key="d1">UNKNOWN</data>
