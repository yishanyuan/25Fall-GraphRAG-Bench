    <node id="Rinaldo">
      <data key="d0">Rinaldo</data>
      <data key="d1">person</data>
      <data key="d2">Rinaldo is a gallant knight who dissolved the enchantment of the magical wood of Tasso, enabling the Crusaders to use its wood for war machines.</data>
