      <data key="d0">Human Labour</data>
      <data key="d1">concept</data>
      <data key="d2">Refers to the activity of land modification like cutting hills, spanning breaches, and planting, representing the ongoing process of change and development.</data>
      <data key="d3">chunk-e94b824e125ccc07ef22224a84ba470f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608119</data>
