    <node id="Old Ballard">
      <data key="d0">Old Ballard</data>
      <data key="d1">person</data>
      <data key="d2">Old Ballard was the administrator of the Demitt estate, considered cold and business-like, often questioned by Demitt kinfolk about Aunt Katy’s will.</data>
      <data key="d3">chunk-308dc1f4e23e0e8a33feabd4ae43b18c</data>
