    <node id="Valley of Kunar">
      <data key="d0">Valley of Kunar</data>
      <data key="d1">location</data>
      <data key="d2">The Valley of Kunar is another geographical location with a name that potentially means "nest of the ears of corn" in a language shared with Maya and Afghan regions.</data>
