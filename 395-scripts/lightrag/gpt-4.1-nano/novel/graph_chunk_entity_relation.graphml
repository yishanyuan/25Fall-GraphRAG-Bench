    <node id="Thomas Mace">
      <data key="d0">Thomas Mace</data>
      <data key="d1">person</data>
      <data key="d2">Thomas Mace was an authority on musical instruments who described the English lute in the seventeenth century.&lt;SEP&gt;Thomas Mace was a 17th-century musician who provided directions for using viols in music.</data>
