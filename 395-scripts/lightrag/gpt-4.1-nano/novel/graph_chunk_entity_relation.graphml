    <node id="Pelignian">
      <data key="d0">Pelignian</data>
      <data key="d1">location</data>
      <data key="d2">Refers to the region associated with the poet’s origins, connected to Sulmo, and indicates a geographical and cultural background.</data>
      <data key="d3">chunk-8d5602a32bc951267c6f93a5e9e14aab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610606</data>
