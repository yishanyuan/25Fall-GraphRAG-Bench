      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
      <data key="d6" />
    </node>
    <node id="Erech">
      <data key="d0">Erech</data>
      <data key="d1">location</data>
      <data key="d2">Erech is an ancient city associated with the deity Dis, representing the city of the dead.</data>
      <data key="d3">chunk-1d7d407dd88d4f39cbd7f09e60b40325</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606709</data>
