    </node>
    <node id="El-Araish">
      <data key="d0">El-Araish</data>
      <data key="d1">location</data>
      <data key="d2">El-Araish, built around 1200-1300 AD, is a city on the Atlantic coast, inhabited by Moors and Jews, with a garrison, situated on a small promontory and important for its vineyards, cork-forests, and port.</data>
      <data key="d3">chunk-026c31ea51debe67089624a49cd283a6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614628</data>
      <data key="d6" />
    </node>
