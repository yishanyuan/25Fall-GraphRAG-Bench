    </node>
    <node id="Unreflecting Obedience">
      <data key="d0">Unreflecting Obedience</data>
      <data key="d1">concept</data>
      <data key="d2">A type of human behavior characterized by automatic routine actions without deliberate contemplation, driven by custom or immediate impulse.</data>
      <data key="d3">chunk-b32192ddb2993846ee52feb248ad5d6f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608121</data>
