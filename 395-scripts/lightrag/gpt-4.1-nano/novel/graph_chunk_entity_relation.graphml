    <node id="Water Spirits">
      <data key="d0">Water Spirits</data>
      <data key="d1">creature</data>
      <data key="d2">Water spirits are mythological beings originally regarded as rain deities, linked to clouds and water-related music.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
