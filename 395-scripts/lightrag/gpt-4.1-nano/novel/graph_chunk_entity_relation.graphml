    <node id="Fort Stanwix">
      <data key="d0">Fort Stanwix</data>
      <data key="d1">location</data>
      <data key="d2">Fort Stanwix is a historical military fort associated with the American Revolutionary War, known for the warwhoops of St. Leger's Indians during a battle.</data>
      <data key="d3">chunk-63ada5b526daab8bb42bced4bd5ee488</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607663</data>
