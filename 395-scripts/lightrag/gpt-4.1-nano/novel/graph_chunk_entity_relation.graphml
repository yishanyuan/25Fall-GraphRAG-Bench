    </node>
    <node id="Debated Harps">
      <data key="d0">Debated Harps</data>
      <data key="d1">artifact</data>
      <data key="d2">Various Egyptian harps with differing appearances and number of strings, including a triangular harp with twenty-one strings stored in the Louvre, have been discovered and analyzed.</data>
      <data key="d3">chunk-409162d6c592b356035008418a8c62af</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613904</data>
