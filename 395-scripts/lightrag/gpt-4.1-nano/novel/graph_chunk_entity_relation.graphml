    </edge>
    <edge source="Potash Soap" target="Pure Caustic Potash">
      <data key="d7">1.0</data>
      <data key="d8">Pure caustic potash is used to produce high-quality, neutral potash soap suitable for various cleaning purposes.</data>
      <data key="d9">ingredient,manufacturing</data>
