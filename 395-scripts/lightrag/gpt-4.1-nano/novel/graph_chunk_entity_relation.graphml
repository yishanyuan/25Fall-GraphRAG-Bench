    <node id="Greek Merchants">
      <data key="d0">Greek Merchants</data>
      <data key="d1">organization</data>
      <data key="d2">Greek merchants are wealthy individuals whose families associate with Scintilla, representing a style of splendour.</data>
      <data key="d3">chunk-9cbb983a5992ca5627430872d4cdac4b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608134</data>
      <data key="d6" />
    </node>
    <node id="Artists">
      <data key="d0">Artists</data>
      <data key="d1">content</data>
      <data key="d2">Artists patronized by wealthy entertainers associated with Greek merchants, involved in the artistic social circle.</data>
      <data key="d3">chunk-9cbb983a5992ca5627430872d4cdac4b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608134</data>
      <data key="d6" />
