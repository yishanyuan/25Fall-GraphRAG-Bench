    <node id="Abas">
      <data key="d0">Abas</data>
      <data key="d1">person</data>
      <data key="d2">The victorious descendant of Abas is associated with winged steeds and mythological lineage.&lt;SEP&gt;Abas is a mythological descendant referenced in the context of stories involving Perseus.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-442f3a60382a33a67c2d1a47639643cf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610597</data>
      <data key="d6" />
    </node>
    <node id="Perseus">
      <data key="d0">Perseus</data>
      <data key="d1">person</data>
      <data key="d2">Perseus is a mythological hero who slew the sea-monster that threatened Andromeda, as derived from classical stories.&lt;SEP&gt;Perseus is a mythological hero who used Mercury's winged shoes to slay Medusa.&lt;SEP&gt;Perseus is a mythological hero who rescued Andromeda and is implied to have used Pegasus.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-21c9855ea8a01287d6710833c29e4d0c&lt;SEP&gt;chunk-a0dd004d7bb30cbae402f5f620fd614a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610597</data>
      <data key="d6" />
    </node>
    <node id="Bellerophon">
      <data key="d0">Bellerophon</data>
      <data key="d1">person</data>
      <data key="d2">Bellerophon is a hero suggested to be referenced by commentators, though not directly mentioned by Ovid.</data>
