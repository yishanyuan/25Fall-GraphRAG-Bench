    </node>
    <node id="Small Deer">
      <data key="d0">Small Deer</data>
      <data key="d1">creature</data>
      <data key="d2">The small deer called ebba are larger than gazelles and are swift, difficult to pursue.</data>
      <data key="d3">chunk-712990bb2ebe5d62b532d770bfe4b95c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614596</data>
