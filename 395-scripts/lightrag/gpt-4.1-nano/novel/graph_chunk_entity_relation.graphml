    <node id="Question">
      <data key="d0">Question</data>
      <data key="d1">content</data>
      <data key="d2">The text begins with a question related to racial conflict over taxation and the political struggles involved.</data>
      <data key="d3">chunk-2b195a27b43ec85da2d0175fa01cef0d</data>
      <data key="d4">unknown_source</data>
