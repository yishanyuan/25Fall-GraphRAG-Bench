      <data key="d0">Scripture Woman</data>
      <data key="d1">person</data>
      <data key="d2">A biblical woman who broke an ointment jar to anoint the Master’s feet, symbolizing profound devotion and reverence.</data>
      <data key="d3">chunk-c60f4b4b14ecad06c16f793619f89752</data>
      <data key="d4">unknown_source</data>
