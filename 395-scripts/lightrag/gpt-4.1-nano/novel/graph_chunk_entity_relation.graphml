    <node id="Liquor">
      <data key="d0">Liquor</data>
      <data key="d1">content</data>
      <data key="d2">Liquor is an alcoholic beverage that, when consumed, affects the work of the senses and the body's temperature regulation.</data>
      <data key="d3">chunk-c40e9d9d6bed631bcdf0022bea513804</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764612178</data>
      <data key="d6" />
    </node>
    <node id="Cold">
      <data key="d0">Cold</data>
      <data key="d1">concept</data>
      <data key="d2">Cold is the low temperature of surrounding air or environment that can cause the body to lose heat.</data>
      <data key="d3">chunk-c40e9d9d6bed631bcdf0022bea513804</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764612178</data>
