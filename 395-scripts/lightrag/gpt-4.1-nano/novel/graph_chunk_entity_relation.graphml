      <data key="d0">Policemen</data>
      <data key="d1">organization</data>
      <data key="d2">Policemen are law enforcement officers who may be needed more frequently if alcohol consumption leads to social disturbances and crime.</data>
      <data key="d3">chunk-a4ecf42e13f0e671845a3cd5496327f8&lt;SEP&gt;chunk-338c0bd1be2adb8d03c1f197c7477a64</data>
