    </node>
    <node id="Cycad">
      <data key="d0">Cycad</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Cycad is a genus of seed plants with a soft outer coat and woody shell in its fruit, similar to that of the described tree, and exhibits reproductive features like multiple embryos per seed.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611648</data>
