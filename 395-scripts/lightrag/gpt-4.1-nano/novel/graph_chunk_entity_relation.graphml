    <node id="Jewish Female Beauties">
      <data key="d0">Jewish Female Beauties</data>
      <data key="d1">concept</data>
      <data key="d2">Jewish female beauty characterized by charm and delicate features, contrasted with their uncultivated minds and passions.&lt;SEP&gt;Descriptions of the traditional physical appearance and beauty of Jewish women in Tangier and Mogador.</data>
      <data key="d3">chunk-8a3a39ae3aa8492d1ce85349e33fe6e9&lt;SEP&gt;chunk-d4996254e95ccc6b78afba2bb6b96949</data>
