      <data key="d0">Grubbius</data>
      <data key="d1">person</data>
      <data key="d2">Grubbius is a character who authors an essay in Sterne’s narrative, representing lighthearted and whimsical perspectives.</data>
      <data key="d3">chunk-4fbde9bbb344a0f01988992d64609d89</data>
      <data key="d4">unknown_source</data>
