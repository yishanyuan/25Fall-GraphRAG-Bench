    <node id="Dante (author)">
      <data key="d0">Dante (author)</data>
      <data key="d1">person</data>
      <data key="d2">Dante is cited as a seer expressing conditions of ideal and external reality, differentiating between visions of the entranced and external facts.</data>
      <data key="d3">chunk-6a7b8e5007a6fc7408c5fb336be05812</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608173</data>
