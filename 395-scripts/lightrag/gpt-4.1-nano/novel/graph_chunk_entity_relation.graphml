    <node id="The Brain's Work">
      <data key="d0">The Brain's Work</data>
      <data key="d1">concept</data>
      <data key="d2">The brain is responsible for rapid messaging, including reflexes like withdrawal from hot objects, and maintains subconscious processes like breathing.</data>
      <data key="d3">chunk-9a2b65dd2ccf6640dc6d501c52589484</data>
      <data key="d4">unknown_source</data>
