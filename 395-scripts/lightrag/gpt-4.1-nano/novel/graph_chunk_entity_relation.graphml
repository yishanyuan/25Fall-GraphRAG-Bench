    <node id="Harmonium">
      <data key="d0">Harmonium</data>
      <data key="d1">artifact</data>
      <data key="d2">The harmonium is a musical instrument utilizing the _free reed_, imported from China, and has become popular in Western Europe.</data>
      <data key="d3">chunk-95a9160a14d7266e2100e2d55ebcd715</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613917</data>
