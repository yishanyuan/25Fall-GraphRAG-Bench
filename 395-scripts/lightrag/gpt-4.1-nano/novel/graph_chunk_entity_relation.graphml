    <node id="Mr. Schoolcraft">
      <data key="d0">Mr. Schoolcraft</data>
      <data key="d1">person</data>
      <data key="d2">Mr. Schoolcraft is credited with understanding the true meaning of the red hand symbol used by certain American Aborigines.</data>
