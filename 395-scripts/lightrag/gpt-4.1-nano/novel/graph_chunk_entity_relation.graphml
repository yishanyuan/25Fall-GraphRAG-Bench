      <data key="d0">Athenian legislator</data>
      <data key="d1">person</data>
      <data key="d2">The Athenian legislator is mentioned in legends about massive earthquakes and inundations occurring nine thousand years before recorded history.</data>
      <data key="d3">chunk-f83c27282913cff5172f6cf0dfa303eb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606713</data>
