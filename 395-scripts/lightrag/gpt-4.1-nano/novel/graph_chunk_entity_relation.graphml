    <node id="Old Indian Contrivances">
      <data key="d0">Old Indian Contrivances</data>
      <data key="d1">content</data>
      <data key="d2">Old Indian contrivances, such as rattles, drums, flutes, and whistles, are genuine instruments used by American Indians long before European contact.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
      <data key="d6" />
    </node>
    <node id="Early European Instruments">
      <data key="d0">Early European Instruments</data>
      <data key="d1">content</data>
      <data key="d2">The earliest European musical instruments are believed to resemble Asian instruments and show little improvement over centuries.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
      <data key="d6" />
    </node>
    <node id="Gleemen">
      <data key="d0">Gleemen</data>
      <data key="d1">person</data>
      <data key="d2">Gleemen are performers depicted in 9th-century manuscripts playing stringed instruments like the lyre and double-pipe.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
