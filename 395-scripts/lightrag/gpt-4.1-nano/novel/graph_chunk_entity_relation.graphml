    <node id="Little Six">
      <data key="d0">Little Six</data>
      <data key="d1">person</data>
      <data key="d2">Little Six was a band leader whose followers murdered several people at Action before fleeing.&lt;SEP&gt;Little Six was a Sioux chief involved in the uprising, confessed to murdering fifty white men, women, and children, and was executed in 1864.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8&lt;SEP&gt;chunk-c5b84432ad1a7600b31aab3ee4243129</data>
      <data key="d4">unknown_source</data>
