      <data key="d6" />
    </node>
    <node id="Triton">
      <data key="d0">Triton</data>
      <data key="d1">creature</data>
      <data key="d2">Triton is a sea deity who stirs the waves, symbolizing oceanic forces.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610596</data>
