    <node id="Latitude">
      <data key="d0">Latitude</data>
      <data key="d1">concept</data>
      <data key="d2">Latitude is the geographic coordinate that specifies the north-south position of a point on Earth's surface, derivable through astronomical observations and corrections.</data>
