      <data key="d0">Pittsburg</data>
      <data key="d1">location</data>
      <data key="d2">Pittsburg is the town near which the Battle of Pittsburg Landing took place, serving as a geographical reference point.</data>
      <data key="d3">chunk-def2b4a56449fc02586417ac8569c46f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610005</data>
