    <node id="A">
      <data key="d0">A</data>
      <data key="d1">location</data>
      <data key="d2">A is a Maya term meaning "thy" and is used in the etymology of deities.&lt;SEP&gt;The pipe that introduces gas into the vertical conduits in the gas furnace.</data>
      <data key="d3">chunk-1d7d407dd88d4f39cbd7f09e60b40325&lt;SEP&gt;chunk-7b0e534bc4c65f3e841cfc12aa1c3144</data>
