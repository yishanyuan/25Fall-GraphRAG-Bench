      <data key="d0">Amazirghs, Shelouhs, and Arabs</data>
      <data key="d1">person</data>
      <data key="d2">Combined population estimated at 1,450,000.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614547</data>
      <data key="d6" />
    </node>
    <node id="Fullans">
      <data key="d0">Fullans</data>
      <data key="d1">person</data>
      <data key="d2">Fullans are a group within Moroccan demographics, estimated at 120,000.&lt;SEP&gt;The Fullans are a population group totaling 120,000 individuals.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-0fd702921e8d3a990c6c7e84369cba36</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614548</data>
      <data key="d6" />
    </node>
    <node id="Mandingoes">
      <data key="d0">Mandingoes</data>
      <data key="d1">person</data>
      <data key="d2">Mandingoes are also part of the local population, estimated at 120,000.&lt;SEP&gt;The Mandingoes are a West African ethnic group, comprising 120,000 people in the context.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-0fd702921e8d3a990c6c7e84369cba36</data>
