      <data key="d0">Abbe Dufresne</data>
      <data key="d1">person</data>
      <data key="d2">Abbe Dufresne was the superior of the mission house at the Lake of Two Mountains, forcibly displaced by the insurgents.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
