      <data key="d0">Elephant</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The elephant appears as a religious symbol in various cultures, including those with Hindu origins.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
