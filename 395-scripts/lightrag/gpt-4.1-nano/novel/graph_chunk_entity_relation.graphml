      <data key="d1">content</data>
      <data key="d2">Stockings knit by Aunt Katy, sold in dry goods stores in Port William.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74</data>
      <data key="d4">unknown_source</data>
