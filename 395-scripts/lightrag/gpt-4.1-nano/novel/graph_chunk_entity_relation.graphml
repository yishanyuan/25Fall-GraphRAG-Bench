      <data key="d0">Leopard Skin</data>
      <data key="d1">artifact</data>
      <data key="d2">A charmed leopard skin worn by African warriors believed to grant invulnerability, linked to superstitions.</data>
      <data key="d3">chunk-964858730c8a8dc2179e59d3cb07c3cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606698</data>
      <data key="d6" />
    </node>
    <node id="European Soldiers">
      <data key="d0">European Soldiers</data>
      <data key="d1">person</data>
      <data key="d2">European soldiers historically believed in talismans for invulnerability, reflecting superstitions.</data>
      <data key="d3">chunk-964858730c8a8dc2179e59d3cb07c3cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606698</data>
      <data key="d6" />
