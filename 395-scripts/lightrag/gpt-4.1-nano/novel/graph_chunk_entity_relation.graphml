    <node id="Carillon">
      <data key="d0">Carillon</data>
      <data key="d1">artifact</data>
      <data key="d2">A musical instrument with large keys, comparable to early organ keys, still in use in continental Europe.&lt;SEP&gt;A musical instrument consisting of multiple bells, played by a musician using keys and pedals, with specific acoustic characteristics.&lt;SEP&gt;A musical instrument composed of a set of bells, placed in church towers or public edifices, played by mechanical or manual means.</data>
      <data key="d3">chunk-4839098cd46c452a68e1941bee57dab0&lt;SEP&gt;chunk-30e65976acac895df3c3a0c077667c8b&lt;SEP&gt;chunk-242f71a68c104bb1e671b3e7c72468fa</data>
      <data key="d4">unknown_source</data>
