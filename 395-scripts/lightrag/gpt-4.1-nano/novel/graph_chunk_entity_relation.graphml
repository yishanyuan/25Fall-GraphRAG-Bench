    <node id="Horus">
      <data key="d0">Horus</data>
      <data key="d1">person</data>
      <data key="d2">Horus is the elder brother of Osiris in Egyptian mythology.&lt;SEP&gt;Horus is one of the children of Isis and Osiris, associated with kingship and mythology.</data>
      <data key="d3">chunk-06e492003a084ec018b849a310a4e995&lt;SEP&gt;chunk-a7dc5cd694c8e04568651d4ad21b8623</data>
