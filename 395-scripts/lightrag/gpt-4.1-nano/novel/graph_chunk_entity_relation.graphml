    <node id="Canadian refugees">
      <data key="d0">Canadian refugees</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Canadian refugees are individuals who gathered along the American border, showing support for rebellion against British authority.&lt;SEP&gt;Canadian refugees were French-Canadian individuals fleeing to the United States to join plans for insurrection in Lower Canada.</data>
      <data key="d3">chunk-45d67b8f87397b56d105fc32a0b1f677&lt;SEP&gt;chunk-26bd7dcdcc38c1ce5338b530f0ab8694</data>
