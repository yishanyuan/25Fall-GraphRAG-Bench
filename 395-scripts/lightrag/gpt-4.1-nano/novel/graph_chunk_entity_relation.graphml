    <node id="C. A. S. HALL">
      <data key="d0">C. A. S. HALL</data>
      <data key="d1">person</data>
      <data key="d2">C. A. S. Hall is the writer of the letter, describing family events.&lt;SEP&gt;Author of personal correspondence, expressing concern about health and providing updates to family members and friends in letters dated 1884 and 1887.&lt;SEP&gt;C. A. S. Hall is the author of the diary, writing from Washington D.C.</data>
      <data key="d3">chunk-d483764952d7db72ab6b8abd0b9b597f&lt;SEP&gt;chunk-9eb39f6855ba70b44490f834cf645715&lt;SEP&gt;chunk-0385599a16e6adec90c4a4bae922a43d</data>
