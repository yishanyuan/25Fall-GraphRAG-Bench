      <data key="d0">W. H. Scott</data>
      <data key="d1">person</data>
      <data key="d2">W. H. Scott was a supporter of Papineau and a leader in the Two Mountains region, actively involved in revolutionary activities.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
