      <data key="d0">Muley Ishmael</data>
      <data key="d1">person</data>
      <data key="d2">Muley Ishmael re-captured El-Araish from Spanish control in 1689, indicating his role in the region's history.</data>
      <data key="d3">chunk-026c31ea51debe67089624a49cd283a6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614628</data>
      <data key="d6" />
