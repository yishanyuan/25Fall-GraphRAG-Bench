    <node id="Moulding Wheels">
      <data key="d0">Moulding Wheels</data>
      <data key="d1">device</data>
      <data key="d2">Four vertical moulding wheels support cavities that form hemispheres which combine to make spheres.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611672</data>
