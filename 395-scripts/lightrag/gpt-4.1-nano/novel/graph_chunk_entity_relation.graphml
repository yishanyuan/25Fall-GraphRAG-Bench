      <data key="d0">Delphic Oracle</data>
      <data key="d1">organization</data>
      <data key="d2">The Delphic Oracle was an ancient Greek priestess recognized for issuing divine prescriptions and prophecies.</data>
      <data key="d3">chunk-66a11e3fdc0678e4dcf84b4d05935cdf</data>
