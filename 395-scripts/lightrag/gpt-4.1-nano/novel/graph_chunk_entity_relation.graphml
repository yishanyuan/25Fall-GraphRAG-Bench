    </node>
    <node id="The Angel of Peace">
      <data key="d0">The Angel of Peace</data>
      <data key="d1">concept</data>
      <data key="d2">The Angel of Peace symbolizes the spread of peace following the war, from Maine to California.</data>
      <data key="d3">chunk-0b703ad46fc561ded805fade2af40be0</data>
