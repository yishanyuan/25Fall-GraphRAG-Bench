      <data key="d0">Gibbon</data>
      <data key="d1">creature</data>
      <data key="d2">The Gibbon is an animal that reacts with hysterical laughter to the honeycomb revelation.</data>
      <data key="d3">chunk-ab5a2da379766b69f7bf3153cb0f2c47</data>
