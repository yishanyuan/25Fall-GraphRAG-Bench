    <node id="Hindus">
      <data key="d0">Hindus</data>
      <data key="d1">organization</data>
      <data key="d2">The Hindus are an ancient cultural group with traditions involving water and music, possessing ancient musical instruments and a treatise on music.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
