    <node id="Enceladus">
      <data key="d0">Enceladus</data>
      <data key="d1">other</data>
      <data key="d2">Enceladus is a giant mythological figure hurling with his thousand arms.&lt;SEP&gt;Enceladus is a mythological giant struck by lightning and buried beneath Mount Etna.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-442f3a60382a33a67c2d1a47639643cf</data>
