    <node id="Mythical England">
      <data key="d0">Mythical England</data>
      <data key="d1">concept</data>
      <data key="d2">Describes an idealized, possibly romanticized vision of England rooted in tradition, landscape, and cultural memory.</data>
      <data key="d3">chunk-e94b824e125ccc07ef22224a84ba470f</data>
