    <node id="Monument">
      <data key="d0">Monument</data>
      <data key="d1">artifact</data>
      <data key="d2">The monument at Chichen-Itza features engravings, bas-reliefs, and traces of former paint, commemorating a warrior with the shield.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606713</data>
