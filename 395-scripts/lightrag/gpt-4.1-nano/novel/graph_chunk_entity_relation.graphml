    </node>
    <node id="Sternes Posthumous Works of a late celebrated Genius deceased">
      <data key="d0">Sternes Posthumous Works of a late celebrated Genius deceased</data>
      <data key="d1">content</data>
      <data key="d2">A work attributed to Sterne, possibly authored by Richard Griffith, presented as Sterne’s autobiography with dubious authenticity.</data>
      <data key="d3">chunk-458f12b07f966802c9353e65d5abc548</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608996</data>
