    <node id="Goshen">
      <data key="d0">Goshen</data>
      <data key="d1">location</data>
      <data key="d2">Goshen is a town in Connecticut associated with the Hall family’s residence and historical significance.&lt;SEP&gt;Goshen is a town in Connecticut where Asaph Hall lived and where Angeline received a letter from him.&lt;SEP&gt;Goshen is the place in Connecticut where Angeline stayed with her husband's mother during his early work period in Cambridge.&lt;SEP&gt;Goshen is a place where the old brick and cemetery are located, associated with family history and burial.</data>
      <data key="d3">chunk-d483764952d7db72ab6b8abd0b9b597f&lt;SEP&gt;chunk-c23711e6a6e44b422911f2bdf57475a0&lt;SEP&gt;chunk-9edfe0fb8fa0058acfbbae0026363f1c&lt;SEP&gt;chunk-4216b02c90231e98e23a232e47e699b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607641</data>
