    <node id="Eloi">
      <data key="d0">Eloi</data>
      <data key="d1">content</data>
      <data key="d2">Eloi is another Hebrew word spoken by Jesus, potentially of Maya origin, meaning "Now, now I am sinking."</data>
      <data key="d3">chunk-37549c49b71d3d70c292402a64c108aa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606692</data>
