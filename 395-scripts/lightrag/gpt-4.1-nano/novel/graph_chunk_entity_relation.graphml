    </node>
    <node id="South Wind">
      <data key="d0">South Wind</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The warm south wind affects sea travel and is mentioned as part of the hazardous maritime environment.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d&lt;SEP&gt;chunk-ba43616fff0b8112616e172e23cfa8d7</data>
