    <node id="Gases">
      <data key="d0">Gases</data>
      <data key="d1">content</data>
      <data key="d2">Gases generated in the superficial strata of the earth escape through caves and senotes, following vents without causing surface disturbances.</data>
      <data key="d3">chunk-8a980d05b1d871a902a88d111d028517</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606705</data>
