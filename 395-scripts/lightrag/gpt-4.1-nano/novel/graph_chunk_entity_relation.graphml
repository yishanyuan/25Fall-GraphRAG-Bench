    <node id="Snowy Regions">
      <data key="d0">Snowy Regions</data>
      <data key="d1">location</data>
      <data key="d2">Snowy regions refer to cold, snow-covered areas like the Rocky Mountains and Arctic, where cold resistance and clothing are important.</data>
