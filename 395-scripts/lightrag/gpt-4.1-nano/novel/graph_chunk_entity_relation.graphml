    <node id="Col. E.C. Belote">
      <data key="d0">Col. E.C. Belote</data>
      <data key="d1">person</data>
      <data key="d2">Col. E.C. Belote was the manager of the hotel, previously a landlord of the Merchants.</data>
      <data key="d3">chunk-a3b2fb8cc8d028b5cd15ca31eb42884f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609996</data>
