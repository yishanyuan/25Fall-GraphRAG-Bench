    <node id="Ali-Ben-Abou-Thaleb">
      <data key="d0">Ali-Ben-Abou-Thaleb</data>
      <data key="d1">person</data>
      <data key="d2">Ali-Ben-Abou-Thaleb is an ancestral figure, surnamed "The accepted of God," associated with the tribe of Hashem and husband of Fatima.</data>
