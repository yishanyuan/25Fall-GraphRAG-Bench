    </node>
    <node id="Gauls">
      <data key="d0">Gauls</data>
      <data key="d1">other</data>
      <data key="d2">The Gauls are ancient peoples known for using caustic soap ('spuma caustica') to dye hair black or blonde.</data>
      <data key="d3">chunk-b6cab761408cb58a952d84a4e27dce81</data>
