    <node id="Masons">
      <data key="d0">Masons</data>
      <data key="d1">organization</data>
      <data key="d2">Masons are members of secret societies that use symbolic signs and participate in rites, similar to other secret civilizations.</data>
      <data key="d3">chunk-a7dc5cd694c8e04568651d4ad21b8623</data>
