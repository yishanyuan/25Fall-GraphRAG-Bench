    <node id="Johnny Martin">
      <data key="d0">Johnny Martin</data>
      <data key="d1">person</data>
      <data key="d2">A member of Pioneer Hook and Ladder company, foreman of the Daily Minnesotian office, known for his readiness in fire emergencies and humorous declaration about killing an Irishman.&lt;SEP&gt;Johnny Martin was a nickname for A.D. Martin, a prominent firefighter and foreman in the early days of the St. Paul fire department.</data>
      <data key="d3">chunk-dd4d3267de3b8b12b0a038535bf2353c&lt;SEP&gt;chunk-dd305fbce6d35b0ef2d81f49f11311ba</data>
