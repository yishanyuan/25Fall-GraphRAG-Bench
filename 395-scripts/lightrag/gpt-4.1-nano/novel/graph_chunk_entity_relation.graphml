    <node id="Jesus of Nazareth">
      <data key="d0">Jesus of Nazareth</data>
      <data key="d1">person</data>
      <data key="d2">Jesus of Nazareth's last words were reportedly uttered in the Maya language, according to biblical accounts.&lt;SEP&gt;Jesus of Nazareth is a biblical figure whose last words on the cross are discussed, with some suggesting they have Maya origins.</data>
      <data key="d3">chunk-37549c49b71d3d70c292402a64c108aa&lt;SEP&gt;chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606692</data>
      <data key="d6" />
    </node>
    <node id="Eli">
      <data key="d0">Eli</data>
      <data key="d1">content</data>
      <data key="d2">Eli is a Hebrew word reportedly spoken by Jesus on the cross, which the text suggests may have Maya origins with a different meaning.</data>
      <data key="d3">chunk-37549c49b71d3d70c292402a64c108aa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606692</data>
