    <node id="Arctic explorers">
      <data key="d0">Arctic explorers</data>
      <data key="d1">person</data>
      <data key="d2">Arctic explorers are individuals who travel in icy regions, often using sledges and living in huts, and have knowledge about temperature and cold weather resistance.</data>
      <data key="d3">chunk-c40e9d9d6bed631bcdf0022bea513804</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764612178</data>
      <data key="d6" />
    </node>
    <node id="Oil">
      <data key="d0">Oil</data>
      <data key="d1">content</data>
      <data key="d2">Oil is a substance consumed by Arctic explorers and hunters, often used for heating or as food in cold regions.</data>
      <data key="d3">chunk-c40e9d9d6bed631bcdf0022bea513804&lt;SEP&gt;chunk-8afc94ee00703bc5476d62e021e1994c&lt;SEP&gt;chunk-39746a374c565c0e58462818e02e77f9</data>
