      <data key="d0">The Simon Family</data>
      <data key="d1">organization</data>
      <data key="d2">The Simon Family is a family that owned plantations, which were sold off at sheriff's sale after the war.</data>
      <data key="d3">chunk-0b703ad46fc561ded805fade2af40be0</data>
