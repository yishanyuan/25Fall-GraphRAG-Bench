      <data key="d0">Four Provinces</data>
      <data key="d1">concept</data>
      <data key="d2">The Four Provinces are the regions governed by a great king in antiquity, representing organizational divisions in ancient civilizations.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
