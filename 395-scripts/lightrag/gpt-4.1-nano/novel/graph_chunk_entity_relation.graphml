      <data key="d2">Jonas is a prophet honored by the temple in the province of Sous.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614546</data>
      <data key="d6" />
    </node>
    <node id="Numidians">
      <data key="d0">Numidians</data>
      <data key="d1">person</data>
      <data key="d2">Numidians are noted for bodily exercises and skill in horse-breaking, historically present in the region.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
