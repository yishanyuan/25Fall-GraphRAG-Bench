      <data key="d0">Copan</data>
      <data key="d1">location</data>
      <data key="d2">Copan is an archaeological site where sculptured obelisks with figures of Asiatic type are found, indicating cultural contacts.</data>
      <data key="d3">chunk-f83c27282913cff5172f6cf0dfa303eb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606712</data>
