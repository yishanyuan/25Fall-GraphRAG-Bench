    <node id="Cynocephalus">
      <data key="d0">Cynocephalus</data>
      <data key="d1">creature</data>
      <data key="d2">Cynocephalus, or baboons, are Egyptian divine symbols representing Thoth; placed in temples and associated with wisdom.&lt;SEP&gt;Cynocephalus, commonly known as baboons, are depicted as warning Moo of impending danger in the scene.</data>
      <data key="d3">chunk-06e492003a084ec018b849a310a4e995&lt;SEP&gt;chunk-964858730c8a8dc2179e59d3cb07c3cc</data>
      <data key="d4">unknown_source</data>
