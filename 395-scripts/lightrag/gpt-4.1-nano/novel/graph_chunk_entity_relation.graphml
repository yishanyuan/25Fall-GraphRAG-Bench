    <node id="Gigantic Chieftain">
      <data key="d0">Gigantic Chieftain</data>
      <data key="d1">person</data>
      <data key="d2">The gigantic chieftain is a leader character who shows respect to the princess and reacts strongly upon hearing a remark related to his men and the enemy's proximity.</data>
