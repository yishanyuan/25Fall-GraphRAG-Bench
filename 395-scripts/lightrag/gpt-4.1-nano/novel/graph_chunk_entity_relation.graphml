    <node id="Leather Strap">
      <data key="d0">Leather Strap</data>
      <data key="d1">artifact</data>
      <data key="d2">A strong leather strap is used to prevent the hawk's claws from pulling apart or straining.</data>
      <data key="d3">chunk-712990bb2ebe5d62b532d770bfe4b95c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614596</data>
