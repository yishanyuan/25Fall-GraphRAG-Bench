    <node id="Clarion">
      <data key="d0">Clarion</data>
      <data key="d1">content</data>
      <data key="d2">The Clarion is a publication that contains exchanges read by Mr. Grey and Saltillo.&lt;SEP&gt;The clarion is a small trumpet with a shrill sound, represented among medieval musical instruments.</data>
