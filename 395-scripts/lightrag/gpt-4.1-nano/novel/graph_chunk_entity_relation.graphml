      <data key="d1">location</data>
      <data key="d2">St Johns is a nearby area where rebel forces might have reached and joined other Patriote supporters.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
