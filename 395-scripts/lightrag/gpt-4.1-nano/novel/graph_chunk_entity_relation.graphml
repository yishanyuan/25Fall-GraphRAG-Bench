    <node id="Hippodamia">
      <data key="d0">Hippodamia</data>
      <data key="d1">person</data>
      <data key="d2">Hippodamia was a bride in Greek myth, associated with the marriage of Pirithous, mentioned in Roman mythological references.&lt;SEP&gt;Hippodamia was the daughter of Onomaüs, involved in the mythological context of Pelops' race.</data>
      <data key="d3">chunk-eb4eb8f1e4cf05e01dcfb95969a6bb79&lt;SEP&gt;chunk-52ca25c65db54cb74a2c1bd788c198c8</data>
