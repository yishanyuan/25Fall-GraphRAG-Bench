      <data key="d0">Ram Singh</data>
      <data key="d1">person</data>
      <data key="d2">Ram Singh was Maharajah of Jeypoor, visited by Gen. Grant, and associated with Indian temple customs.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606695</data>
