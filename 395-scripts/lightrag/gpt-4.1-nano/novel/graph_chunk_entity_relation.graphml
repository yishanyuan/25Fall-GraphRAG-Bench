      <data key="d0">Capt. Jo Anderson</data>
      <data key="d1">person</data>
      <data key="d2">Capt. Jo Anderson commanded the Cullen Guards during the Indian outbreak.&lt;SEP&gt;Capt. Jo Anderson commanded the Cullen Guards engaged in the Sioux conflict.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-54b8fd90d2cdfb38f2203aba48e470d7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610020</data>
      <data key="d6" />
    </node>
    <node id="Maj. Joseph R. Brown">
      <data key="d0">Maj. Joseph R. Brown</data>
      <data key="d1">person</data>
      <data key="d2">Maj. Joseph R. Brown commanded all the units involved in the burial and rescue operations during the Sioux outbreak.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610020</data>
      <data key="d6" />
    </node>
    <node id="Birch Coulie">
      <data key="d0">Birch Coulie</data>
      <data key="d1">location</data>
      <data key="d2">Birch Coulie was a site involved in the conflicts during the Sioux outbreak of 1862.&lt;SEP&gt;Birch Coulie is the site where the military encampment was established, near a prairie and timber, during the Sioux conflict.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-2a3ab772f4c7d1211b5007a6c92e23da</data>
