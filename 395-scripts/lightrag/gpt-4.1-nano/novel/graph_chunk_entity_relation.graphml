    <node id="Argo">
      <data key="d0">Argo</data>
      <data key="d1">artifact</data>
      <data key="d2">The Argo is a legendary ship that is mentioned as overwhelmed by fatal waves, symbolizing perilous voyages.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610595</data>
