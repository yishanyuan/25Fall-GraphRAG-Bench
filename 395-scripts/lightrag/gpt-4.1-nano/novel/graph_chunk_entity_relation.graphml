    </node>
    <node id="Boreas">
      <data key="d0">Boreas</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Boreas is the mythological north wind associated with the story of Orithyia, capable of causing the door to shake.&lt;SEP&gt;Boreas is the cold north wind, associated with perilous weather conditions at sea.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d&lt;SEP&gt;chunk-6bd2afa94631d5184fe4ed1acaebe619</data>
