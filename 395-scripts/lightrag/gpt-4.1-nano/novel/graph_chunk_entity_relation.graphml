    <node id="Old Opera House">
      <data key="d0">Old Opera House</data>
      <data key="d1">artifact</data>
      <data key="d2">The Old Opera House was a cultural venue in St. Paul that operated until the winter of 1866-67.&lt;SEP&gt;The old opera house was a historic theater in St. Paul, known for hosting notable speakers and performances before the new opera house was built.</data>
      <data key="d3">chunk-184afd23de097cea7ecadc6dfb1a7139&lt;SEP&gt;chunk-9bf8943ee8dd238feb8fd1d1ea67c1d4</data>
      <data key="d4">unknown_source</data>
