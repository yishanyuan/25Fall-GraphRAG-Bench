    <node id="Delabole Quarries">
      <data key="d0">Delabole Quarries</data>
      <data key="d1">location</data>
      <data key="d2">Delabole Quarries is a slate quarry known for its enormous masses of slate, worked since the time of Queen Elizabeth, with a distinctive bluish-grey color and surrounded by hills of debris and old mines.</data>
      <data key="d3">chunk-322cff857c0beb5c471bdf49a8426f1d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764615511</data>
