      <data key="d4">unknown_source</data>
      <data key="d5">1764610017</data>
      <data key="d6" />
    </node>
    <node id="Hines">
      <data key="d0">Hines</data>
      <data key="d1">person</data>
      <data key="d2">Hines was a young soldier known for bravery, who participated in guarding supply trains and was involved in a mock Indian attack story.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610017</data>
      <data key="d6" />
    </node>
    <node id="Capitol">
      <data key="d0">Capitol</data>
      <data key="d1">location</data>
      <data key="d2">The Capitol is the building from which ammunition and muskets were sourced, and where military-related activity took place.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="Office">
      <data key="d0">Office</data>
      <data key="d1">other</data>
      <data key="d2">The office was barricaded and equipped with muskets and ammunition, serving as a strategic point during the conflict.&lt;SEP&gt;The office manages various administrative and governmental tasks, experiencing financial difficulties.&lt;SEP&gt;The office refers to Samuel Pepys's workplace where he spends the morning.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e&lt;SEP&gt;chunk-efb4b986690c80d677428e9a12caf306&lt;SEP&gt;chunk-986db80f0b248cae0ba30adbca747f75&lt;SEP&gt;chunk-40dae678ded1ef4fdb119e4518ba93d8</data>
