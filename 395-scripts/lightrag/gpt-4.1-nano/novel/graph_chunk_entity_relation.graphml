    <node id="Alfred Hédouin">
      <data key="d0">Alfred Hédouin</data>
      <data key="d1">person</data>
      <data key="d2">Alfred Hédouin is a translator who, in 1853, translated Sterne’s “Koran” into French, claiming it to be authentic.&lt;SEP&gt;Alfred Hédouin authored an article accusing Goethe of plagiarism of Sterne, published in Le Monde Maçonnique.</data>
      <data key="d3">chunk-458f12b07f966802c9353e65d5abc548&lt;SEP&gt;chunk-d1ebe193334de57430520a945aa53a53</data>
      <data key="d4">unknown_source</data>
