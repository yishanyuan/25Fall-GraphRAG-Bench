    <node id="ASPIRATION">
      <data key="d0">ASPIRATION</data>
      <data key="d1">content</data>
      <data key="d2">ASPIRATION is a poem reflecting Mrs. Hall's inner dreams, wishes for beauty, and spiritual longing.</data>
