    </node>
    <node id="Conifers">
      <data key="d0">Conifers</data>
      <data key="d1">content</data>
      <data key="d2">Conifers are a group of seed-producing trees with relation to the described tree, serving as links between flowering plants and cryptogams.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611648</data>
      <data key="d6" />
    </node>
    <node id="Cryptogams">
      <data key="d0">Cryptogams</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Cryptogams are a group of lower plants, related to conifers through evolutionary links suggested by the affinity indicated by corpuscles and venation.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611648</data>
      <data key="d6" />
    </node>
    <node id="Cycas">
      <data key="d0">Cycas</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Cycas is a genus of plants with a soft outer coat and woody shell in its fruit, similar in appearance to the described tree's fruit.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611648</data>
      <data key="d6" />
    </node>
    <node id="Endlicher">
      <data key="d0">Endlicher</data>
      <data key="d1">person</data>
      <data key="d2">Endlicher was a botanist who noted the presence of 2 to 3 embryos in a seed, related to the described tree's reproductive characteristics.</data>
      <data key="d3">chunk-f9bbc68e971d8dbaaccac8129cd9f19d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611648</data>
