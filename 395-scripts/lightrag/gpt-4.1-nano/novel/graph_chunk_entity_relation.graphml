    <node id="Four Mountains">
      <data key="d0">Four Mountains</data>
      <data key="d1">concept</data>
      <data key="d2">The Four Mountains are a symbolic description in sacred texts, representing the geographical and spiritual divisions of lands like Hindostan.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606705</data>
