      <data key="d0">Unrest</data>
      <data key="d1">content</data>
      <data key="d2">Unrest refers to the political tension, opposition, and potential revolt among the Patriotes and other groups opposing the colonial policies.</data>
      <data key="d3">chunk-f63400d8188502b67eda00c561659eb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609477</data>
