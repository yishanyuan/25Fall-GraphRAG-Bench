    </node>
    <node id="April 17, 1858">
      <data key="d0">April 17, 1858</data>
      <data key="d1">event</data>
      <data key="d2">The narrator arrived in St. Paul on this date and began work on a local newspaper.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="Geo. W. Moore">
      <data key="d0">Geo. W. Moore</data>
      <data key="d1">person</data>
      <data key="d2">Geo. W. Moore is the narrator’s brother, a part owner and manager of the Minnesotian newspaper.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
