    <node id="Polar Distance">
      <data key="d0">Polar Distance</data>
      <data key="d1">data</data>
      <data key="d2">Polar distance is the angular distance of a star from the celestial pole, used in celestial navigation and related calculations.</data>
      <data key="d3">chunk-1573d79bcfed29e4fb110ec5c56a26fb</data>
      <data key="d4">unknown_source</data>
