    <node id="Heritage">
      <data key="d0">Heritage</data>
      <data key="d1">concept</data>
      <data key="d2">The heritage refers to the cultural, religious, and historical inheritance passed down among the Jews and their ancestors.</data>
      <data key="d3">chunk-36f749f37b5c1af95239cafc0a0a74ff&lt;SEP&gt;chunk-2131d24a8dbb5fbb7841a0c8eb97f9f7&lt;SEP&gt;chunk-4d6d693b5da179ac238c1380743ccaf6&lt;SEP&gt;chunk-5c65528b916ab8f0ecae0b5c8df37467&lt;SEP&gt;chunk-be50f96825f2130199a486741f5ef6c4</data>
