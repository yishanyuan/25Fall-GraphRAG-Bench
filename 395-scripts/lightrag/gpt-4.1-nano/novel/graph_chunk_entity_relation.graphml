      <data key="d0">Sidi Reschid</data>
      <data key="d1">person</data>
      <data key="d2">Sidi Reschid is an artillery officer and guide during the repair of a fortress, responsible for leading the visitors.</data>
      <data key="d3">chunk-232907dd57f71debadc62dcfe71c8543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614600</data>
      <data key="d6" />
    </node>
