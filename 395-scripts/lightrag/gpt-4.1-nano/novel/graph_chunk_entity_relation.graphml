    <node id="Hearsay">
      <data key="d0">Hearsay</data>
      <data key="d1">concept</data>
      <data key="d2">Hearsay refers to information received from other people that is not verified or confirmed, often involved in discussions of knowledge and belief.&lt;SEP&gt;Hearsay involves information that is often unverified and can influence judgments about what others "must have known."</data>
      <data key="d3">chunk-b65963d298578e7408d7e8e5ece65af6</data>
