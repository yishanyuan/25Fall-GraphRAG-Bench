    <node id="U.S. Naval Observatory">
      <data key="d0">U.S. Naval Observatory</data>
      <data key="d1">organization</data>
      <data key="d2">The U.S. Naval Observatory is a federal institution where Asaph Hall worked during the Civil War.&lt;SEP&gt;The U.S. Naval Observatory is a scientific institution where Asaph Hall worked, particularly during the Civil War.</data>
      <data key="d3">chunk-00e509d5b8e0fa267a06304105affc4c&lt;SEP&gt;chunk-ccd32b7ed6773eeb16d88857c35f0af9</data>
