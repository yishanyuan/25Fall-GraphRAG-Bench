    <node id="American Sons">
      <data key="d0">American Sons</data>
      <data key="d1">content</data>
      <data key="d2">The American Sons refer to the new generation of Americans depicted in the historic ballads sung by Theophilus Stickney.</data>
      <data key="d3">chunk-ddd5ecb41e87808c4d5b933250c73c2b</data>
