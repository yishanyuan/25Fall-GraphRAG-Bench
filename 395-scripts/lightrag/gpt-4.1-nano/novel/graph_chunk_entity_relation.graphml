    <node id="Congress">
      <data key="d0">Congress</data>
      <data key="d1">organization</data>
      <data key="d2">Congress is the legislative body that passed a bill admitting Minnesota into the Union.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610019</data>
