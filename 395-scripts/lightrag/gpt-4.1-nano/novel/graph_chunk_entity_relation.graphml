    <node id="Baltimore">
      <data key="d0">Baltimore</data>
      <data key="d1">location</data>
      <data key="d2">Baltimore is the city where Francis Scott Key wrote the "Star-Spangled Banner."</data>
      <data key="d3">chunk-63ada5b526daab8bb42bced4bd5ee488</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607664</data>
