      <data key="d6" />
    </node>
    <node id="Touchwood">
      <data key="d0">Touchwood</data>
      <data key="d1">person</data>
      <data key="d2">Touchwood is described as a "good fellow" with a bad temper, exhibiting insolence, quarrelsomeness, haughtiness, neglectfulness, and moodiness, but also possessing virtues like honor and loyalty, despite his irritability.&lt;SEP&gt;Touchwood is portrayed as a temperamental individual who often exhibits bad temper, but shows moments of kindness and penitence after offensive behavior.&lt;SEP&gt;Touchwood is a man of high gifts with a capricious temper, capable of writing a great book and producing superior work, but often inconsistent and prone to bad tempers.</data>
      <data key="d3">chunk-83194c35add0e85f1e77faa43fd6d5a7&lt;SEP&gt;chunk-022b8d49df0a9b3198a3827e7ca1f148&lt;SEP&gt;chunk-5e8555ae56f6e9ad9e155334b3a6e24c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608138</data>
      <data key="d6" />
    </node>
    <node id="Public Conscience">
      <data key="d0">Public Conscience</data>
      <data key="d1">concept</data>
      <data key="d2">The public conscience is a societal moral sense that permits laxity and sanctions unprincipled pursuits in authorship.&lt;SEP&gt;Public conscience is the collective moral sense that influences societal judgment and insistance on the general welfare.</data>
      <data key="d3">chunk-b9481c4e9169907102e1a6a63fadb365&lt;SEP&gt;chunk-6ead820aa22844313f5dfed6efdc81ce</data>
      <data key="d4">unknown_source</data>
