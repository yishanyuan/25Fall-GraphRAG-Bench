    <node id="Bruges">
      <data key="d0">Bruges</data>
      <data key="d1">location</data>
      <data key="d2">Bruges is a town claiming possession of similar chimes in the year 1300.&lt;SEP&gt;City claiming to have possessed similar chimes in 1300, suggesting early use of carillons.</data>
