    <node id="Seventh Regiment">
      <data key="d0">Seventh Regiment</data>
      <data key="d1">organization</data>
      <data key="d2">The Seventh Regiment was one of the militia units raised in Minnesota.&lt;SEP&gt;The Seventh Regiment was associated with Col. Marshall, who participated in a voting contest.</data>
