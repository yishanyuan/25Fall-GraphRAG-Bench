    <node id="Allgemeine Deutsche Bibliothek">
      <data key="d0">Allgemeine Deutsche Bibliothek</data>
      <data key="d1">organization</data>
      <data key="d2">A literary journal that reviewed Bode’s translation and discussed authorship concerns.&lt;SEP&gt;The Allgemeine Deutsche Bibliothek is a literary review magazine that assesses Sterne’s works and their genuineness, noting characteristic Yorick traits.&lt;SEP&gt;A German publication that expressed an insight into the quality and reception of Sterne’s translated works, recognizing their influence despite some insipid elements.&lt;SEP&gt;The Allgemeine Deutsche Bibliothek is a publication that reviewed Jacobi's conduct and publishing behavior.&lt;SEP&gt;A publication that reviewed the first two parts of Schummel's work.&lt;SEP&gt;The Allgemeine Deutsche Bibliothek is a publication that reviews Wegener's "Raritäten" and discusses its influence and literary taste of the period.</data>
      <data key="d3">chunk-458f12b07f966802c9353e65d5abc548&lt;SEP&gt;chunk-939e417a7df4f7cc2019f7a0a8f2b15a&lt;SEP&gt;chunk-55bae40ef4db541cd7f64d0262ea22a7&lt;SEP&gt;chunk-9e8429a197795773b69fd79fc5921e1e&lt;SEP&gt;chunk-f9c0367c62a6ef1f6fa6379da0c02c96&lt;SEP&gt;chunk-2ccff1ea6ecc4a7b158250715bcedc0a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608995</data>
      <data key="d6" />
    </node>
    <node id="Neues Bremisches Magazin">
      <data key="d0">Neues Bremisches Magazin</data>
      <data key="d1">organization</data>
      <data key="d2">The Neues Bremisches Magazin was a periodical published from 1770 to 1776 in Bremen, focused on expanding scientific, artistic, and moral knowledge.&lt;SEP&gt;The Neues Bremisches Magazin is a periodical that published translations from English, including Sterne’s sermons and references to Sterne’s works.&lt;SEP&gt;The Neues Bremisches Magazin is a German review that criticizes the book attributed to Sterne, questioning its authenticity.&lt;SEP&gt;A Bremen-based magazine published from 1766 to 1771.</data>
      <data key="d3">chunk-458f12b07f966802c9353e65d5abc548&lt;SEP&gt;chunk-3445af39103910094e6f39b4e9d594d0&lt;SEP&gt;chunk-573f9ee936a1b21e04721d34c3cc59f8&lt;SEP&gt;chunk-b00bff87303bf89315a4f5f9c478e3b5</data>
      <data key="d4">unknown_source</data>
