    <node id="Rhaad">
      <data key="d0">Rhaad</data>
      <data key="d1">creature</data>
      <data key="d2">Rhaad is a bird resembling a pigeon but more swift, with white wings.</data>
      <data key="d3">chunk-712990bb2ebe5d62b532d770bfe4b95c</data>
