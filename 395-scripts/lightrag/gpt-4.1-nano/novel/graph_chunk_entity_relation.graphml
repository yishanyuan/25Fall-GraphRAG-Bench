    <node id="Moral">
      <data key="d0">Moral</data>
      <data key="d1">concept</data>
      <data key="d2">Moral is discussed as a standard of virtue that may be misapplied or misunderstood, especially in social and political contexts.</data>
      <data key="d3">chunk-d98dca421f9ad7bdbf89c28e679535b6&lt;SEP&gt;chunk-8c6ddbee998a17d32743b8b0df30530b</data>
      <data key="d4">unknown_source</data>
