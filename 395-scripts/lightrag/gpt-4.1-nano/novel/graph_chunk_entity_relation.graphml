    <node id="Trade and War">
      <data key="d0">Trade and War</data>
      <data key="d1">concept</data>
      <data key="d2">Trade and war are seen by Mixtus as necessary, even possibly justified, means to advance commercial and religious goals.</data>
      <data key="d3">chunk-389b8ee79aa909c057f01fc6f9637036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608170</data>
