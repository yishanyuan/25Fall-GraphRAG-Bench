    <node id="John P. Owens">
      <data key="d0">John P. Owens</data>
      <data key="d1">person</data>
      <data key="d2">John P. Owens was a partner with George W. Moore in the publication of the Minnesotian.&lt;SEP&gt;John P. Owens was the first editor of the Minnesotian and a printer.&lt;SEP&gt;John P. Owens was the first editor of the Minnesotian newspaper.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42&lt;SEP&gt;chunk-b435924602432e6d898c0d4eced2d0f6&lt;SEP&gt;chunk-be8b49c919bf06f613da48187833e98b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610007</data>
