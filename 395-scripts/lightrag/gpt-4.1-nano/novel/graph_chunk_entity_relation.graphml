    </node>
    <node id="Efza">
      <data key="d0">Efza</data>
      <data key="d1">location</data>
      <data key="d2">Efza is a smaller town or suburb two miles east of Tefza, inhabited by Berbers, noted for woollen and weaving crafts.&lt;SEP&gt;Efza is a small town located two miles east of Tefza, considered a suburb, divided from Tefza by the river Derna.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f&lt;SEP&gt;chunk-78c973a4a4c99e07c3571a6d29d1779d</data>
