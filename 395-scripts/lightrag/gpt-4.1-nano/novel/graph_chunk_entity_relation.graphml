    <node id="The Nervous System">
      <data key="d0">The Nervous System</data>
      <data key="d1">concept</data>
      <data key="d2">The nervous system comprises the brain, spinal cord, and nerves, coordinating sensation, movement, and vital functions such as breathing.</data>
      <data key="d3">chunk-9a2b65dd2ccf6640dc6d501c52589484</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764612180</data>
