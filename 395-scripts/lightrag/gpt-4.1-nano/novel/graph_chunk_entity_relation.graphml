      <data key="d0">Amury Girod</data>
      <data key="d1">person</data>
      <data key="d2">Amury Girod was a mysterious adventurer and chief organizer of revolts in St Eustache, allegedly dispatched from Papineau with credentials.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
