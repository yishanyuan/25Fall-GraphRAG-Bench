    <node id="Medium">
      <data key="d0">Medium</data>
      <data key="d1">other</data>
      <data key="d2">The medium is depicted as a powerful entity with a supposed ability to exhibit surprising phenomena, but characterized by a lack of discriminating perception and activity of misrepresentation.</data>
      <data key="d3">chunk-6a7b8e5007a6fc7408c5fb336be05812&lt;SEP&gt;chunk-7f5219425f0dd684e1c14ee102afdc4b</data>
