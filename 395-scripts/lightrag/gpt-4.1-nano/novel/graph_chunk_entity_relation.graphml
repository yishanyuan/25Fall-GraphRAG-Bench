    <node id="Charles Buller">
      <data key="d0">Charles Buller</data>
      <data key="d1">person</data>
      <data key="d2">Charles Buller was Lord Durham's chief secretary and a friend and pupil of Thomas Carlyle, involved in advising Durham during the Canadian rebellion.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609499</data>
      <data key="d6" />
    </node>
    <node id="Thomas Carlyle">
      <data key="d0">Thomas Carlyle</data>
      <data key="d1">person</data>
      <data key="d2">Thomas Carlyle was a Scottish philosopher and writer, whom Charles Buller was a friend and pupil of.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609499</data>
      <data key="d6" />
    </node>
    <node id="Durham">
      <data key="d0">Durham</data>
      <data key="d1">person</data>
      <data key="d2">Durham, referring to Lord Durham, was a British colonial administrator who decided to grant a general amnesty to rebels and governed during the Canadian rebellion.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609499</data>
      <data key="d6" />
    </node>
    <node id="Lord Brougham">
      <data key="d0">Lord Brougham</data>
      <data key="d1">person</data>
      <data key="d2">Lord Brougham was a politician and opponent of Lord Durham who argued that Durham lacked the authority to pass sentence and act without trial in Canada.&lt;SEP&gt;Lord Brougham is associated with an Act concerning abolition of slavery, which was circulated among merchants.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e&lt;SEP&gt;chunk-4bc0fa20a8bb60c2f53107ccd7d2bbec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614556</data>
      <data key="d6" />
    </node>
    <node id="Bermuda">
      <data key="d0">Bermuda</data>
      <data key="d1">location</data>
      <data key="d2">Bermuda was designated for the transportation of some prisoners as part of Durham's amnesty plan.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609500</data>
      <data key="d6" />
    </node>
    <node id="The Times">
      <data key="d0">The Times</data>
      <data key="d1">content</data>
      <data key="d2">The Times is a publication that issued a proclamation critical to the context described in the text.&lt;SEP&gt;The Times is a newspaper that published news about Durham's resignation and nickname "Lord High Seditioner."&lt;SEP&gt;The Times is a newspaper that published a graphic report of the Sioux and Chippewa battle.&lt;SEP&gt;The Times was a newspaper managed by Mr. Newson until January 1861.&lt;SEP&gt;The Times is a newspaper providing a paragraph about a donation from Dr. Jedd to the Restoration Fund and expectations of other donors contributing.&lt;SEP&gt;The "Times" is a publication discussed as something the Dean is anxious to receive.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e&lt;SEP&gt;chunk-26bd7dcdcc38c1ce5338b530f0ab8694&lt;SEP&gt;chunk-13efecfdb402b12d9a005785fb5d0e8f&lt;SEP&gt;chunk-2a3ab772f4c7d1211b5007a6c92e23da&lt;SEP&gt;chunk-50b102270ef0e98eb298e79412603ac2&lt;SEP&gt;chunk-ea62626f9134cd6522f82d474b2c357b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614935</data>
      <data key="d6" />
    </node>
