    <node id="L. J. Papineau">
      <data key="d0">L. J. Papineau</data>
      <data key="d1">person</data>
      <data key="d2">L. J. Papineau was a political figure involved in the Lower Canada rebellion of 1837, known for denying his primary role in the uprising and for being reluctant about armed rebellion.</data>
      <data key="d3">chunk-86a0a44acd086e0907bf225584c3be7a</data>
