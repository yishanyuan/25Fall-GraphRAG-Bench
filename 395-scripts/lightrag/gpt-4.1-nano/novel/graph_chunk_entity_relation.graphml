    <node id="Andromeda">
      <data key="d0">Andromeda</data>
      <data key="d1">other</data>
      <data key="d2">Andromeda is the daughter of Cepheus, punished by the gods with exposure to a sea-monster due to her mother Cassiope's arrogance.&lt;SEP&gt;Andromeda was rescued from a sea monster by Perseus, according to myth.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-a0dd004d7bb30cbae402f5f620fd614a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610597</data>
      <data key="d6" />
    </node>
    <node id="Sea Monster">
      <data key="d0">Sea Monster</data>
      <data key="d1">other</data>
      <data key="d2">A sea monster in mythological stories from which Andromeda was rescued.</data>
      <data key="d3">chunk-c2ae1d708e454e0e6bf3e72d6ca49fad&lt;SEP&gt;chunk-4958bc3b034dd7b59c1c0df2fab2b8d5</data>
