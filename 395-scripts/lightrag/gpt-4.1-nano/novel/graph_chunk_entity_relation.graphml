    <node id="Couch">
      <data key="d0">Couch</data>
      <data key="d1">other</data>
      <data key="d2">A couch in Roman dining contexts was a piece of furniture upon which guests reclined during meals, usually in groups of three or four.</data>
      <data key="d3">chunk-52ca25c65db54cb74a2c1bd788c198c8</data>
