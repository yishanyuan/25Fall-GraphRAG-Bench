    <node id="Al-Farabi">
      <data key="d0">Al-Farabi</data>
      <data key="d1">person</data>
      <data key="d2">Al-Farabi was an influential philosopher and musician who devised methods for changing musical modes to influence emotions.&lt;SEP&gt;An early Arabian musical theorist from the beginning of the tenth century, noted for his silence on the bow in relation to string instruments.&lt;SEP&gt;A renowned Arabian musical theorist who studied in Spain and gained international fame.</data>
      <data key="d3">chunk-93589ec60a74676e9a13006653f3b90f&lt;SEP&gt;chunk-4512b69e3496f492631c7653788034d1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613912</data>
      <data key="d6" />
    </node>
    <node id="American Indians">
      <data key="d0">American Indians</data>
      <data key="d1">organization</data>
      <data key="d2">American Indians are the indigenous peoples of the western hemisphere, with ancient relics and musical instruments dating prior to European contact.&lt;SEP&gt;Indigenous peoples of the Americas who used sonorous stones and possibly stringed instruments.&lt;SEP&gt;American Indians are indigenous peoples of North, Central, and South America with distinct traditions, including musical practices and instrument construction.</data>
      <data key="d3">chunk-93589ec60a74676e9a13006653f3b90f&lt;SEP&gt;chunk-82544a13bf6799b0efc4d2f2a5e62661&lt;SEP&gt;chunk-73ed7c284b3a9d9caa2237f4d2af971d&lt;SEP&gt;chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
