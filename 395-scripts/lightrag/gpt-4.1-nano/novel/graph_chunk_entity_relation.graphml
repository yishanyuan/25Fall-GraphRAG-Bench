      <data key="d0">Rocky Mountain Range</data>
      <data key="d1">location</data>
      <data key="d2">The Rocky Mountain range runs north to south through southern New Mexico and neighboring states, hosting the Mimbres Mountains.</data>
      <data key="d3">chunk-00f9b572c1542009383cf9c5ae7c06e3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611617</data>
