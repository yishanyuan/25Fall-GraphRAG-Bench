      <data key="d0">My God</data>
      <data key="d1">content</data>
      <data key="d2">Phrase associated with Jesus' last words, possibly an interpretation of Maya words indicating sinking and darkness.</data>
      <data key="d3">chunk-37549c49b71d3d70c292402a64c108aa</data>
