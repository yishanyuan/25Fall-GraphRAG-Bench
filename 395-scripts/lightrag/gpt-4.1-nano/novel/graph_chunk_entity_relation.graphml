      <data key="d0">Korah</data>
      <data key="d1">person</data>
      <data key="d2">Korah is a Hebrew figure known for rebellion against divine authority, symbolizing opposition to divine ordinance.</data>
      <data key="d3">chunk-03c71c290709c5f72698f04e1bf6628a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608138</data>
