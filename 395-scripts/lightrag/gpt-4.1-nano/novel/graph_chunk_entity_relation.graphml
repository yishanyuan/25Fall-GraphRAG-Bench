    <node id="Population of Morocco">
      <data key="d0">Population of Morocco</data>
      <data key="d1">data</data>
      <data key="d2">Estimated at around 8,500,000 by Graeberg, with various classifications such as Amazirghs, Arabs, Israelites, Europeans, and others.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614547</data>
      <data key="d6" />
    </node>
    <node id="Amazirghs">
      <data key="d0">Amazirghs</data>
      <data key="d1">people</data>
      <data key="d2">Amazirghs are an aboriginal Berber population class in Morocco, estimated at 2,300,000.&lt;SEP&gt;Amazirghs are an indigenous Berber tribe, reputed for their civilization, governance, native manufactures, and commerce.&lt;SEP&gt;The Amazirghs are the indigenous Berber people of North Africa, descendants of the original inhabitants.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-11883b983a6b12419bdd608231cd321f&lt;SEP&gt;chunk-0fd702921e8d3a990c6c7e84369cba36</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614547</data>
      <data key="d6" />
    </node>
