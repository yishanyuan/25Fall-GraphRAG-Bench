    <node id="Fra Angelico">
      <data key="d0">Fra Angelico</data>
      <data key="d1">person</data>
      <data key="d2">Fra Angelico is an artist whose work, such as the _Coronation of the Virgin_, is praised for having a strain of reality and aesthetic charm based on selective sensibility.</data>
      <data key="d3">chunk-6a7b8e5007a6fc7408c5fb336be05812</data>
