    </node>
    <node id="Gibel Zaterit">
      <data key="d0">Gibel Zaterit</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Gibel Zaterit, also called "Monkey's Promontory" or "Ape's Hill," is a notable rocky promontory near Ceuta associated with a myth of subterranean passage and friendly intercourse between Africa and Europe.</data>
      <data key="d3">chunk-026c31ea51debe67089624a49cd283a6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614626</data>
      <data key="d6" />
    </node>
    <node id="Beni-Arous">
      <data key="d0">Beni-Arous</data>
      <data key="d1">organization</data>
      <data key="d2">The Beni-Arous are a powerful tribe of Arabs residing in the district of Azgar, which includes El-Araish, the city that is the focus of regional cultivation and trade.</data>
      <data key="d3">chunk-026c31ea51debe67089624a49cd283a6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614626</data>
