    <node id="Kaba">
      <data key="d0">Kaba</data>
      <data key="d1">location</data>
      <data key="d2">Ruins of Kaba are distant from Valladolid, near extensive sheets of water, historically important sites that never have been visited by foreigners.&lt;SEP&gt;Kaba is a significant archaeological site with ruins, located near extensive sheets of water, yet unvisited by foreigners due to risks involved.</data>
      <data key="d3">chunk-8a980d05b1d871a902a88d111d028517</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606705</data>
