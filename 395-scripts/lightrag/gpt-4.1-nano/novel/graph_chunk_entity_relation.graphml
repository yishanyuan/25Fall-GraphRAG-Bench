      <data key="d5">1764614558</data>
      <data key="d6" />
    </node>
    <node id="Lear">
      <data key="d0">Lear</data>
      <data key="d1">content</data>
      <data key="d2">Lear is a play by William Shakespeare, considered by Felicia to be beyond adequate presentation, indicating its significance in theater and literature.&lt;SEP&gt;A parody figure of Lear in a burlesque adaptation, characterized by a monstrous corpulence and comic dance.</data>
