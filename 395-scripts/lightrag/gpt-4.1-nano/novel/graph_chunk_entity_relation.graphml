    </node>
    <node id="Medicine Bottle">
      <data key="d0">Medicine Bottle</data>
      <data key="d1">person</data>
      <data key="d2">Medicine Bottle was a Sioux chief involved in the outbreak, arrested and executed with Little Six.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610017</data>
      <data key="d6" />
    </node>
    <node id="Fort Gary">
      <data key="d0">Fort Gary</data>
      <data key="d1">location</data>
      <data key="d2">Fort Gary (Winnipeg) was a site where Sioux chiefs Little Six and Medicine Bottle were arrested.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8</data>
      <data key="d4">unknown_source</data>
