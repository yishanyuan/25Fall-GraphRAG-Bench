    <node id="Foreign Office">
      <data key="d0">Foreign Office</data>
      <data key="d1">organization</data>
      <data key="d2">The Foreign Office is a UK government department responsible for managing diplomatic relations and supporting British hospitals and aid operations abroad during World War I.&lt;SEP&gt;The Foreign Office was a government body involved in diplomatic and wartime negotiations affecting Serbian and Allied relief efforts.</data>
      <data key="d3">chunk-c858db77dc3126e37cd384f8634ecffd&lt;SEP&gt;chunk-2aa2387fc90852af29634d0f93b3c46b</data>
