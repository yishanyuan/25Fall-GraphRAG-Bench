    <node id="Noblemen">
      <data key="d0">Noblemen</data>
      <data key="d1">person</data>
      <data key="d2">Noblemen are described as those who generously presented boroughs to encourage political gratitude.&lt;SEP&gt;Noblemen are individuals who present boroughs to encourage gratitude and influence election methods in England.</data>
      <data key="d3">chunk-e94b824e125ccc07ef22224a84ba470f&lt;SEP&gt;chunk-abefe66985061e17bec49f1898419196</data>
      <data key="d4">unknown_source</data>
