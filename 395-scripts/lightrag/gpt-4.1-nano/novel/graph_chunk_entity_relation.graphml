    <node id="Mr Apollos">
      <data key="d0">Mr Apollos</data>
      <data key="d1">person</data>
      <data key="d2">Mr Apollos is a religious figure whose enlightened interpretations are seen by Scintilla as heavy and dull.</data>
      <data key="d3">chunk-9cbb983a5992ca5627430872d4cdac4b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608134</data>
      <data key="d6" />
    </node>
    <node id="Mr Johns">
      <data key="d0">Mr Johns</data>
      <data key="d1">person</data>
      <data key="d2">Mr Johns is a local preacher associated with the Baptist chapel, considered dull and ridiculous by Scintilla.</data>
      <data key="d3">chunk-9cbb983a5992ca5627430872d4cdac4b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608134</data>
