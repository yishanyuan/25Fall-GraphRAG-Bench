      <data key="d0">Sri Lanka</data>
      <data key="d1">location</data>
      <data key="d2">Sri Lanka is the modern name for the country historically called Ceylon, associated with the origin of the Ravanastron.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613900</data>
      <data key="d6" />
    </node>
    <node id="Queen Elizabeth">
      <data key="d0">Queen Elizabeth</data>
      <data key="d1">person</data>
      <data key="d2">Queen Elizabeth was a monarch during whose reign the old instruments in England were in common use.&lt;SEP&gt;Queen Elizabeth's era is associated with the use and reference to various musical instruments, whose shapes and construction can provide historical insights.&lt;SEP&gt;Queen Elizabeth was the monarch during whose reign a young nobleman waited to inherit an earldom.</data>
      <data key="d3">chunk-c0658b2c968fe6ee5f181166477508b2&lt;SEP&gt;chunk-95a9160a14d7266e2100e2d55ebcd715&lt;SEP&gt;chunk-9b8a70ed68b8ad9957789f681884b2ba</data>
