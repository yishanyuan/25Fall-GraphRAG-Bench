    <node id="Rob Roy">
      <data key="d0">Rob Roy</data>
      <data key="d1">person</data>
      <data key="d2">Rob Roy was a seasoned wood cutter employed by Old Smith, living alone in a cabin.&lt;SEP&gt;Rob Roy is an aging bachelor wood cutter living alone on Old Smith's land, known for his polished ax and habits of drinking whisky on Sabbath.</data>
      <data key="d3">chunk-01da3252de63d3437b7317d570944a2c&lt;SEP&gt;chunk-a3d5b1a3d2da2bcf2bd68dce9ef1b9e2</data>
