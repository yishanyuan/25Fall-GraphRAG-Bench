      <data key="d6" />
    </node>
    <node id="New Orleans">
      <data key="d0">New Orleans</data>
      <data key="d1">location</data>
      <data key="d2">New Orleans is where Bailie Peyton's sword was presented by its citizens.&lt;SEP&gt;City where Rose plans to buy furniture for her new house with Simon.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88&lt;SEP&gt;chunk-297e2cf3fdd658f56fcb73ec4f707e74&lt;SEP&gt;chunk-6de2fcc61f99e91491ef81fa40580ae4</data>
