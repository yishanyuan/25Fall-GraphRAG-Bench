    </node>
    <node id="Ammunition">
      <data key="d0">Ammunition</data>
      <data key="d1">data</data>
      <data key="d2">800 rounds of ammunition were stored in the office for use in case of attack.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
