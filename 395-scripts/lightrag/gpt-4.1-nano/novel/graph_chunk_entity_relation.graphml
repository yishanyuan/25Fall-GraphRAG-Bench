    <node id="Nechiloth">
      <data key="d0">Nechiloth</data>
      <data key="d1">artifact</data>
      <data key="d2">Nechiloth is presumed to be a flute or similar wind instrument mentioned as a musical instrument used in psalms.</data>
      <data key="d3">chunk-c7da70d39d1688e8eb35f0af080c5cf6</data>
      <data key="d4">unknown_source</data>
