    <node id="Demitt">
      <data key="d0">Demitt</data>
      <data key="d1">person</data>
      <data key="d2">Demitt is a person who lives in a double log house, with a large dog, a house-cat, and is observed by the Angel eye of observation.&lt;SEP&gt;An old man who fell asleep against a fence and died from exposure during winter.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74&lt;SEP&gt;chunk-51ac45ec6721641ae16ac8fcb28ed74f</data>
