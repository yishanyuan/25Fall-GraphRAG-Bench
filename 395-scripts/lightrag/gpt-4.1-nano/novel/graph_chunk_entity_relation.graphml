    </node>
    <node id="Coal Pitch">
      <data key="d0">Coal Pitch</data>
      <data key="d1">artifact</data>
      <data key="d2">Broken coal pitch is added to the mixture at a proportion of eight to ten percent of the coal to enhance fuel properties.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
      <data key="d6" />
    </node>
    <node id="Crushing Machine">
      <data key="d0">Crushing Machine</data>
      <data key="d1">method</data>
      <data key="d2">The crushing machine reduces the mixture to powder and mixes it thoroughly.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
      <data key="d6" />
    </node>
    <node id="Pug-Mill">
      <data key="d0">Pug-Mill</data>
      <data key="d1">method</data>
      <data key="d2">The pug-mill mixes the paste with superheated steam, converting it into a plastic form.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
      <data key="d6" />
    </node>
    <node id="Agitator">
      <data key="d0">Agitator</data>
      <data key="d1">method</data>
      <data key="d2">The agitator frees the paste from steam and distributes it into moulds for compressing.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
      <data key="d6" />
    </node>
    <node id="Bilan's Machine">
      <data key="d0">Bilan's Machine</data>
      <data key="d1">artifact</data>
      <data key="d2">Bilan's machine produces spherical conglomerates for domestic fuel by moulding the paste into complete spheres using four vertically aligned moulding wheels.</data>
      <data key="d3">chunk-a6510bcba4927842385e29bbc2af2614</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611671</data>
