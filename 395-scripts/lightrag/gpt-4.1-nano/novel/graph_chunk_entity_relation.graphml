      <data key="d13" />
    </edge>
    <edge source="Old-fashioned Soap Making" target="Modern Soap Making">
      <data key="d7">1.0</data>
      <data key="d8">Traditional soap making involved boiling with ashes, whereas modern methods use dissolved pure caustic potash for cleaner, neutral soap.</data>
      <data key="d9">method,process</data>
      <data key="d10">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
