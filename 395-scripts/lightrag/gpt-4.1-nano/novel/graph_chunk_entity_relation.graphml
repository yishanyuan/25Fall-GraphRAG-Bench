    <node id="Mary Gilman">
      <data key="d0">Mary Gilman</data>
      <data key="d1">person</data>
      <data key="d2">Mary Gilman is a cousin of Angeline who sought to expand the curriculum at McGrawville's institute by teaching fine arts.&lt;SEP&gt;Family member of Lyman, daughter of Mrs. Hall’s cousin, involved in negotiations over the salary of the Torrington creamery superintendency.</data>
      <data key="d3">chunk-50e24a8d13114f74ad6389fc6ea6b12f&lt;SEP&gt;chunk-0385599a16e6adec90c4a4bae922a43d</data>
