      <data key="d1">concept</data>
      <data key="d2">Racial conflict refers to disputes or tensions based on race, here related to the form of taxation.</data>
      <data key="d3">chunk-2b195a27b43ec85da2d0175fa01cef0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609500</data>
