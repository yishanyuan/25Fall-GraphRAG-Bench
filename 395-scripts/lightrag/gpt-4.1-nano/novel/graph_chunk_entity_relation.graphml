    </node>
    <node id="Clavicembalo">
      <data key="d0">Clavicembalo</data>
      <data key="d1">artifact</data>
      <data key="d2">The _clavicembalo_ was a predecessor of the pianoforte, characterized by a keyboard and trapezium shape, with some preserved examples exhibiting specific features.</data>
      <data key="d3">chunk-95a9160a14d7266e2100e2d55ebcd715</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613917</data>
