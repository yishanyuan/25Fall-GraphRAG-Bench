    <node id="Captain Tuckey">
      <data key="d0">Captain Tuckey</data>
      <data key="d1">person</data>
      <data key="d2">Captain Tuckey observed a Congo instrument decorated with a broken frame of a looking-glass and brass buttons bearing Louis XVI's head.</data>
