      <data key="d0">Pittankinningy Mountains</data>
      <data key="d1">location</data>
      <data key="d2">The Pittankinningy Mountains provided slate supplies through operations started by 1826.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611635</data>
      <data key="d6" />
    </node>
    <node id="Schuylkill">
      <data key="d0">Schuylkill</data>
      <data key="d1">location</data>
      <data key="d2">The Schuylkill River was used for transporting slate products from Pennsylvania to Philadelphia.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611635</data>
