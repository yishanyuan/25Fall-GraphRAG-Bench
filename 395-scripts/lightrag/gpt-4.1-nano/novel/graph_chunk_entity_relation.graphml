    </node>
    <node id="Vina">
      <data key="d0">Vina</data>
      <data key="d1">artifact</data>
      <data key="d2">The vina is an ancient Hindu musical instrument with seven wire strings, movable frets, and hollow gourds for sound amplification, regarded as highly antique.&lt;SEP&gt;Vina is a Hindu stringed instrument.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6&lt;SEP&gt;chunk-662dfab4657790a73298dc9f0446a502&lt;SEP&gt;chunk-f440a8129c9633e91b0a40eef56e62b1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613899</data>
      <data key="d6" />
    </node>
