    </node>
    <node id="Zwaneah">
      <data key="d0">Zwaneah</data>
      <data key="d1">location</data>
      <data key="d2">Zwaneah is a place described as a "little garden," with oranges, dates, and pomegranates.</data>
      <data key="d3">chunk-712990bb2ebe5d62b532d770bfe4b95c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614597</data>
