    <node id="Chariot">
      <data key="d0">Chariot</data>
      <data key="d1">artifact</data>
      <data key="d2">A four-wheeled vehicle used in races at the Circus Maximus, originally with two chariots in each race, later increased to six.&lt;SEP&gt;The chariot, drawn by winged dragons, is a mythological vehicle used by Triptolemus.</data>
      <data key="d3">chunk-eb4eb8f1e4cf05e01dcfb95969a6bb79&lt;SEP&gt;chunk-21c9855ea8a01287d6710833c29e4d0c&lt;SEP&gt;chunk-45e00ab8b0c8791550edf531523e2880</data>
