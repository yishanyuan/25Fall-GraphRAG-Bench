    <node id="Miss Pratt">
      <data key="d0">Miss Pratt</data>
      <data key="d1">person</data>
      <data key="d2">Miss Pratt was the daughter of a Minnesotian paper proprietor who married J.Q.A. Ward secretly after meeting at a ball in Mazurka Hall.</data>
      <data key="d3">chunk-f51a7160323c912396ad629e58d01cca</data>
