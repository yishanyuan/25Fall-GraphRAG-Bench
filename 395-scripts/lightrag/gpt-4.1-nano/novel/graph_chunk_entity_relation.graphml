      <data key="d0">Dr J. O. Chenier</data>
      <data key="d1">person</data>
      <data key="d2">Dr J. O. Chenier was a young physician and supporter of the Patriotes, known for his courage and role in the revolt.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
    <node id="Lake of Two Mountains">
      <data key="d0">Lake of Two Mountains</data>
      <data key="d1">location</data>
      <data key="d2">The Lake of Two Mountains is a location where insurgents at St Eustache broke into government stores and seized weapons.</data>
      <data key="d3">chunk-349529243dbc83f8fcf9f0443bec18f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764609508</data>
      <data key="d6" />
    </node>
