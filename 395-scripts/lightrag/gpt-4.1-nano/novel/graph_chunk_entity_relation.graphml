      <data key="d0">Mound</data>
      <data key="d1">location</data>
      <data key="d2">A small, remarkable mound near the monument, engraved with images of spotted tigers and covered in traces of paint.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf</data>
      <data key="d4">unknown_source</data>
