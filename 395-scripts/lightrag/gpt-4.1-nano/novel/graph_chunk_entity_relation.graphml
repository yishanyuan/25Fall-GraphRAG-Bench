      <data key="d0">Mayan Civilization</data>
      <data key="d1">concept</data>
      <data key="d2">The Mayan civilization was a highly developed ancient culture known for its architecture, mathematics, astronomy, and hieroglyphic writing.</data>
      <data key="d3">chunk-3cf3140092a745267effea6e9a53aa65</data>
      <data key="d4">unknown_source</data>
