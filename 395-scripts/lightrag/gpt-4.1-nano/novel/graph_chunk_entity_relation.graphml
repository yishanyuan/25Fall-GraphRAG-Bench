    <node id="Sheriff">
      <data key="d0">Sheriff</data>
      <data key="d1">organization</data>
      <data key="d2">The sheriff is involved in the sale of the Simon land to pay judgments.&lt;SEP&gt;The sheriff is a law enforcement officer with authority over legal matters and property in the story.</data>
      <data key="d3">chunk-0b703ad46fc561ded805fade2af40be0&lt;SEP&gt;chunk-8e5a1f05827b42a336baccdd4933d843</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613005</data>
