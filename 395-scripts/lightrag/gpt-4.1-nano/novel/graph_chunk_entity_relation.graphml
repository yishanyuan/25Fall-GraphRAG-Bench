      <data key="d6" />
    </node>
    <node id="Mugheir">
      <data key="d0">Mugheir</data>
      <data key="d1">location</data>
      <data key="d2">Mugheir is an archaeological site where brick vaults resembling those in Yucatan have been found.&lt;SEP&gt;Mugheir is an archaeological site where inscriptions on tablets or bricks reveal that ancient peoples used straight lines and geometric structures in their writing.</data>
      <data key="d3">chunk-23ba6980ac19f47019ce87374bfbf5be&lt;SEP&gt;chunk-965b5b39cb58a29f56a43495ef18b6ff</data>
