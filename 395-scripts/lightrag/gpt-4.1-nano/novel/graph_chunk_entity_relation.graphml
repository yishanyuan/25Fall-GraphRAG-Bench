      <data key="d4">unknown_source</data>
      <data key="d5">1764606703</data>
      <data key="d6" />
    </node>
    <node id="Imhotep">
      <data key="d0">Imhotep</data>
      <data key="d1">person</data>
      <data key="d2">Imhotep was an ancient architect associated with the construction of stepped pyramids and similar architectural styles in Egypt.</data>
      <data key="d3">chunk-965b5b39cb58a29f56a43495ef18b6ff</data>
      <data key="d4">unknown_source</data>
