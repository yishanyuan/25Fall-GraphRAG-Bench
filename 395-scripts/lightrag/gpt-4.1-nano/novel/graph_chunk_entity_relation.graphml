    </node>
    <node id="Sheep">
      <data key="d0">Sheep</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Sheep produce wool that can be cleaned and scoured with potash soap to improve quality before market.</data>
      <data key="d3">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611668</data>
      <data key="d6" />
    </node>
    <node id="Wood Ashes">
      <data key="d0">Wood Ashes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Wood ashes are the impure residues from burning wood, historically used in traditional soap-making processes involving boiling with potash.</data>
      <data key="d3">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
      <data key="d4">unknown_source</data>
