    </node>
    <node id="Bernhard">
      <data key="d0">Bernhard</data>
      <data key="d1">person</data>
      <data key="d2">A German believed to have invented the pedal for organs around 1470.</data>
      <data key="d3">chunk-242f71a68c104bb1e671b3e7c72468fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613933</data>
      <data key="d6" />
    </node>
    <node id="Organ Keys">
      <data key="d0">Organ Keys</data>
      <data key="d1">content</data>
      <data key="d2">Enlarged keys of early organs, which a player struck with a fist, similar to those used in playing the carillon.</data>
      <data key="d3">chunk-242f71a68c104bb1e671b3e7c72468fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613933</data>
      <data key="d6" />
    </node>
