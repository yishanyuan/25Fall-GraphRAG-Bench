    <node id="Melilla">
      <data key="d0">Melilla</data>
      <data key="d1">location</data>
      <data key="d2">Melilla is an ancient city founded by Carthaginians, a Spanish presidio, and a port of strategic importance.&lt;SEP&gt;Melilla is a fortified city and port, with a population of about 2,244 according to Spanish sources.</data>
      <data key="d3">chunk-6706573dac6e75677a74dc1ef5caf318</data>
