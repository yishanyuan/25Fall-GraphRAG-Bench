    <node id="Maine">
      <data key="d0">Maine</data>
      <data key="d1">location</data>
      <data key="d2">Maine is a US state known for its granite and quarrying activities, especially after its separation as a distinct state.&lt;SEP&gt;Maine has slate quarries in Piscataquis River area.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7&lt;SEP&gt;chunk-59ad55bacf8e991f7ec32f1bd324e6cb</data>
