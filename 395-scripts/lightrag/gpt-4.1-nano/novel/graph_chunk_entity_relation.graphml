    <node id="Fathers">
      <data key="d0">Fathers</data>
      <data key="d1">person</data>
      <data key="d2">The Fathers are ancestors or early religious figures associated with the covenants and promises.&lt;SEP&gt;Fathers refer to ancestors or predecessors with whom the current generation will sleep.</data>
      <data key="d3">chunk-36f749f37b5c1af95239cafc0a0a74ff&lt;SEP&gt;chunk-f9567484ec2e94de37ab803e0df4f01d</data>
