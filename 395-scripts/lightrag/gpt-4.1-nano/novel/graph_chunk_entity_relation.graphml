      <data key="d0">Roman and Anglo-Saxon Cultures</data>
      <data key="d1">concept</data>
      <data key="d2">Roman and Anglo-Saxon cultures contributed to the early European development and depiction of musical instruments.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613897</data>
      <data key="d6" />
    </node>
    <node id="Spanish">
      <data key="d0">Spanish</data>
      <data key="d1">organization</data>
      <data key="d2">Spanish refers to the nationality of the catholic priests who worked in Central and South America during the 16th century.&lt;SEP&gt;The Spanish built the bridge over the Zig river in Tafilett.&lt;SEP&gt;Spain is mentioned as a region where diverse peoples, including Iberians and Phoenicians, are spread.&lt;SEP&gt;Spanish refers to the nationality involved in the occupation and naming of regions and cities like Alcazar.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68&lt;SEP&gt;chunk-7e6cf13c2e9f84e3b490bbe727b69df5&lt;SEP&gt;chunk-5b1b63bc45a96581a48ba223c8d48c07&lt;SEP&gt;chunk-203f252ae42306fa9f42171f8e2f0f23</data>
