      <data key="d0">Capt. H.P. Grant</data>
      <data key="d1">person</data>
      <data key="d2">Capt. H.P. Grant commanded Company A of the Sixth Regiment during the defense of Fort Ridgely.&lt;SEP&gt;Capt. H.P. Grant commanded Company A of the Sixth regiment involved in the Sioux conflict rescue mission.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-54b8fd90d2cdfb38f2203aba48e470d7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610020</data>
      <data key="d6" />
    </node>
    <node id="Cullen Guards">
      <data key="d0">Cullen Guards</data>
      <data key="d1">organization</data>
      <data key="d2">The Cullen Guards was a militia group under Capt. Jo Anderson involved in the conflict.&lt;SEP&gt;The Cullen Guards, under Capt. Jo Anderson, were volunteers from St. Paul who participated in the military action against Sioux warriors.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-54b8fd90d2cdfb38f2203aba48e470d7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610020</data>
      <data key="d6" />
    </node>
