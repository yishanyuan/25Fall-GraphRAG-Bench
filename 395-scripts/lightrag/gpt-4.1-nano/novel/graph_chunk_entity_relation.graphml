    <node id="Indiana">
      <data key="d0">Indiana</data>
      <data key="d1">location</data>
      <data key="d2">Indiana's farms increased by 20.3% over ten years.&lt;SEP&gt;Indiana is a U.S. state recognized as fully settled with a 20.3% increase in farms over ten years.&lt;SEP&gt;Indiana is a U.S. state characterized by dark green sod and is the setting for a scene involving poverty and domestic dynamics.</data>
      <data key="d3">chunk-8daf6c6c70a3c63c2e7f57dbc969f7c7&lt;SEP&gt;chunk-71098a84f862320370cd4b30b1083858&lt;SEP&gt;chunk-5d6ba5697f9f6ac8decb2198a361839d</data>
