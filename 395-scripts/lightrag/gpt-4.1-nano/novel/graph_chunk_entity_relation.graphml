    <node id="Burgoyne">
      <data key="d0">Burgoyne</data>
      <data key="d1">person</data>
      <data key="d2">Burgoyne was a British general whose surrender marked a significant event in the American Revolutionary War.</data>
      <data key="d3">chunk-63ada5b526daab8bb42bced4bd5ee488</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607663</data>
