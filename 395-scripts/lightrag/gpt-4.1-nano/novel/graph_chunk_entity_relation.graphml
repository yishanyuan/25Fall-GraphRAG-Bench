    <node id="Minnesota River">
      <data key="d0">Minnesota River</data>
      <data key="d1">location</data>
      <data key="d2">The Minnesota River marked part of the depopulated area during the outbreak.&lt;SEP&gt;The Minnesota River served as a route for boats carrying refugees fleeing Sioux attacks.</data>
      <data key="d3">chunk-49dd4de896cb4d1aa7c0c3db3861fcd1&lt;SEP&gt;chunk-c5b84432ad1a7600b31aab3ee4243129</data>
