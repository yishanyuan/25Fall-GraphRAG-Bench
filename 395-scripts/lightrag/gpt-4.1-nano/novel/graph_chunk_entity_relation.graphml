      <data key="d0">Amber</data>
      <data key="d1">location</data>
      <data key="d2">Amber is a city mentioned as part of the journey described in the account of a visit involving Indian temples.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
