      <data key="d4">unknown_source</data>
      <data key="d5">1764613936</data>
      <data key="d6" />
    </node>
    <node id="Instrument">
      <data key="d0">Instrument</data>
      <data key="d1">content</data>
      <data key="d2">An instrument with a neck fitted with frets of string, regulated according to seventeen intervals in an octave system.</data>
      <data key="d3">chunk-4512b69e3496f492631c7653788034d1&lt;SEP&gt;chunk-7c32645e26c49665a71ca04b6c2eea85&lt;SEP&gt;chunk-c7da70d39d1688e8eb35f0af080c5cf6</data>
