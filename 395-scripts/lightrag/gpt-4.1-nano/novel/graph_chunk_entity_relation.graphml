      <data key="d0">Wad-el-Mesah</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Wad-el-Mesah is a river near Talent, flowing through the district.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
    <node id="Ilirgh">
      <data key="d0">Ilirgh</data>
      <data key="d1">location</data>
      <data key="d2">Ilirgh (or Ilekh) is a populous village located about a mile from Talent, known for a famous sanctuary.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
