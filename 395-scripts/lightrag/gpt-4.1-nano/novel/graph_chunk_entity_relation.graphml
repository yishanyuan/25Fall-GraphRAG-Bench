    <node id="President">
      <data key="d0">President</data>
      <data key="d1">person</data>
      <data key="d2">The President was the highest executive authority whose decision regarding the condemned Indians created national attention and anticipation.</data>
      <data key="d3">chunk-68a152136647fcdc06015572bf449dc8&lt;SEP&gt;chunk-d9cb7dc890f79266a4c27289acbd4e0f&lt;SEP&gt;chunk-259cd15d2a822dcb52e2f16a8974a319&lt;SEP&gt;chunk-46289654522dd0ee1ffdeb77be06722d</data>
