      <data key="d1">concept</data>
      <data key="d2">The principal goddesses are deities after whom the four young girls are named, symbolizing divine attributes or celestial figures.</data>
      <data key="d3">chunk-4fea727469cc8526b5cd257ed6247a09</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613937</data>
