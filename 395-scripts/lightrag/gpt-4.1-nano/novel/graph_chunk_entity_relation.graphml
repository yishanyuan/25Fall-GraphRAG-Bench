    <node id="Oushda">
      <data key="d0">Oushda</data>
      <data key="d1">location</data>
      <data key="d2">Oushda is a frontier town protected by a fortress, with a population between six hundred and one thousand Moors and Arabs, situated on the oasis of the Desert of Angad.</data>
      <data key="d3">chunk-78c973a4a4c99e07c3571a6d29d1779d</data>
