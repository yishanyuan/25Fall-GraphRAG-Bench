    <node id="Tiahuanaco">
      <data key="d0">Tiahuanaco</data>
      <data key="d1">location</data>
      <data key="d2">Tiahuanaco is an archaeological site near Lake Titicaca, associated with ancient rulers and the four provinces they governed, illustrating the theme of four-fold division.</data>
      <data key="d3">chunk-4953aba767e12ab2c6cc0f2d20adf220</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606704</data>
      <data key="d6" />
    </node>
