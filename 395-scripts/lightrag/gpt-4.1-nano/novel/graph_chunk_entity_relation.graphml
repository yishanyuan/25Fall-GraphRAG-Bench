      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
      <data key="d6" />
    </node>
    <node id="Gerbert">
      <data key="d0">Gerbert</data>
      <data key="d1">person</data>
      <data key="d2">Gerbert was a scholar who preserved tracings of medieval musical instrument illustrations, published in 1774.&lt;SEP&gt;Gerbert is mentioned as an abbot, likely a historical figure connected to the history or development of musical instruments or theory.</data>
      <data key="d3">chunk-0ae2e9bd1b638782eb9d45c99ff65a68&lt;SEP&gt;chunk-662dfab4657790a73298dc9f0446a502</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
      <data key="d6" />
