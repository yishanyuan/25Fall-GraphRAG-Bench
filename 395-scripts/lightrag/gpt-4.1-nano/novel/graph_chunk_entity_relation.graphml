      <data key="d6" />
    </node>
    <node id="Joe">
      <data key="d0">Joe</data>
      <data key="d1">person</data>
      <data key="d2">Joe is a boy who helps hitch a horse and prepare a slide for transporting the children.&lt;SEP&gt;Joe is a character who uses a long switch to keep Ned ahead while traveling downhill.&lt;SEP&gt;A boy who drove the wood slide and later went to Canada enjoying his freedom.</data>
      <data key="d3">chunk-297e2cf3fdd658f56fcb73ec4f707e74&lt;SEP&gt;chunk-08b9d6f937baa20d8292bac71db403dc&lt;SEP&gt;chunk-51ac45ec6721641ae16ac8fcb28ed74f</data>
