    <node id="Grove">
      <data key="d0">Grove</data>
      <data key="d1">location</data>
      <data key="d2">The grove is an ancient, uncut natural area believed to be inhabited by a deity, featuring a spring and a grotto with birds singing.&lt;SEP&gt;An ancient grove with numerous trees, sacred to the festival of Juno.</data>
