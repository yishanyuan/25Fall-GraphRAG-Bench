      <data key="d0">Lixus</data>
      <data key="d1">location</data>
      <data key="d2">Lixus is an ancient city near El-Araish, notable for its archaeological significance, coins, ruins, and historical importance in Phoenician and Roman periods.</data>
      <data key="d3">chunk-026c31ea51debe67089624a49cd283a6</data>
      <data key="d4">unknown_source</data>
