      <data key="d0">Mr. Wright</data>
      <data key="d1">person</data>
      <data key="d2">Mr. Wright is associated with helping Nellie and Mrs. Wright, mentioned in the context of her sickness.</data>
      <data key="d3">chunk-d483764952d7db72ab6b8abd0b9b597f</data>
