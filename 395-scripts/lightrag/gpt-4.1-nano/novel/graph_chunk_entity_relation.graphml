    <node id="Tefza">
      <data key="d0">Tefza</data>
      <data key="d1">location</data>
      <data key="d2">Tefza is the capital of the province of Todla, built on the Atlas, surrounded by a high sandstone wall, inhabited by Berbers, known for woollen works.&lt;SEP&gt;Tefza is a town inhabited by Berbers, known for its native black and white woollen manufactures, and surrounded by a high wall of sandstone.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f&lt;SEP&gt;chunk-78c973a4a4c99e07c3571a6d29d1779d</data>
