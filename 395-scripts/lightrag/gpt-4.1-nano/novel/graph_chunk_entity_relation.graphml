      <data key="d0">Ancestor Worship</data>
      <data key="d1">concept</data>
      <data key="d2">The worship of heroes and ancestors by the Mayas and their descendants influenced cultural and religious practices.</data>
      <data key="d3">chunk-964858730c8a8dc2179e59d3cb07c3cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606698</data>
