    <node id="Goddess Maia">
      <data key="d0">Goddess Maia</data>
      <data key="d1">concept</data>
      <data key="d2">Maia is a goddess in Greek mythology, identified as the daughter of Atlantis, associated with fertility and growth.</data>
      <data key="d3">chunk-2f47d3b712e0953b518a70453701f3ad&lt;SEP&gt;chunk-a22b4bcd91dd2d8b9fa5db8f58d88ab4</data>
