    <node id="Psenophis">
      <data key="d0">Psenophis</data>
      <data key="d1">person</data>
      <data key="d2">Psenophis is a priest of Heliopolis who, along with Sonchis, is associated with legends regarding the antiquity of lands across oceans.</data>
      <data key="d3">chunk-f83c27282913cff5172f6cf0dfa303eb</data>
      <data key="d4">unknown_source</data>
