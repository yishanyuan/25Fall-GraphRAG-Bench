    <node id="Tintagel Castle">
      <data key="d0">Tintagel Castle</data>
      <data key="d1">location</data>
      <data key="d2">Tintagel Castle is a historic site with two castles, one sitting in the sea and the other on the mainland, connected by a causeway, associated with the legend of King Arthur.</data>
      <data key="d3">chunk-322cff857c0beb5c471bdf49a8426f1d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764615511</data>
