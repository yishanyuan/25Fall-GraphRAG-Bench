    <node id="The Democrat">
      <data key="d0">The Democrat</data>
      <data key="d1">content</data>
      <data key="d2">The Democrat was a Minnesota newspaper started by Col. Robertson, later consolidated with the Pioneer.&lt;SEP&gt;The Democrat was a newspaper for which Andrew Jackson Morgan served as foreman and editor.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b&lt;SEP&gt;chunk-be8b49c919bf06f613da48187833e98b</data>
