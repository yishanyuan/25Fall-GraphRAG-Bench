    </node>
    <node id="Fourth of July, 1863">
      <data key="d0">Fourth of July, 1863</data>
      <data key="d1">event</data>
      <data key="d2">The Fourth of July in 1863 marked a significant day with major Civil War battles and celebrations.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="Battle of Gettysburg">
      <data key="d0">Battle of Gettysburg</data>
      <data key="d1">event</data>
      <data key="d2">One of the greatest Civil War battles that occurred on July 4, 1863.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="Surrender of Vicksburg">
      <data key="d0">Surrender of Vicksburg</data>
      <data key="d1">event</data>
      <data key="d2">The surrender of Vicksburg was a major Civil War event alongside the Battle of Gettysburg.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="News">
      <data key="d0">News</data>
      <data key="d1">content</data>
      <data key="d2">News about Minnesota’s admission was delayed due to the lack of telegraphic communication and was scooped by a passenger’s report.&lt;SEP&gt;News of the great Civil War events was eagerly awaited, with crowd excitement and celebrations in St. Paul.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
      <data key="d6" />
    </node>
    <node id="Crowd">
      <data key="d0">Crowd</data>
      <data key="d1">person</data>
      <data key="d2">A large crowd gathered outside the Press office, eager for news of the victories.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e&lt;SEP&gt;chunk-056576ea60bd0b171586a0c122f845b3&lt;SEP&gt;chunk-4df25ca25a175761aaaa6532ccedf415</data>
