    <node id="Indian temples">
      <data key="d0">Indian temples</data>
      <data key="d1">location</data>
      <data key="d2">The Indian temples described have markings of human hands on their walls, used in religious rites.</data>
      <data key="d3">chunk-b75bf9652f1afa0e3e6a35dbcd6728e0</data>
