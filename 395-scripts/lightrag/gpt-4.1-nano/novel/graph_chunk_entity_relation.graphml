    </node>
    <node id="Santa Anna">
      <data key="d0">Santa Anna</data>
      <data key="d1">person</data>
      <data key="d2">Santa Anna was a Mexican general whose surrender of Mexico City was received by Bailie Peyton during the Mexican War.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610004</data>
      <data key="d6" />
    </node>
    <node id="City of Mexico">
      <data key="d0">City of Mexico</data>
      <data key="d1">location</data>
      <data key="d2">The City of Mexico was surrendered to Gen. Scott, with Bailie Peyton involved in the surrender.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610004</data>
      <data key="d6" />
    </node>
    <node id="Mexican War">
      <data key="d0">Mexican War</data>
      <data key="d1">event</data>
      <data key="d2">The Mexican War was a conflict in which Capt. Shelly participated, fighting for Mexico.&lt;SEP&gt;The Mexican War was a conflict in which Bailie Peyton participated, receiving a sword from the citizens of New Orleans.&lt;SEP&gt;Historical conflict during which Bailie Peyton was presented with his sword, linking his military service across wars.</data>
      <data key="d3">chunk-b25d808efd0dbadcf025072656cfeb88&lt;SEP&gt;chunk-2a4789d4f1f7c874d43ac8b35b4ece9b</data>
