    <node id="Rose Simon">
      <data key="d0">Rose Simon</data>
      <data key="d1">person</data>
      <data key="d2">Rose Simon is a woman who is believed to be the heir to her mother's fortune, and is associated with the Lasco family and family keepsakes.</data>
