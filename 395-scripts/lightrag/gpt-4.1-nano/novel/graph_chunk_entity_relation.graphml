    <node id="National Celebration">
      <data key="d0">National Celebration</data>
      <data key="d1">event</data>
      <data key="d2">A large-scale public event celebrated in a vast cathedral where disreputable characters are compared to the multitudinous acquirements among Tulpian's notions.</data>
      <data key="d3">chunk-b32192ddb2993846ee52feb248ad5d6f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608121</data>
