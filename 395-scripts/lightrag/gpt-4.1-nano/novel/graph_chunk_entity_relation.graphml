    <node id="Thoth">
      <data key="d0">Thoth</data>
      <data key="d1">person</data>
      <data key="d2">Thoth is an Egyptian deity, linked to wisdom, writing, astronomy, and invented letters; depicted as a baboon or with hieroglyphs.</data>
      <data key="d3">chunk-06e492003a084ec018b849a310a4e995</data>
      <data key="d4">unknown_source</data>
