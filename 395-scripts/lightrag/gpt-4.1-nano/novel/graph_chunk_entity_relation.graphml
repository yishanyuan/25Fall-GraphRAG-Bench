    <node id="Julia">
      <data key="d0">Julia</data>
      <data key="d1">person</data>
      <data key="d2">Julia is the wife of Merman, characterized by discernment and a desire to maintain harmony in her marriage.&lt;SEP&gt;Julia is the wife of Merman, responsible for managing household expenses and supporting her husband's intellectual pursuits amidst financial hardship.</data>
      <data key="d3">chunk-15731bb06f5468be78ed2b36a5ef8f2b&lt;SEP&gt;chunk-0caba7a3455a33871464a9439e236182</data>
