      <data key="d0">Sângita Râthnakara</data>
      <data key="d1">content</data>
      <data key="d2">The Sângita râthnakara is a Sanskrit treatise that describes ancient musical instruments and their methods.</data>
      <data key="d3">chunk-fb8822d3dfa29a3bb48da5205e0808c6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613898</data>
