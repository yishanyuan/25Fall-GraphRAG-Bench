    <node id="Old World">
      <data key="d0">Old World</data>
      <data key="d1">location</data>
      <data key="d2">Refers to the civilizations and cultures of Europe, Asia, and Africa, which are compared to American civilizations regarding their monuments and artifacts.&lt;SEP&gt;The Old World refers to the continents known to ancient civilizations, where similar words and names like Maya are found.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28&lt;SEP&gt;chunk-08ffcfc6ec928be11797840c2e48ac2a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="Learned Men">
      <data key="d0">Learned Men</data>
      <data key="d1">person</data>
      <data key="d2">Learned men are scholars or philologists who study linguistic and cultural coincidences across different nations.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="Learned Priests of Mayab">
      <data key="d0">Learned Priests of Mayab</data>
      <data key="d1">organization</data>
      <data key="d2">The learned priests of Mayab are the scholars and spiritual figures responsible for understanding and preserving Maya customs.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="Queen of Maya">
      <data key="d0">Queen of Maya</data>
      <data key="d1">person</data>
      <data key="d2">The Queen of Maya refers to the legendary or historical figure associated with the origin of the name Yucatan and its properties.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="Learned priests of Mayab">
      <data key="d0">Learned priests of Mayab</data>
      <data key="d1">organization</data>
      <data key="d2">The learned priests of Mayab are scholars and spiritual leaders responsible for studying and preserving Maya traditions and language.</data>
      <data key="d3">chunk-a65e48b610f2a391366b1dc455dacc28</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="AAK">
      <data key="d0">AAK</data>
      <data key="d1">creature</data>
      <data key="d2">A turtle that became the governor of Uxmal, a figure associated with ancient Maya iconography.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="Zuhuy-Kuk">
      <data key="d0">Zuhuy-Kuk</data>
      <data key="d1">person</data>
      <data key="d2">A priestess who became the goddess of maidens, known by the name Zuhuy-Kuk in Maya mythology.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="MAYAB">
      <data key="d0">MAYAB</data>
      <data key="d1">location</data>
      <data key="d2">Historical reference to the region of Yucatan where Maya inscriptions and language are studied.&lt;SEP&gt;MAYAB is a name that appears to be a corruption or variation related to Maya, possibly a city name.&lt;SEP&gt;MAYAB is a historical locality historically associated with ancient civilizations and religious significance, often considered as the Mother of the Gods in myth.&lt;SEP&gt;MAYAB is a country whose name derives from its porous soil, associated with the ancient Maya people and civilization.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456&lt;SEP&gt;chunk-b8a987c9c6b375c5a920c9be05f99a27&lt;SEP&gt;chunk-964858730c8a8dc2179e59d3cb07c3cc&lt;SEP&gt;chunk-f83c27282913cff5172f6cf0dfa303eb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606677</data>
      <data key="d6" />
    </node>
    <node id="King Uruck">
      <data key="d0">King Uruck</data>
      <data key="d1">person</data>
      <data key="d2">A historical figure associated with the time of ancient Chaldean civilization, mentioned in relation to hieratic writing.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Egyptian">
      <data key="d0">Egyptian</data>
      <data key="d1">location</data>
      <data key="d2">Refers to the writing system and characters used by ancient Egypt, which share similarities with Maya symbols.&lt;SEP&gt;The Egyptians are an ancient civilization known for their monuments, customs, and religious beliefs, with an antiquity dating back to around 2500 B.C.&lt;SEP&gt;Egyptian pertains to ancient Egypt and its traditional musical instruments.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456&lt;SEP&gt;chunk-f83c27282913cff5172f6cf0dfa303eb&lt;SEP&gt;chunk-90130c63183d6c112f655e298f1be97a&lt;SEP&gt;chunk-662dfab4657790a73298dc9f0446a502</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613926</data>
      <data key="d6" />
    </node>
    <node id="Chaldean">
      <data key="d0">Chaldean</data>
      <data key="d1">organization</data>
      <data key="d2">Ancient civilization whose hieratic script influences or resembles Maya inscriptions.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Hieroglyphs">
      <data key="d0">Egyptian Hieroglyphs</data>
      <data key="d1">content</data>
      <data key="d2">The hieroglyphic characters from Egypt, some of which are found in Maya inscriptions.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Etruscan">
      <data key="d0">Etruscan</data>
      <data key="d1">location</data>
      <data key="d2">Ancient civilization whose alphabet-like characters appear in Maya inscriptions.&lt;SEP&gt;Ancient civilization with artifacts such as bronze vessels and bells, including discovered instruments in tombs.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456&lt;SEP&gt;chunk-4839098cd46c452a68e1941bee57dab0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613889</data>
      <data key="d6" />
    </node>
    <node id="Sign">
      <data key="d0">Sign</data>
      <data key="d1">content</data>
      <data key="d2">An element used in Maya inscriptions that may have been derived from Egyptian, Chaldean, or Etruscan scripts.&lt;SEP&gt;The sign reads "'Girls May Not be Drowned in This Pond,'" an ominous notice hinting at hidden dangers or cultural secrets.&lt;SEP&gt;The sign "Foreign Earth" on a placard in the den.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456&lt;SEP&gt;chunk-202e89533c336da3f2eea8f8ae060d95&lt;SEP&gt;chunk-d338a477bdce675ba495c45901f2f4f1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764611196</data>
      <data key="d6" />
    </node>
    <node id="Names of the founders of Uxmal">
      <data key="d0">Names of the founders of Uxmal</data>
      <data key="d1">content</data>
      <data key="d2">Names inscribed in Maya script, containing both alphabetic and ideographic components, including totems.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Turtle">
      <data key="d0">Turtle</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A totem representing the founder AAK, depicted as an image of a turtle.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Fish">
      <data key="d0">Fish</data>
      <data key="d1">creature</data>
      <data key="d2">A totem representing the founder CAY, depicted as an image of a fish.&lt;SEP&gt;Small fishes of the mullet and perch kinds inhabit the mineral springs, with a delicate flavor and easy digestion, living alongside snakes.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456&lt;SEP&gt;chunk-712990bb2ebe5d62b532d770bfe4b95c&lt;SEP&gt;chunk-8afc94ee00703bc5476d62e021e1994c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614598</data>
      <data key="d6" />
    </node>
    <node id="Leopard">
      <data key="d0">Leopard</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A totem representing the figure Chaacmol, depicted as an image of a leopard.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Nahualt">
      <data key="d0">Nahualt</data>
      <data key="d1">concept</data>
      <data key="d2">The Nahualt is an ancient Mesoamerican language and script used by the Aztecs, also referenced in relation to Maya inscriptions and historical texts.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Toltec">
      <data key="d0">Toltec</data>
      <data key="d1">organization</data>
      <data key="d2">An ancient civilization from central Mexico, associated with the destruction of Maya inscriptions and influence on Mesoamerican culture.</data>
      <data key="d3">chunk-fa4a04bbf52d96486efcb2e364d70456</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Amenti">
      <data key="d0">Amenti</data>
      <data key="d1">location</data>
      <data key="d2">The Amenti is an underworld realm where Osiris rules and souls are judged before their reincarnation.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Souls">
      <data key="d0">Souls</data>
      <data key="d1">creature</data>
      <data key="d2">Souls are the spirits of deceased individuals judged by Osiris, who are destined to return to earth after a period.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Statues">
      <data key="d0">Statues</data>
      <data key="d1">artifact</data>
      <data key="d2">Statues made of stone, terra-cotta, or wood are created by the Mayas to resemble the deceased, containing their ashes in a hollow.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Spirit">
      <data key="d0">Spirit</data>
      <data key="d1">concept</data>
      <data key="d2">The spirit is the essence of a person that, after suffering and bliss during life, is destined to reincarnate on earth.&lt;SEP&gt;A quality that pervaded the home, characterized by unselfishness, charity, and a soothing influence.&lt;SEP&gt;Spirit denotes the collective soul or vital force of a nation, expressed through traditions, heroic deeds, and cultural consciousness.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e&lt;SEP&gt;chunk-b8a987c9c6b375c5a920c9be05f99a27&lt;SEP&gt;chunk-cb6a025623f47200c8c812a059793950&lt;SEP&gt;chunk-8442dd0527e82eb09ee5eeff266010ae&lt;SEP&gt;chunk-4d6d693b5da179ac238c1380743ccaf6&lt;SEP&gt;chunk-0a98afa31aca72fe4aab8a13ac827087</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608160</data>
      <data key="d6" />
    </node>
    <node id="Reincarnation">
      <data key="d0">Reincarnation</data>
      <data key="d1">concept</data>
      <data key="d2">The belief that the spirit of Chaacmol is reborn in statues, symbolizing the cycle of life and death.&lt;SEP&gt;Reincarnation is a belief held by the Mayas and others, involving the soul's return to material life after death.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e&lt;SEP&gt;chunk-f5b2f7d138338b628491cb8bacb7fe79</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606678</data>
      <data key="d6" />
    </node>
    <node id="Indians">
      <data key="d0">Indians</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Indians in Yucatan are native inhabitants, predominantly of mixed blood, involved in traditional cultivation and local economy.&lt;SEP&gt;Indians refer to the indigenous people who believe in reincarnation and exhibit reverence toward their ancestors and beliefs.&lt;SEP&gt;Indigenous people involved in massacres and later surrendered at Camp Release.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e&lt;SEP&gt;chunk-3cf3140092a745267effea6e9a53aa65&lt;SEP&gt;chunk-7096033ca5d17f317a3de07c28f9b0bc&lt;SEP&gt;chunk-f2440d11a9db0e7c5ec428e134dc47e0&lt;SEP&gt;chunk-54b8fd90d2cdfb38f2203aba48e470d7&lt;SEP&gt;chunk-8cff61acedefa321376fd295cf6cd5c5&lt;SEP&gt;chunk-a423779aeb8c30b26de6eff15931f31c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610030</data>
      <data key="d6" />
    </node>
    <node id="Fanatical Friars">
      <data key="d0">Fanatical Friars</data>
      <data key="d1">organization</data>
      <data key="d2">Fanatical friars are depicted as religious figures who persecuted indigenous beliefs, especially superstitions related to reincarnation.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Great Pyramid">
      <data key="d0">Great Pyramid</data>
      <data key="d1">artifact</data>
      <data key="d2">The Great Pyramid is a monumental structure associated with ancient beliefs, where statues and relics are kept and revered.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Uxan">
      <data key="d0">Uxan</data>
      <data key="d1">person</data>
      <data key="d2">Uxan is a figure depicted on a carved stone, identified by the natives as a great man and warrior, linked to past reincarnations.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Great Lord Chaacmol">
      <data key="d0">Great Lord Chaacmol</data>
      <data key="d1">person</data>
      <data key="d2">Great Lord Chaacmol is a revered historical figure, associated with the ancient Maya civilization and the context of reincarnation.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Ufax">
      <data key="d0">Ufax</data>
      <data key="d1">person</data>
      <data key="d2">Ufax is an ancient warrior or noble whose portrait is sculpted in the Great Pyramid and believed by natives to be a past incarnation of a revered figure.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Canopas">
      <data key="d0">Canopas</data>
      <data key="d1">artifact</data>
      <data key="d2">Canopas are funeral vases used by Egyptians to enclose the brains, entrails, and viscera of the deceased.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Mrs. Le Plongeon">
      <data key="d0">Mrs. Le Plongeon</data>
      <data key="d1">person</data>
      <data key="d2">An author and researcher who provided descriptions of Mayan monuments, contributing to the understanding of Central American archaeology.&lt;SEP&gt;Mrs. Le Plongeon assisted with sheltering the statue during the abandonment.&lt;SEP&gt;Mrs. Le Plongeon is a person known for preserving metallic pigments found in Chaacmol's mausoleum.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e&lt;SEP&gt;chunk-08ffcfc6ec928be11797840c2e48ac2a&lt;SEP&gt;chunk-f5b2f7d138338b628491cb8bacb7fe79</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Nicte">
      <data key="d0">Nicte</data>
      <data key="d1">person</data>
      <data key="d2">Nicte is the sister of Chaacmol, associated with temple ceremonies and inscriptions.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Zuhuy-Kak">
      <data key="d0">Zuhuy-Kak</data>
      <data key="d1">person</data>
      <data key="d2">Zuhuy-Kak is a goddess of maidens, believed to have been a priestess who obtained apotheosis after death.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Kings">
      <data key="d0">Egyptian Kings</data>
      <data key="d1">person</data>
      <data key="d2">Egyptian kings are rulers whose tombs were decorated with sculptures, paintings, and symbols.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Fishes">
      <data key="d0">Fishes</data>
      <data key="d1">other</data>
      <data key="d2">Fishes are abundant in Yucatan's waters, providing food for waterfowl and maintaining ecological balance.&lt;SEP&gt;Fishes are among the animals worshiped by the lower classes in Maya culture.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e&lt;SEP&gt;chunk-a838c08843884c0f3a0816d2b39bddaf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Snakes">
      <data key="d0">Snakes</data>
      <data key="d1">creature</data>
      <data key="d2">Snakes are animals worshiped by the lower classes in Maya culture.&lt;SEP&gt;Snakes are natural objects present in the streams and associated with the environment described.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e&lt;SEP&gt;chunk-57f75296e95e08ee42b21dc84299286f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614579</data>
      <data key="d6" />
    </node>
    <node id="Tigers">
      <data key="d0">Tigers</data>
      <data key="d1">other</data>
      <data key="d2">Tigers are among the animals worshiped by the lower classes in Maya culture.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e&lt;SEP&gt;chunk-6b549627ac943f03650e7d7278845faf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Tombs">
      <data key="d0">Egyptian Tombs</data>
      <data key="d1">location</data>
      <data key="d2">Egyptian tombs are structures that often contain sculptures, paintings, and funerary objects reflecting social status.</data>
      <data key="d3">chunk-b991502e22e90fb761c5591cdca0b88e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606679</data>
      <data key="d6" />
    </node>
    <node id="Mural Paintings">
      <data key="d0">Mural Paintings</data>
      <data key="d1">content</data>
      <data key="d2">Mural paintings in the funeral chamber depict scenes of burial rituals, including the funeral of Chaacmol.&lt;SEP&gt;Mural paintings provide evidence of feathered vestments and emblem representations associated with Maya officials.&lt;SEP&gt;Mural paintings at Chichen show the use of traditional costumes by the ancient Maya and contemporary inhabitants.&lt;SEP&gt;The mural paintings at Chichen-Itza depict the same dress described for the higher classes and contain inscriptions related to ancient cultures.&lt;SEP&gt;Mural paintings depict scenes of the deceased’s life, customs, dress, and communication with other nations.&lt;SEP&gt;Depictions revealing Maya practices of astrology and divination.</data>
