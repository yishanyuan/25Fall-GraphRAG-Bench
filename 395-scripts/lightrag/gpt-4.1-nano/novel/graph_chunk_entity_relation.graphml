    <node id="Aurora">
      <data key="d0">Aurora</data>
      <data key="d1">person</data>
      <data key="d2">Aurora is the personification of dawn, personified as bringing the day and associated with the passage of time.&lt;SEP&gt;Aurora is a mythological goddess associated with dawn, characterized by saffron locks, symbolizing beauty and morning light.&lt;SEP&gt;Aurora is a goddess representing dawn, associated with Tithonus in myth.</data>
      <data key="d3">chunk-b6cab761408cb58a952d84a4e27dce81&lt;SEP&gt;chunk-9ff2030ce7e35257099d54aca8256ea4&lt;SEP&gt;chunk-91ae32cc554dc390c60bd5c873778659</data>
      <data key="d4">unknown_source</data>
