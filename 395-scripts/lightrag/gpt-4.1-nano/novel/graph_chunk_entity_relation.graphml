    </node>
    <node id="Ceraunia">
      <data key="d0">Ceraunia</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Ceraunia is a rocky range projected from the sea, associated with dangerous navigation.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610596</data>
      <data key="d6" />
    </node>
    <node id="Syrtes">
      <data key="d0">Syrtes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Syrtes are straits or dangerous channels in the sea, known for hazards.&lt;SEP&gt;The Syrtes, or quicksands, are dangerous shifting sands along the Libyan coast, near Malea.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d&lt;SEP&gt;chunk-b0c76d7dabe39a2ef5714186a6126fc0</data>
