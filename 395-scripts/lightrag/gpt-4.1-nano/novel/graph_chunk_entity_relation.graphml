    <node id="Ghuer">
      <data key="d0">Ghuer</data>
      <data key="d1">location</data>
      <data key="d2">Gheu, also called War, is a fortress located in the Moroccan mountains, known for its inaccessibility and as the residence of the supreme Amrgar.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
