    <node id="Circus Maximus">
      <data key="d0">Circus Maximus</data>
      <data key="d1">location</data>
      <data key="d2">The Circus Maximus was a large Roman chariot-racing stadium where the Circensian games took place.&lt;SEP&gt;The Circus Maximus was a major ancient Roman chariot-racing stadium that hosted the grand games and was later rebuilt by Trajan with increased capacity.</data>
      <data key="d3">chunk-eb4eb8f1e4cf05e01dcfb95969a6bb79&lt;SEP&gt;chunk-adc0c02df8cb82b091fb73a066662a32</data>
