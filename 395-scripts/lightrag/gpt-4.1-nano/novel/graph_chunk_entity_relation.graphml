    <node id="Ivanhoe">
      <data key="d0">Ivanhoe</data>
      <data key="d1">other</data>
      <data key="d2">Ivanhoe is a mining operation located in the Black Range of the Mimbres Mountains, previously associated with Colonel Gillette, Robert Ingersoll, and Senator Plumb.</data>
