      <data key="d0">Sidi Hamed-ou-Mousa</data>
      <data key="d1">location</data>
      <data key="d2">Sidi Hamed-ou-Mousa is a sanctified site in Ilirgh, heavily visited by Mahometans.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614545</data>
      <data key="d6" />
    </node>
    <node id="Mahometans">
      <data key="d0">Mahometans</data>
      <data key="d1">person</data>
      <data key="d2">Mahometans (Muslims) are referenced in relation to the enmity shared with the Jews of the Atlas.&lt;SEP&gt;Mahometans are the Muslim inhabitants of the region, dependent on the Jewish population for trade.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-d4996254e95ccc6b78afba2bb6b96949</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614546</data>
      <data key="d6" />
    </node>
    <node id="Shtouka">
      <data key="d0">Shtouka</data>
      <data key="d1">location</data>
      <data key="d2">Shtouka is a district or large town, with many settlements, often called by the name of the principal town or village.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614546</data>
      <data key="d6" />
    </node>
    <node id="Shelouhs">
      <data key="d0">Shelouhs</data>
      <data key="d1">other</data>
      <data key="d2">Shelouhs are the indigenous inhabitants of the district, nearly independent of Morocco.&lt;SEP&gt;Shelouhs are an industrious Arab and Berber group residing in the district of Sous-el-Aksa.&lt;SEP&gt;Shelouhs are an ethnic group inhabiting Fronga and surrounding regions in Morocco.</data>
      <data key="d3">chunk-4115555de86c1bb7160cf84f291006f2&lt;SEP&gt;chunk-67512ea13edfd2cab9973f3ae5f8c75d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614546</data>
      <data key="d6" />
    </node>
