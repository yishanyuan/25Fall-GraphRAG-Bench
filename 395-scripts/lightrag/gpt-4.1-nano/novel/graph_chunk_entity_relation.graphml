    <node id="Light">
      <data key="d0">Light</data>
      <data key="d1">content</data>
      <data key="d2">Light symbolizes understanding, knowledge, and the unveiling of truth in the universe.&lt;SEP&gt;Light is the natural illumination allowing visibility and modesty.</data>
      <data key="d3">chunk-a93cf4b36f5828cc09fb907dbf61daf5&lt;SEP&gt;chunk-7a88a2ba3aaa4f2f07b382ccde92f86d&lt;SEP&gt;chunk-d18197681a28270c1f146277731c3f51</data>
