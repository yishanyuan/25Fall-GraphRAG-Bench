    <node id="Taza">
      <data key="d0">Taza</data>
      <data key="d1">location</data>
      <data key="d2">Taza is the capital of the district of Haiaina, located in a romantic setting on a rock shaped like an island, surrounded by a river, and near the mountains of Zibel Medghara.</data>
