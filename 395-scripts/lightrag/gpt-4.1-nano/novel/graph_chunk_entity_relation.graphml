    </node>
    <node id="Zephyrs">
      <data key="d0">Zephyrs</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Zephyrs are gentle west winds that influence sea travel, and are feared by those voyaging.</data>
      <data key="d3">chunk-432add00f9047dd14d52a61f532cf54d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610595</data>
