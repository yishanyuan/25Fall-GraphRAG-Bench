      <data key="d13" />
    </edge>
    <edge source="Old-fashioned Soap Making" target="Impure Potash">
      <data key="d7">1.0</data>
      <data key="d8">Old-fashioned method used boiling with wood ashes or impure potash, resulting in unneutralized soap.</data>
      <data key="d9">ingredients,process</data>
