    </node>
    <node id="Emil Munch">
      <data key="d0">Emil Munch</data>
      <data key="d1">person</data>
      <data key="d2">Emil Munch was the first captain of the First Minnesota battery.&lt;SEP&gt;Emil Munch was the first captain of the First Minnesota battery, who was wounded during the battle.</data>
      <data key="d3">chunk-35fcfac76ba65831deb07fd3f5b55dac&lt;SEP&gt;chunk-ad0c0360f449394f658f3f74f407457c</data>
