    </node>
    <node id="Reynard">
      <data key="d0">Reynard</data>
      <data key="d1">person</data>
      <data key="d2">Reynard is a character representing the Fox, who reports on the honey origin.</data>
      <data key="d3">chunk-ab5a2da379766b69f7bf3153cb0f2c47</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764608171</data>
