    <node id="Gregarina">
      <data key="d0">Gregarina</data>
      <data key="d1">creature</data>
      <data key="d2">Gregarina is a creature that had cholera and is contrasted with Vorticella in terms of character and behavior.&lt;SEP&gt;Gregarina is a creature mentioned as having had cholera, symbolizing a comparison to Vorticella's behavior.</data>
      <data key="d3">chunk-3b0a545773b8336ab8625e557443eba8</data>
      <data key="d4">unknown_source</data>
