    <node id="Assyrian Harp">
      <data key="d0">Assyrian Harp</data>
      <data key="d1">content</data>
      <data key="d2">The Assyrian harp was about four feet high, likely lightweight, with sound-holes, tuning-pegs, and strings possibly made of silk or catgut, used in musical performances.</data>
      <data key="d3">chunk-aef18eb73774c5f975cff80e5f2ce51f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764613942</data>
