    <node id="Unitarian Church">
      <data key="d0">Unitarian Church</data>
      <data key="d1">organization</data>
      <data key="d2">The Unitarian Church is a religious tradition emphasized as an alternative to traditional religious views, associated with her spiritual preferences.</data>
      <data key="d3">chunk-a93cf4b36f5828cc09fb907dbf61daf5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764607631</data>
