      <data key="d0">Human Head</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A human head with half-closed eyes, found in relation to the tiger statue, fitting exactly onto the tiger's neck.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764606713</data>
      <data key="d6" />
    </node>
    <node id="Bas-Relief">
      <data key="d0">Bas-Relief</data>
      <data key="d1">artifact</data>
      <data key="d2">A bas-relief of a dying warrior with a backward-throwing head, depicted with flames escaping from his mouth, indicating his spirit leaving the body.&lt;SEP&gt;Bas-reliefs are sculptural surfaces depicting processions with musical instruments, including the dulcimer, which have been damaged but repaired.</data>
      <data key="d3">chunk-6b549627ac943f03650e7d7278845faf&lt;SEP&gt;chunk-210eaafae8dea701b360369916174fd0</data>
      <data key="d4">unknown_source</data>
