      <data key="d0">Hamda</data>
      <data key="d1">person</data>
      <data key="d2">Hamda is a person present at the gathering alongside Si Smyle and others.</data>
      <data key="d3">chunk-232907dd57f71debadc62dcfe71c8543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614600</data>
      <data key="d6" />
    </node>
    <node id="Jabeah">
      <data key="d0">Jabeah</data>
      <data key="d1">location</data>
      <data key="d2">The Jabeah is a well regarded as a curiosity and part of the pilgrimage sites in Muslim cities, with water considered sacred.</data>
      <data key="d3">chunk-232907dd57f71debadc62dcfe71c8543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764614600</data>
      <data key="d6" />
    </node>
