    </node>
    <node id="Springfield Muskets">
      <data key="d0">Springfield Muskets</data>
      <data key="d1">artifact</data>
      <data key="d2">Springfield muskets are old firearms stored in the office used for defense during the war.</data>
      <data key="d3">chunk-d407b1da09abcacef35abc3b6c280f0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610018</data>
