    <node id="Kratzenstein">
      <data key="d0">Kratzenstein</data>
      <data key="d1">person</data>
      <data key="d2">Katzenstein was an organ builder in St. Petersburg who was inspired by the Chinese _cheng_ to incorporate the _free reed_ into organ stops.</data>
