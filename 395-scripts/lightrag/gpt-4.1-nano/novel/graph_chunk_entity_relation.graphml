    <node id="Catgut">
      <data key="d0">Catgut</data>
      <data key="d1">artifact</data>
      <data key="d2">Catgut is a type of material made from the intestines of animals like sheep, goats, lambs, or camels, traditionally used for musical strings and sutures.</data>
      <data key="d3">chunk-c8493bf9cd90b8f6b1a63947e3d6ecb2</data>
      <data key="d4">unknown_source</data>
