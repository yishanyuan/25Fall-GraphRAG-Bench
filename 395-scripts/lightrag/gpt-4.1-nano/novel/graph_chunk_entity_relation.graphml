    <node id="James Mills">
      <data key="d0">James Mills</data>
      <data key="d1">person</data>
      <data key="d2">James Mills was a young man who came to Minnesota early, worked at Pioneer office, then became editor-in-chief of the Pittsburgh Post after the war.</data>
      <data key="d3">chunk-05ddaddeaf94d2bcd3da95a9c4f85c42</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764610007</data>
