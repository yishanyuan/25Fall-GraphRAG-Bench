      <data key="d0">CIS</data>
      <data key="d1">organization</data>
      <data key="d2">The Cancer Information Service (CIS) offers assistance in locating clinical trials and information about cancer.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab</data>
