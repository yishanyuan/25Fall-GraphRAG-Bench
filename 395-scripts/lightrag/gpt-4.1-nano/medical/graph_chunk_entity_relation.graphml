      <data key="d13" />
    </edge>
    <edge source="Bladder Cancer" target="Treatment Team">
      <data key="d7">1.0</data>
      <data key="d8">The care team works together to plan and administer personalized treatment for bladder cancer patients.</data>
      <data key="d9">collaboration,healthcare</data>
      <data key="d10">chunk-68217ea9e5382d1756c99b5152ea98db</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764560819</data>
      <data key="d13" />
    </edge>
    <edge source="Bladder Cancer" target="Blood in Urine">
      <data key="d7">1.0</data>
      <data key="d8">Blood in urine is the most common clinical sign indicating possible bladder cancer.</data>
