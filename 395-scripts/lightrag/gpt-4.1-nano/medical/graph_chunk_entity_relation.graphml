      <data key="d0">Cancer Treatment Options</data>
      <data key="d1">concept</data>
      <data key="d2">Various medical interventions aimed at curing or controlling cancer, considering factors such as subtype, age, and risk factors.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560613</data>
