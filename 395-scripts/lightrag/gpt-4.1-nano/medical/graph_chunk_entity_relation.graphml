      <data key="d0">AJCC (American Joint Committee on Cancer)</data>
      <data key="d1">organization</data>
      <data key="d2">The AJCC is responsible for developing the staging system used to determine cancer extent and prognosis.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
      <data key="d6" />
