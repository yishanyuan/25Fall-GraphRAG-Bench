    <node id="Online Patient Portal">
      <data key="d0">Online Patient Portal</data>
      <data key="d1">content</data>
      <data key="d2">A digital system where patients can view reports and medical information related to their diagnosis and treatment.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560528</data>
      <data key="d6" />
