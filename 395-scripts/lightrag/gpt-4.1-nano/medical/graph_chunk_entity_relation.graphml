    </edge>
    <edge source="Blood Stem Cells" target="CML">
      <data key="d7">1.0</data>
      <data key="d8">CML arises from blood stem cells that acquire abnormal genetic features, leading to cancer.</data>
      <data key="d9">disease initiation,origin</data>
      <data key="d10">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
      <data key="d11">unknown_source</data>
