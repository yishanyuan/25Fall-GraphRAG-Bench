    <node id="Chemicals (radon, asbestos)">
      <data key="d0">Chemicals (radon, asbestos)</data>
      <data key="d1">concept</data>
      <data key="d2">Exposure to carcinogenic chemicals like radon and asbestos increases the risk of SCLC.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
