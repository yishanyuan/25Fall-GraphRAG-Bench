    <node id="Hereditary Cancer">
      <data key="d0">Hereditary Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Hereditary cancer is a type of cancer transmitted through genetic mutations passed from family members, often involving specific genetic pathways.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
      <data key="d6" />
