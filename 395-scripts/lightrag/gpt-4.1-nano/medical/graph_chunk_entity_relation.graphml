    <node id="Treatment Approaches">
      <data key="d0">Treatment Approaches</data>
      <data key="d1">concept</data>
      <data key="d2">Includes immunotherapy, endocrine therapy, mastectomy, radiation, chemotherapy, targeted therapy, supportive care, and clinical trials.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
