    <node id="Muscle-invasive Bladder Cancer">
      <data key="d0">Muscle-invasive Bladder Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Bladder cancer that has spread through the urothelium into the bladder muscle.</data>
