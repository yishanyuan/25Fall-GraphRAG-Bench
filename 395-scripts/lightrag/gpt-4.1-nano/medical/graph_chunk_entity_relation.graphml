    <node id="Clinical Social Workers">
      <data key="d0">Clinical Social Workers</data>
      <data key="d1">person</data>
      <data key="d2">Clinical social workers diagnose and treat mental, behavioral, and emotional issues, and may help manage anxiety related to medical diagnoses such as cancer.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
