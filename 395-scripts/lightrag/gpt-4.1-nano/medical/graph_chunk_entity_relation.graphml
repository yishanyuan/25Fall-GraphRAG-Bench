    <node id="Incisional Biopsy">
      <data key="d0">Incisional Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">Removes a small tissue sample through a skin incision, less common when other methods are available.&lt;SEP&gt;A procedure where only part of a lymph node is removed for testing.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560526</data>
      <data key="d6" />
    </node>
    <node id="Needle Biopsy">
      <data key="d0">Needle Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A minimally invasive procedure that uses a needle to extract a small sample of lymph node tissue.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
