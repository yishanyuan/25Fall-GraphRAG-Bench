    </edge>
    <edge source="Bladder Cancer" target="Smoking">
      <data key="d7">1.0</data>
      <data key="d8">Smoking significantly increases the likelihood of developing bladder cancer, especially in combination with genetic risk factors.</data>
      <data key="d9">risk_factor</data>
