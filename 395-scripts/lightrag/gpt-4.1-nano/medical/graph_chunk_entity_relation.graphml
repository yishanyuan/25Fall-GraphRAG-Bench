    <node id="Social Workers">
      <data key="d0">Social Workers</data>
      <data key="d1">person</data>
      <data key="d2">Social workers assist individuals in solving and coping with problems in their daily lives, including mental, behavioral, and emotional issues.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
