    <node id="Esophageal cancer">
      <data key="d0">Esophageal cancer</data>
      <data key="d1">content</data>
      <data key="d2">Esophageal cancer originates from abnormal cell growth in the esophagus lining, part of the digestive system.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
