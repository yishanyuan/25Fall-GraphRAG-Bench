    <node id="Carcinogens">
      <data key="d0">Carcinogens</data>
      <data key="d1">concept</data>
      <data key="d2">Carcinogens such as radon and asbestos are substances that increase the risk of developing SCLC.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
