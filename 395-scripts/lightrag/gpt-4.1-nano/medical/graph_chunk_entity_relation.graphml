      <data key="d0">Life Expectancy</data>
      <data key="d1">data</data>
      <data key="d2">Life expectancy helps inform treatment options and prognosis for prostate cancer patients.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560671</data>
      <data key="d6" />
    </node>
    <node id="Nomograms">
      <data key="d0">Nomograms</data>
      <data key="d1">method</data>
      <data key="d2">Nomograms are tools used to predict prostate cancer outcomes based on multiple patient variables.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
      <data key="d4">unknown_source</data>
