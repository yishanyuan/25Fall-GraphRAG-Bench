    <node id="Transurethral Resection of Bladder Tumor">
      <data key="d0">Transurethral Resection of Bladder Tumor</data>
      <data key="d1">method</data>
      <data key="d2">Transurethral resection of bladder tumor (TURBT) is a procedure used to examine and remove bladder tumors.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
      <data key="d4">unknown_source</data>
