    <node id="Age over 70">
      <data key="d0">Age over 70</data>
      <data key="d1">concept</data>
      <data key="d2">Being over 70 years old is a risk factor for developing SCLC.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560553</data>
      <data key="d6" />
