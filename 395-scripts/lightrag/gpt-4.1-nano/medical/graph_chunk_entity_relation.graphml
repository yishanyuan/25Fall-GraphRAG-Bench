    </node>
    <node id="Chapter 10">
      <data key="d0">Chapter 10</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 10 provides resources about patient advocacy groups and assistance options.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560749</data>
