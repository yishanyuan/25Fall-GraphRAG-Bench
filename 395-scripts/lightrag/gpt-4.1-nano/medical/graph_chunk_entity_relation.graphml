38845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560475</data>
      <data key="d6" />
    </node>
    <node id="Non-Alcoholic Fatty Liver Disease">
      <data key="d0">Non-Alcoholic Fatty Liver Disease</data>
      <data key="d1">concept</data>
      <data key="d2">NAFLD is a condition linked to high weight, diabetes, and high cholesterol, and can lead to cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560475</data>
      <data key="d6" />
    </node>
    <node id="Genetic Hemochromatosis">
      <data key="d0">Genetic Hemochromatosis</data>
      <data key="d1">concept</data>
      <data key="d2">An inherited disorder that causes excessive iron storage in the liver, increasing cancer risk.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Stage 4 Primary Biliary Cholangitis">
      <data key="d0">Stage 4 Primary Biliary Cholangitis</data>
      <data key="d1">concept</data>
      <data key="d2">A chronic autoimmune liver disease associated with cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Alpha-1-Antitrypsin Deficiency">
      <data key="d0">Alpha-1-Antitrypsin Deficiency</data>
      <data key="d1">concept</data>
      <data key="d2">A genetic disorder that may cause liver damage and increase cancer risk.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis">
      <data key="d0">Hepatitis</data>
      <data key="d1">concept</data>
      <data key="d2">Hepatitis is liver inflammation caused by viruses such as hepatitis B and C, which can lead to cirrhosis and increase cancer risk.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Alpha-Fetoprotein">
      <data key="d0">Alpha-Fetoprotein</data>
      <data key="d1">content</data>
      <data key="d2">AFP is a protein measured in blood tests; elevated levels may indicate liver cancer.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Liver Cancer Screening">
      <data key="d0">Liver Cancer Screening</data>
      <data key="d1">method</data>
      <data key="d2">Liver cancer screening involves ultrasound and AFP tests every 6 months for at-risk individuals.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Distant Metastasis">
      <data key="d0">Distant Metastasis</data>
      <data key="d1">concept</data>
      <data key="d2">Distant metastasis (M) assesses if cancer has spread to other organs like lungs or liver.&lt;SEP&gt;Distant metastasis occurs when kidney cancer spreads to far sites like lungs, bones, or liver.&lt;SEP&gt;Distant metastasis occurs when cancer spreads far from the primary site to bones, lungs, liver, brain, or distant lymph nodes.&lt;SEP&gt;Distant metastasis refers to the spread of cancer to organs far from the primary tumor, such as bones, lungs, liver, and brain.&lt;SEP&gt;Spread of cancer to distant organs such as lungs or liver, indicating advanced stage.&lt;SEP&gt;Distant metastasis refers to the spread of cancer cells to organs or tissues far from the primary tumor site, indicating advanced disease.&lt;SEP&gt;Distant metastasis describes liver cancer spreading to sites far from the primary tumor, typically the lung or bone.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis B">
      <data key="d0">Hepatitis B</data>
      <data key="d1">concept</data>
      <data key="d2">Hepatitis B is a liver disease caused by a virus, which may become reactivated during certain cancer treatments, potentially harming the liver.&lt;SEP&gt;Hepatitis B is a viral infection that may interfere with cancer immunotherapy if previously infected or at risk.&lt;SEP&gt;Hepatitis B is a virus causing liver infection, potential chronic liver disease, and increased risk for liver cancer.&lt;SEP&gt;A viral infection test that might be relevant before certain cancer treatments.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560476</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis C">
      <data key="d0">Hepatitis C</data>
      <data key="d1">content</data>
      <data key="d2">Hepatitis C is a liver disease caused by a virus, with risks of reactivation during cancer treatment and potential liver damage.&lt;SEP&gt;Hepatitis C is a virus that causes liver infection, chronic disease, cirrhosis, and increases the risk for liver cancer.&lt;SEP&gt;A viral infection test that could impact treatment options for blood cancers.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560477</data>
      <data key="d6" />
    </node>
    <node id="NCCN Patient Guides for Cancer">
      <data key="d0">NCCN Patient Guides for Cancer</data>
      <data key="d1">content</data>
      <data key="d2">The NCCN Patient Guides for Cancer are comprehensive educational resources designed to provide patients with essential information on various cancer types, risk groups, assessments, and treatment strategies. These guides include detailed information on different skin cancers such as squamous cell carcinoma and melanoma, as well as lung cancers, including non-small cell lung cancer (NSCLC), and head and neck cancers. The materials aim to help patients understand their diagnoses, potential treatment options, and assessment procedures.

In addition to printed or web-based guides, the NCCN Patient Guides for Cancer are accessible through a dedicated mobile application, offering convenient access to cancer-related information and guidance. The app provides educational content on cancer types, screening procedures, and management strategies, thereby supporting patients in navigating their cancer journey. The resources are tailored to various risk groups and provide assessments and treatment recommendations to help patients make informed decisions about their healthcare.

Overall, the NCCN Patient Guides for Cancer serve as a vital tool in patient education by offering clear, accessible information to empower individuals facing cancer diagnoses. They encompass guidelines, resources, and support for a broad range of cancers, emphasizing patient understanding, awareness, and engagement with their treatment plans.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560477</data>
      <data key="d6" />
    </node>
    <node id="FIGO">
      <data key="d0">FIGO</data>
      <data key="d1">organization</data>
      <data key="d2">The FIGO (International Federation of Gynecology and Obstetrics) stages provide a classification system for ovarian cancer.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 1A">
      <data key="d0">Stage 1A</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 1A indicates ovarian cancer confined to one ovary with an intact outer capsule and no cancer cells in ascites or washings.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 1B">
      <data key="d0">Stage 1B</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 1B indicates ovarian cancer in both ovaries, with capsules intact and no cancer in ascites or washings.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C">
      <data key="d0">Stage 1C</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 1C involves ovarian cancer in one or both ovaries with additional conditions such as capsule rupture or cancer cells in ascites or washings.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A">
      <data key="d0">Stage 2A</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 2A indicates ovarian cancer spread to the uterus and/or fallopian tubes with implants.&lt;SEP&gt;Stage 2A involves ovarian cancer spread to the uterus or fallopian tubes.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 2B">
      <data key="d0">Stage 2B</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 2B indicates spread of ovarian cancer to other pelvic organs or tissues such as the bladder, colon, or rectum.&lt;SEP&gt;Stage 2B involves ovarian cancer spread to other pelvic organs.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1">
      <data key="d0">Stage 3A1</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3A1 involves ovarian cancer spreading to retroperitoneal lymph nodes, with sub-stages based on size.&lt;SEP&gt;Stage 3A1 involves ovarian cancer spread to abdominal lymph nodes.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A2">
      <data key="d0">Stage 3A2</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3A2 involves ovarian cancer spreading to the tissue lining the abdomen, visible only microscopically, with possible lymph node involvement.&lt;SEP&gt;Stage 3A2 involves ovarian cancer spread to the abdomen tissue, visible microscopically.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560478</data>
      <data key="d6" />
    </node>
    <node id="Stage 3B">
      <data key="d0">Stage 3B</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3B involves visible cancer on the abdominal lining smaller than about 2 centimeters, possibly with lymph node involvement.&lt;SEP&gt;Stage 3B involves visible cancer on the abdominal lining smaller than 2 centimeters.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560479</data>
      <data key="d6" />
    </node>
    <node id="Stage 3C">
      <data key="d0">Stage 3C</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3C involves larger visible cancer on the abdominal lining (greater than 2 cm) and possible spread to outside surfaces or lymph nodes.&lt;SEP&gt;Stage 3C involves larger visible cancer (&gt;2 cm) on the abdominal lining, possibly with lymph node spread.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560479</data>
      <data key="d6" />
    </node>
    <node id="Stage 4">
      <data key="d0">Stage 4</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 4 NSCLC is metastatic, indicating cancer has spread to other organs or tissues.&lt;SEP&gt;Stage 4 indicates ovarian cancer has spread to other parts of the body, including the lungs, liver, spleen, or distant lymph nodes.&lt;SEP&gt;Stage 4 involves ovarian cancer spread to other parts of the body outside the abdomen.&lt;SEP&gt;Stage 4 pancreatic cancer has spread far and involves the liver, lungs, or lining of the abdomen.&lt;SEP&gt;Cancer has metastasized to areas outside the colon, commonly to the liver and lungs.&lt;SEP&gt;Stage 4 bladder cancer has grown beyond the bladder, potentially affecting distant organs and lymph nodes, with subgroups A and B indicating extent and spread.&lt;SEP&gt;Metastatic bladder cancer that has spread outside the bladder to distant sites.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
      <data key="d4">unknown_source</data>
