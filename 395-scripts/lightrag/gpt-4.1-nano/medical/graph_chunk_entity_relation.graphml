    </edge>
    <edge source="Airways" target="Bronchioli">
      <data key="d7">1.0</data>
      <data key="d8">Bronchioli are smaller airways branching from bronchi within the lungs.</data>
      <data key="d9">small passage</data>
      <data key="d10">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
      <data key="d11">unknown_source</data>
