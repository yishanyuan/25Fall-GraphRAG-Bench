      <data key="d1">method</data>
      <data key="d2">Magnetic resonance imaging is used for post-treatment assessment, particularly after fertility-sparing surgery.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560735</data>
      <data key="d6" />
    </node>
    <node id="Pap test">
      <data key="d0">Pap test</data>
      <data key="d1">method</data>
      <data key="d2">Pap testing is a cytology test used to detect abnormal or precancerous cells after treatment.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560735</data>
