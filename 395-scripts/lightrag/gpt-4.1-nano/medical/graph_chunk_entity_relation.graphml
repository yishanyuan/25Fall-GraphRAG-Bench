    </node>
    <node id="Pelvic Floor Exercises">
      <data key="d0">Pelvic Floor Exercises</data>
      <data key="d1">method</data>
      <data key="d2">Pelvic floor exercises are physical activities to help regain control of urine function and manage urinary incontinence.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
      <data key="d4">unknown_source</data>
