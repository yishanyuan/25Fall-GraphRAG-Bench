      <data key="d12">1764561045</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Smoking">
      <data key="d7">1.0</data>
      <data key="d8">Smoking and vaping elevate the risk of developing cancer, complicate treatment, and hinder recovery.</data>
      <data key="d9">risk</data>
      <data key="d10">chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
