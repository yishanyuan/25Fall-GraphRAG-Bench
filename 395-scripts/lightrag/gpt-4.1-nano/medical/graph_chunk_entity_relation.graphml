    <node id="Differential">
      <data key="d0">Differential</data>
      <data key="d1">test</data>
      <data key="d2">A component of CBC that counts and categorizes different types of white blood cells, including blasts or leukemia cells.&lt;SEP&gt;A component of CBC that analyzes percentages of different white blood cell types.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
