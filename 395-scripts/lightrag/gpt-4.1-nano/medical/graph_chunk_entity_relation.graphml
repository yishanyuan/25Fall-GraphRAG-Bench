      <data key="d1">event</data>
      <data key="d2">Long-term safety and benefits study of approved treatments.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
