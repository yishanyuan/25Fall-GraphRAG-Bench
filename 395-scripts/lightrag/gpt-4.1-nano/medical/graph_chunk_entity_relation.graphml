    <node id="Stage 1C1">
      <data key="d0">Stage 1C1</data>
      <data key="d1">location</data>
      <data key="d2">Stage 1C1 involves ovarian cancer with surgical spill due to capsule rupture during surgery.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
