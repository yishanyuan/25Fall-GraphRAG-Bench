    <edge source="Prostate" target="Metastatic Prostate Cancer">
      <data key="d7">2.0</data>
      <data key="d8">Cancer cells have spread from the prostate to other organs or tissues.&lt;SEP&gt;It involves cancer spreading beyond the prostate, often to lymph nodes, bones, liver, or lungs.</data>
      <data key="d9">disease progression,spread</data>
      <data key="d10">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
