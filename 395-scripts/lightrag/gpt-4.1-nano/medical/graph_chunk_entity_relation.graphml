    <node id="Ureteroscopy">
      <data key="d0">Ureteroscopy</data>
      <data key="d1">method</data>
      <data key="d2">An endoscopic examination that extends the cystoscopy to examine the upper urinary tract, such as the ureters and kidneys, often performed when abnormalities are suspected.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
