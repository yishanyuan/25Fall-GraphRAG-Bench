      <data key="d0">Internal Carotid Artery</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The internal carotid artery is a major blood vessel that can be encased by advanced tumors.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e</data>
      <data key="d4">unknown_source</data>
