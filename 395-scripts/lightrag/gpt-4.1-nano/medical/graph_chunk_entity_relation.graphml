      <data key="d0">Metastatic Anal Cancer</data>
      <data key="d1">other</data>
      <data key="d2">Stage of anal cancer where disease has spread beyond the pelvis, commonly to the liver or lungs, requiring systemic therapy.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560604</data>
      <data key="d6" />
    </node>
    <node id="Percutaneous Drainage">
      <data key="d0">Percutaneous Drainage</data>
      <data key="d1">method</data>
      <data key="d2">A minimally invasive procedure that might be used for treating abscesses or fluid accumulations, not explicitly mentioned but relevant in post-surgical care.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560604</data>
      <data key="d6" />
    </node>
    <node id="Modified DCF Regimen">
      <data key="d0">Modified DCF Regimen</data>
      <data key="d1">method</data>
      <data key="d2">A chemotherapy protocol including docetaxel, cisplatin, and fluorouracil used in cancer treatment.</data>
