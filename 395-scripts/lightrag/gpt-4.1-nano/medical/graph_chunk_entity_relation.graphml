    <node id="Cancer Subtype">
      <data key="d0">Cancer Subtype</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer subtype refers to specific classifications of cancer based on histology and genetic features.&lt;SEP&gt;A classification of cancer based on its cellular origin and characteristics, influencing treatment decisions.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
