    <node id="Pathology Report">
      <data key="d0">Pathology Report</data>
      <data key="d1">content</data>
      <data key="d2">A document summarizing microscopic examination results of biopsy samples, including cancer diagnosis and type.&lt;SEP&gt;A document summarizing laboratory findings used to guide diagnosis and treatment planning.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6</data>
