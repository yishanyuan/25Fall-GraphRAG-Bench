    <node id="PSA (Prostate-Specific Antigen)">
      <data key="d0">PSA (Prostate-Specific Antigen)</data>
      <data key="d1">content</data>
      <data key="d2">PSA is a protein produced by prostate cells, measurable in the bloodstream, used as a marker in prostate cancer detection and monitoring.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Team">
      <data key="d0">Team</data>
      <data key="d1">organization</data>
      <data key="d2">A healthcare group responsible for diagnosing, advising, and treating prostate cancer, using latest research and best practices.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Medical Center">
      <data key="d0">Medical Center</data>
      <data key="d1">organization</data>
      <data key="d2">Facilities that specialize in prostate cancer diagnosis and treatment, potentially providing second opinions for patients.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Lung Nodule">
      <data key="d0">Lung Nodule</data>
      <data key="d1">content</data>
      <data key="d2">A small mass of tissue in the lung, often found via imaging, with most being benign and some potentially malignant.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Lung Cancer Screening">
      <data key="d0">Lung Cancer Screening</data>
      <data key="d1">method</data>
      <data key="d2">A process involving imaging and other procedures to detect lung cancer early, especially in high-risk individuals.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Tobacco Smoke">
      <data key="d0">Tobacco Smoke</data>
      <data key="d1">content</data>
      <data key="d2">The largest risk factor for lung cancer, containing over 50 carcinogenic compounds.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Arsenic, Beryllium, Cadmium, Chromium, Nickel">
      <data key="d0">Arsenic, Beryllium, Cadmium, Chromium, Nickel</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Chemicals that increase lung cancer risk upon exposure.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Coal Smoke, Soot, Silica, Diesel Fumes">
      <data key="d0">Coal Smoke, Soot, Silica, Diesel Fumes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Particulate matter contributing to lung cancer risk.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Air Pollution">
      <data key="d0">Air Pollution</data>
      <data key="d1">content</data>
      <data key="d2">Contains fine particulates, ozone, nitrogen oxides, and sulfur dioxide, contributing to lung cancer risk.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Bronchioles">
      <data key="d0">Bronchioles</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Smaller airways within the lungs branching from the bronchi.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560674</data>
      <data key="d6" />
    </node>
    <node id="Pleural Membrane">
      <data key="d0">Pleural Membrane</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Thin tissue layer surrounding and protecting the lungs.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Lung Carcinomas">
      <data key="d0">Lung Carcinomas</data>
      <data key="d1">concept</data>
      <data key="d2">The primary type of lung cancers, starting in the cells lining the airways.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Chemopreventive Agents">
      <data key="d0">Chemopreventive Agents</data>
      <data key="d1">method</data>
      <data key="d2">Treatments used to prevent the development of cancer, including those studied for lung cancer prevention.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Family">
      <data key="d0">Family</data>
      <data key="d1">other</data>
      <data key="d2">Family refers to a group of related individuals, often sharing genetic traits or health history, important for understanding hereditary risks.&lt;SEP&gt;Family refers to a group of related individuals including siblings, children, half-siblings, aunts, uncles, nieces, nephews, grandparents, and grandchildren, and their lineage and relationships.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="CT (Computed Tomography) Scan">
      <data key="d0">CT (Computed Tomography) Scan</data>
      <data key="d1">method</data>
      <data key="d2">Uses x-rays and computer technology to create cross-sectional images of the body for detailed visualization.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="PET (Positron Emission Tomography) Scan">
      <data key="d0">PET (Positron Emission Tomography) Scan</data>
      <data key="d1">method</data>
      <data key="d2">Highlights cancerous cells through radioactive tracers to assess cancer extent and treatment response.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Medical Team">
      <data key="d0">Medical Team</data>
      <data key="d1">organization</data>
      <data key="d2">A team of healthcare professionals involved in diagnosing, treating, and managing prostate cancer.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Prostatic Gland">
      <data key="d0">Prostatic Gland</data>
      <data key="d1">location</data>
      <data key="d2">The prostate gland is the organ in males where prostate cancer develops.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Prostate-Specific Membrane Antigen">
      <data key="d0">Prostate-Specific Membrane Antigen</data>
      <data key="d1">concept</data>
      <data key="d2">Prostate-specific membrane antigen (PSMA) is a protein expressed on the surface of prostate cancer cells and is targeted by specific tracers for diagnostic imaging.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Prostate Cancer Cells">
      <data key="d0">Prostate Cancer Cells</data>
      <data key="d1">other</data>
      <data key="d2">Prostate cancer cells can produce large amounts of PSMA and are the target of PET scans and other diagnostic procedures.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Tracers">
      <data key="d0">Tracers</data>
      <data key="d1">content</data>
      <data key="d2">Tracers are substances developed to target PSMA, used in imaging techniques to detect prostate cancer cells.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="PSMA-PET Scan">
      <data key="d0">PSMA-PET Scan</data>
      <data key="d1">event</data>
      <data key="d2">A PSMA-PET scan is a diagnostic imaging procedure that targets PSMA to monitor prostate cancer recurrence and assess suitability for targeted therapy.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="MRI-TRUS Fusion">
      <data key="d0">MRI-TRUS Fusion</data>
      <data key="d1">method</data>
      <data key="d2">A technique combining MRI images with real-time ultrasound to enhance biopsy precision.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Liquid Biopsy">
      <data key="d0">Liquid Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A blood test used to detect circulating cancer cells or DNA, providing a non-invasive method to identify metastasis.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560675</data>
      <data key="d6" />
    </node>
    <node id="Ultrasound Probe">
      <data key="d0">Ultrasound Probe</data>
      <data key="d1">artifact</data>
      <data key="d2">A device inserted into the rectum during ultrasound-guided procedures to visualize the prostate.&lt;SEP&gt;A hand-held device used in ultrasound imaging to produce images of the thyroid and neck after applying gel to the skin.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Scans">
      <data key="d0">Scans</data>
      <data key="d1">content</data>
      <data key="d2">Various imaging scans like CT, MRI, and PET are used to detect and assess prostate cancer.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Perineum">
      <data key="d0">Perineum</data>
      <data key="d1">location</data>
      <data key="d2">The perineum is the skin between the anus and scrotum, used as an entry point for biopsies.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Head and Neck">
      <data key="d0">Head and Neck</data>
      <data key="d1">anatomicalregion</data>
      <data key="d2">The head and neck are parts of the human body encompassing various organs, glands, and structures involved in sensory, respiratory, and digestive functions.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Heart">
      <data key="d0">Heart</data>
      <data key="d1">organ</data>
      <data key="d2">The heart is a vital organ regulating blood circulation, and its examination includes listening to its sounds.&lt;SEP&gt;The heart can appear bright on PET scans, which is normal.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Fiberscope">
      <data key="d0">Fiberscope</data>
      <data key="d1">method</data>
      <data key="d2">A fiberoptic scope is a medical instrument used to visually examine internal body areas that are difficult to see directly.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Dentist">
      <data key="d0">Dentist</data>
      <data key="d1">person</data>
      <data key="d2">A dentist is a healthcare professional responsible for oral health, especially important for those with head and neck cancer.&lt;SEP&gt;A dentist is a health professional responsible for dental care, who should be informed about a patient's head and neck cancer history.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560676</data>
      <data key="d6" />
    </node>
    <node id="Disease">
      <data key="d0">Disease</data>
      <data key="d1">concept</data>
      <data key="d2">A disease is an abnormal condition affecting part of the body, such as head and neck cancer.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Distress">
      <data key="d0">Distress</data>
      <data key="d1">concept</data>
      <data key="d2">Distress refers to an unpleasant emotional, physical, social, or spiritual experience, often related to a cancer diagnosis.&lt;SEP&gt;Distress is an unpleasant mental, physical, social, or spiritual experience that can influence feelings, thoughts, and behaviors, especially following a cancer diagnosis.&lt;SEP&gt;Distress is an unpleasant mental, physical, social, or spiritual experience related to cancer diagnosis and treatment.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Mind and Body Therapists">
      <data key="d0">Mind and Body Therapists</data>
      <data key="d1">person</data>
      <data key="d2">Specialized professionals who assist with psychological and physical well-being during cancer treatment.&lt;SEP&gt;Therapists who help patients cope with cancer diagnosis, treatment stress, and associated emotional issues.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Emotional Support">
      <data key="d0">Emotional Support</data>
      <data key="d1">content</data>
      <data key="d2">Support and counseling services available to help patients cope with cancer diagnosis and treatment.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Endocrine Glands">
      <data key="d0">Endocrine Glands</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Endocrine glands like the thyroid and pituitary glands regulate hormones; treatments like radiation may impact them.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Thyroid">
      <data key="d0">Thyroid</data>
      <data key="d1">location</data>
      <data key="d2">A hormone-producing gland located in the head and neck, susceptible to effects of radiation therapy.&lt;SEP&gt;The thyroid is a butterfly-shaped gland in the front of the neck, producing hormones essential for body functions.&lt;SEP&gt;The thyroid is a gland in the neck involved in hormone production; it is subject to surgical procedures like lobectomy and total thyroidectomy.&lt;SEP&gt;The thyroid is a gland in the neck that produces thyroid hormones and is involved in regulating metabolism and growth.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Pituitary Gland">
      <data key="d0">Pituitary Gland</data>
      <data key="d1">organ</data>
      <data key="d2">A key endocrine gland in the head that can be affected by radiation therapy.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Audiogram">
      <data key="d0">Audiogram</data>
      <data key="d1">content</data>
      <data key="d2">An audiogram graphically displays the results of a pure-tone hearing test.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Hearing Loss">
      <data key="d0">Hearing Loss</data>
      <data key="d1">concept</data>
      <data key="d2">A reduction in hearing ability, which can be caused by tumors or treatments in the head and neck.&lt;SEP&gt;Hearing loss, possibly caused by head and neck tumors or treatment, can be diagnosed through hearing tests.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Nutrition Expert">
      <data key="d0">Nutrition Expert</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional who assesses and advises on adequate nutrition before and during treatment.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Swallowing Therapist">
      <data key="d0">Swallowing Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A specialist who tests and assists with swallowing and speech capabilities before and after treatment.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="ECOG">
      <data key="d0">ECOG</data>
      <data key="d1">data</data>
      <data key="d2">The Eastern Cooperative Oncology Group (ECOG) scale assesses performance status in cancer patients.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Fertility Specialist">
      <data key="d0">Fertility Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical expert who advises patients on options to preserve fertility prior to cancer treatment.&lt;SEP&gt;A fertility specialist is a medical professional who provides guidance and procedures to preserve fertility before cancer treatment.&lt;SEP&gt;A healthcare professional who discusses options for fertility preservation with patients.&lt;SEP&gt;A fertility specialist is a doctor who helps patients explore options to preserve fertility before cancer treatment.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Birth Control">
      <data key="d0">Birth Control</data>
      <data key="d1">method</data>
      <data key="d2">Various methods such as condoms, IUDs, and barrier methods used to prevent pregnancy during and after treatment.&lt;SEP&gt;Methods such as IUDs and barrier options prevent pregnancy during and after treatment.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560677</data>
      <data key="d6" />
    </node>
    <node id="Condoms">
      <data key="d0">Condoms</data>
      <data key="d1">method</data>
      <data key="d2">A barrier contraceptive method used to prevent pregnancy and protect against sexually transmitted infections.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Palpation">
      <data key="d0">Palpation</data>
      <data key="d1">method</data>
      <data key="d2">Palpation is a technique involving feeling with hands to examine body parts, such as the oral cavity, to detect abnormalities or structures.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Fiberoptic Scope">
      <data key="d0">Fiberoptic Scope</data>
      <data key="d1">method</data>
      <data key="d2">A fiberoptic scope is a specialized medical instrument used to visually examine internal regions like the mouth and throat.&lt;SEP&gt;A fiberoptic scope is a device used by healthcare providers to look inside the body, especially for examining the oropharynx.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Support and Counseling">
      <data key="d0">Support and Counseling</data>
      <data key="d1">content</data>
      <data key="d2">Support and counseling services are available to help patients cope emotionally and psychologically with cancer.&lt;SEP&gt;Support and counseling refer to services offered to help individuals cope with stress, emotional distress, and mental health challenges related to illness and diagnosis.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Social Worker">
      <data key="d0">Social Worker</data>
      <data key="d1">person</data>
      <data key="d2">A social worker provides support and assistance for patients and families dealing with cancer-related emotional challenges.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Reproductive Health">
      <data key="d0">Reproductive Health</data>
      <data key="d1">concept</data>
      <data key="d2">Reproductive health involves maintaining the ability to conceive and have children, which may be affected by cancer treatments.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Pregnancy Planning">
      <data key="d0">Pregnancy Planning</data>
      <data key="d1">concept</data>
      <data key="d2">The process of preparing for pregnancy, especially important when cancer treatments might influence fertility and pregnancy.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560678</data>
      <data key="d6" />
    </node>
    <node id="Complication">
      <data key="d0">Complication</data>
      <data key="d1">concept</data>
      <data key="d2">An unwanted and unplanned result from a medical procedure, including infection, bleeding, or blood in urine, stool, or semen.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Genetic Test">
      <data key="d0">Genetic Test</data>
      <data key="d1">method</data>
      <data key="d2">A scientific analysis used to detect harmful genetic changes, including mutations, which may impact cell functions and lead to disease such as cancer.&lt;SEP&gt;Genetic testing involves analyzing genes to find mutations associated with cancer risk.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Germline Mutation">
      <data key="d0">Germline Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">Hereditary mutations in genes like BRCA1, BRCA2, or Lynch syndrome passed from parent to child.&lt;SEP&gt;A hereditary mutation present in egg or sperm cells, transmitted across generations.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Hereditary Gene Testing">
      <data key="d0">Hereditary Gene Testing</data>
      <data key="d1">method</data>
      <data key="d2">A genetic test that screens for inherited gene mutations using a blood, urine, or saliva sample, to assess cancer risk.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Tumor Testing">
      <data key="d0">Tumor Testing</data>
      <data key="d1">method</data>
      <data key="d2">A molecular analysis conducted on tissue or blood samples from a tumor or metastasis to identify molecular markers and abnormal gene features.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Cancer Risk">
      <data key="d0">Cancer Risk</data>
      <data key="d1">concept</data>
      <data key="d2">The potential likelihood of developing cancer, influenced by genetic mutations and assessed through genetic testing.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Internal Organs">
      <data key="d0">Internal Organs</data>
      <data key="d1">location</data>
      <data key="d2">Internal organs, such as the liver, can be affected by metastatic prostate cancer.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Breast Cancer">
      <data key="d0">Breast Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer is a malignant tumor originating in the tissue of the breast, primarily arising from epithelial cells within the terminal duct lobular units. It involves abnormal growth of these epithelial cells, which can invade surrounding tissues and metastasize to distant sites such as the lungs and lymph nodes. Various subtypes of breast cancer exist, including ductal carcinoma, lobular carcinoma, and inflammatory breast cancer, each characterized by specific cellular origins and clinical behaviors.

Typically, breast cancer begins in the ducts or lobules of the breast tissue but has the potential to invade neighboring tissues and spread via lymphatic pathways or bloodstream. The disease's progression and extent are assessed through staging systems like TNM, which evaluate tumor size, nodal involvement, and metastasis, informing prognosis and treatment strategies. Treatment approaches often involve a combination of surgery, radiation therapy, and systemic therapies, tailored to the specific subtype and stage of the disease.

Overall, breast cancer is characterized by the uncontrolled proliferation of malignant cells within breast tissue, with its ability to invade locally and metastasize making it a significant health concern. Accurate diagnosis, staging, and understanding of its various forms are crucial for effective management and improving patient outcomes.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Tumor Staging">
      <data key="d0">Tumor Staging</data>
      <data key="d1">concept</data>
      <data key="d2">Tumor staging is a method used to describe the size, spread, and extent of cancer, particularly using the TNM system based on imaging, biopsies, and blood tests.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="PSA Density">
      <data key="d0">PSA Density</data>
      <data key="d1">data</data>
      <data key="d2">PSA density is a measurement used in prostate cancer evaluation, not detailed in this text.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Inherited Genetic Mutation">
      <data key="d0">Inherited Genetic Mutation</data>
      <data key="d1">concept</data>
      <data key="d2">Inherited genetic mutations are changes present in every cell and can increase cancer risk.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Non-Hormone Therapy">
      <data key="d0">Non-Hormone Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Non-hormone therapies include chemotherapy, immunotherapy, targeted therapy, and radiation therapy.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Castration">
      <data key="d0">Castration</data>
      <data key="d1">other</data>
      <data key="d2">Castration refers to the reduction of testosterone, either surgically via orchiectomy or chemically through medication.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Orchiectomy">
      <data key="d0">Orchiectomy</data>
      <data key="d1">method</data>
      <data key="d2">Orchiectomy is a surgical procedure removing one or both testicles to reduce testosterone permanently.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Androgen Deprivation Therapy">
      <data key="d0">Androgen Deprivation Therapy</data>
      <data key="d1">concept</data>
      <data key="d2">ADT is a systemic treatment that lowers testosterone to starve prostate cancer cells, often called deprivation therapy.&lt;SEP&gt;Androgen deprivation therapy (ADT) is a treatment that reduces testosterone to very low levels, used mainly for prostate cancer, involving various drugs and surgical procedures to suppress testosterone production.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560679</data>
      <data key="d6" />
    </node>
    <node id="Testosterone">
      <data key="d0">Testosterone</data>
      <data key="d1">content</data>
      <data key="d2">Testosterone is the main male hormone that promotes prostate cancer growth and is targeted by ADT.&lt;SEP&gt;Testosterone is a hormone that can be suppressed during endocrine therapy, especially in males.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Gonadotropin-Releasing Hormone (LHRH) Agonist">
      <data key="d0">Gonadotropin-Releasing Hormone (LHRH) Agonist</data>
      <data key="d1">content</data>
      <data key="d2">LHRH agonists (goserelin, leuprolide, triptorelin) are drugs used to lower testosterone levels.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="LHRH Antagonist">
      <data key="d0">LHRH Antagonist</data>
      <data key="d1">content</data>
      <data key="d2">LHRH antagonists (degarelix, relugolix) are drugs that rapidly reduce testosterone production.&lt;SEP&gt;LHRH antagonists, such as degarelix and relugolix, directly inhibit LHRH receptors to lower testosterone levels.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Anti-Androgen">
      <data key="d0">Anti-Androgen</data>
      <data key="d1">content</data>
      <data key="d2">Anti-androgens (nilutamide, flutamide, bicalutamide) block cancer cells from using testosterone.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Drug Hormone Therapy">
      <data key="d0">Drug Hormone Therapy</data>
      <data key="d1">other</data>
      <data key="d2">Drug hormone therapy can be reversible and involves medications that manipulate hormone levels.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Surgical Hormone Therapy">
      <data key="d0">Surgical Hormone Therapy</data>
      <data key="d1">other</data>
      <data key="d2">Surgical hormone therapy involves orchiectomy, which is permanent.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Test Results (additional mention)">
      <data key="d0">Test Results (additional mention)</data>
      <data key="d1">data</data>
      <data key="d2">Test results are used to assess tumor size (T), node involvement (N), and metastasis (M).</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Next Chapter">
      <data key="d0">Next Chapter</data>
      <data key="d1">content</data>
      <data key="d2">The next chapter in the source document discusses treatment options for advanced prostate cancer.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560680</data>
      <data key="d6" />
    </node>
    <node id="Test Results (additional correction)">
      <data key="d0">Test Results (additional correction)</data>
      <data key="d1">data</data>
      <data key="d2">Test results from imaging, blood tests, biopsy, and genetic testing are used to determine cancer extent, stage, and treatment options.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="LHRH Agonist">
      <data key="d0">LHRH Agonist</data>
      <data key="d1">method</data>
      <data key="d2">LHRH agonists, including goserelin, leuprolide, and triptorelin, are drugs that stimulate and then desensitize LHRH receptors to decrease testosterone production.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Goserelin">
      <data key="d0">Goserelin</data>
      <data key="d1">organization</data>
      <data key="d2">Goserelin is a pharmaceutical drug classified as an LHRH agonist used in hormone therapy for prostate cancer.&lt;SEP&gt;Goserelin (Zoladex) is an LHRH agonist used in ovarian suppression to block hormone production in breast cancer therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Leuprolide">
      <data key="d0">Leuprolide</data>
      <data key="d1">organization</data>
      <data key="d2">Leuprolide, marketed as Lupron, is an LHRH agonist used in androgen deprivation therapy.&lt;SEP&gt;Leuprolide (Lupron Depot) is an LHRH agonist used to suppress ovarian hormone production.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Degarelix">
      <data key="d0">Degarelix</data>
      <data key="d1">organization</data>
      <data key="d2">Degarelix, marketed as Firmagon, is an LHRH antagonist used for prostate cancer treatment.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Relugolix">
      <data key="d0">Relugolix</data>
      <data key="d1">organization</data>
      <data key="d2">Relugolix, marketed as Orgovyx, is an LHRH antagonist administered as a daily tablet.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Surgical Castration">
      <data key="d0">Surgical Castration</data>
      <data key="d1">method</data>
      <data key="d2">Surgical castration is a physical method of hormone therapy that involves removing the testicles to block testosterone production.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
      <data key="d6" />
    </node>
    <node id="Luteinizing Hormone-Releasing Hormone">
      <data key="d0">Luteinizing Hormone-Releasing Hormone</data>
      <data key="d1">concept</data>
      <data key="d2">LHRH is a hormone that stimulates testosterone production; therapies aim to suppress its activity to treat prostate cancer.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560681</data>
