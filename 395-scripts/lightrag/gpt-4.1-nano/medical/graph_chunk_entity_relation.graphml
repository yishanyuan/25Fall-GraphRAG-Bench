    <node id="Mantle Cell Lymphoma">
      <data key="d0">Mantle Cell Lymphoma</data>
      <data key="d1">disease</data>
      <data key="d2">Mantle cell lymphoma is a different type of lymphoma that does not have CD200 and LEF1 markers, used for differential diagnosis.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
