    </edge>
    <edge source="Bladder Cancer" target="Stages">
      <data key="d7">1.0</data>
      <data key="d8">Bladder cancer is classified into stages based on how far it has spread: non–muscle-invasive, muscle-invasive, and metastatic.</data>
