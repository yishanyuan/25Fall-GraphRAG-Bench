      <data key="d11">unknown_source</data>
      <data key="d12">1764561014</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Contraception">
      <data key="d7">1.0</data>
      <data key="d8">Use of contraception is recommended during and after cancer treatment to prevent pregnancy.</data>
