      <data key="d0">Modified DCF</data>
      <data key="d1">method</data>
      <data key="d2">A chemotherapy regimen including docetaxel, cisplatin, and fluorouracil used as first-line therapy for metastatic anal cancer.</data>
      <data key="d3">chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560604</data>
      <data key="d6" />
    </node>
    <node id="Digital Rectal Exams">
      <data key="d0">Digital Rectal Exams</data>
      <data key="d1">procedure</data>
      <data key="d2">A clinical examination method used to assess anal and rectal area, recommended periodically after treatment.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560604</data>
      <data key="d6" />
    </node>
