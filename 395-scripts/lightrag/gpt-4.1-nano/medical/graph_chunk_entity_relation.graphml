    <edge source="Pheochromocytoma" target="Adrenal Gland">
      <data key="d7">1.0</data>
      <data key="d8">Pheochromocytoma originates in the adrenal medulla, producing excess hormones and causing symptoms like high blood pressure and rapid heartbeat.</data>
      <data key="d9">symptomatic,tumor</data>
      <data key="d10">chunk-7102a43dfb62e649d725bc95ba292688</data>
