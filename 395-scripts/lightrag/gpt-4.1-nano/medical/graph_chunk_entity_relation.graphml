      <data key="d0">Stage 1B Ovarian Cancer</data>
      <data key="d1">location</data>
      <data key="d2">Stage 1B ovarian cancer involves both ovaries with no external surface cancer.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560483</data>
