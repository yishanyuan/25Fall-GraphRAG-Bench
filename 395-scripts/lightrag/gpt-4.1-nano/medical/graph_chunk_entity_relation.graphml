    <node id="Cancer Centers">
      <data key="d0">Cancer Centers</data>
      <data key="d1">location</data>
      <data key="d2">Cancer centers are medical facilities where diagnosis, treatment, and management of cancer are provided, often including support from social workers.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Mastectomy">
      <data key="d0">Mastectomy</data>
      <data key="d1">procedure</data>
      <data key="d2">Surgical removal of all or part of the breast to treat breast cancer.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="HER2-Targeted Therapy">
      <data key="d0">HER2-Targeted Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Targeted treatments such as Pertuzumab, Trastuzumab, T-DM1, and others designed to attack HER2-positive breast cancer.&lt;SEP&gt;HER2-targeted therapy involves drugs like HER2 antibodies, HER2 inhibitors, and antibody drug conjugates to treat HER2-positive breast cancer.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Breast Reconstruction">
      <data key="d0">Breast Reconstruction</data>
      <data key="d1">procedure</data>
      <data key="d2">Surgical option for restoring breast appearance after mastectomy, often performed after completing cancer treatment.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Modified Radical Mastectomy">
      <data key="d0">Modified Radical Mastectomy</data>
      <data key="d1">procedure</data>
      <data key="d2">Modified radical mastectomy is a surgical procedure where the entire breast and some lymph nodes are removed, possibly including part of the chest wall muscle.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Adjuvant Therapy">
      <data key="d0">Adjuvant Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Adjuvant therapy is postoperative systemic drug treatment aimed at eliminating remaining cancer cells.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Herbal Supplements">
      <data key="d0">Herbal Supplements</data>
      <data key="d1">content</data>
      <data key="d2">Herbal supplements like turmeric, ginkgo biloba, green tea extract, and St. John’s Wort can affect drug interactions during systemic cancer therapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="Myeloid Growth Factors">
      <data key="d0">Myeloid Growth Factors</data>
      <data key="d1">method</data>
      <data key="d2">Myeloid growth factors are used to increase white blood cell count and prevent infections during chemotherapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="HER2 Antibodies">
      <data key="d0">HER2 Antibodies</data>
      <data key="d1">content</data>
      <data key="d2">HER2 antibodies prevent growth signals from HER2 from outside the cell and enhance immune attack on cancer cells.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="HER2 Inhibitors">
      <data key="d0">HER2 Inhibitors</data>
      <data key="d1">content</data>
      <data key="d2">HER2 inhibitors block growth signals from HER2 within the cell.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
      <data key="d6" />
    </node>
    <node id="HER2 Conjugates">
      <data key="d0">HER2 Conjugates</data>
      <data key="d1">content</data>
      <data key="d2">HER2 conjugates or ADCs deliver chemotherapy directly to HER2-expressing cells.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="Trastuzumab">
      <data key="d0">Trastuzumab</data>
      <data key="d1">organization</data>
      <data key="d2">Trastuzumab is a drug used in HER2-targeted therapy, with heart function monitoring involved during treatment.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="Left Ventricular Ejection Fraction">
      <data key="d0">Left Ventricular Ejection Fraction</data>
      <data key="d1">data</data>
      <data key="d2">Left ventricular ejection fraction (LVEF) measures the blood pumped from the heart and is monitored during trastuzumab treatment.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="CDK4/6">
      <data key="d0">CDK4/6</data>
      <data key="d1">concept</data>
      <data key="d2">CDK4/6 are cell cycle proteins involved in cell growth and division, targeted by specific inhibitors.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="CDK4/6 Inhibitors">
      <data key="d0">CDK4/6 Inhibitors</data>
      <data key="d1">method</data>
      <data key="d2">CDK4/6 inhibitors, including abemaciclib, palbociclib, and ribociclib, are used with endocrine therapy in certain breast cancers.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="mTOR">
      <data key="d0">mTOR</data>
      <data key="d1">concept</data>
      <data key="d2">mTOR is a protein that helps cells grow and divide, with overactivity potentially causing resistance to endocrine therapy.&lt;SEP&gt;mTOR is a cell protein that helps cells grow and divide; overactive mTOR can cause resistance to endocrine therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="mTOR Inhibitors">
      <data key="d0">mTOR Inhibitors</data>
      <data key="d1">method</data>
      <data key="d2">mTOR inhibitors, such as everolimus, are used to restore endocrine therapy effectiveness.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="Everolimus">
      <data key="d0">Everolimus</data>
      <data key="d1">organization</data>
      <data key="d2">Everolimus is an mTOR inhibitor often combined with exemestane in breast cancer treatment.&lt;SEP&gt;Everolimus, also called Afinitor, is an mTOR inhibitor often taken with exemestane.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560701</data>
      <data key="d6" />
    </node>
    <node id="Ibrance">
      <data key="d0">Ibrance</data>
      <data key="d1">content</data>
      <data key="d2">Ibrance is a medication, also known as lib, used in cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Kisqali">
      <data key="d0">Kisqali</data>
      <data key="d1">content</data>
      <data key="d2">Kisqali is a medication, containing ribociclib, used in cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Exemestane">
      <data key="d0">Exemestane</data>
      <data key="d1">content</data>
      <data key="d2">Exemestane (Aromasin) is a steroidal aromatase inhibitor used in hormonal therapy for breast cancer.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Fulvestrant">
      <data key="d0">Fulvestrant</data>
      <data key="d1">content</data>
      <data key="d2">Fulvestrant (Faslodex) is a selective estrogen receptor degrader (SERD) used in hormone therapy.&lt;SEP&gt;Fulvestrant (Faslodex) is a SERD that blocks and destroys estrogen receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Tamoxifen">
      <data key="d0">Tamoxifen</data>
      <data key="d1">content</data>
      <data key="d2">Tamoxifen is a selective estrogen receptor modulator (SERM) used in hormone therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="PARP">
      <data key="d0">PARP</data>
      <data key="d1">concept</data>
      <data key="d2">PARP is a cell protein that repairs cancer cells, enabling their survival; inhibiting PARP can kill cancer cells.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Olaparib">
      <data key="d0">Olaparib</data>
      <data key="d1">content</data>
      <data key="d2">Olaparib is a PARP inhibitor used for up to 2 years in maintenance therapy for ovarian cancer.&lt;SEP&gt;Olaparib (Lynparza) is a PARP inhibitor used for maintenance therapy in ovarian cancer patients with HRD-positive or BRCA-mutated cancers.&lt;SEP&gt;Olaparib is used for maintenance therapy in BRCA-mutated or HRD-positive ovarian cancers.&lt;SEP&gt;Olaparib, also called Lynparza, is a PARP inhibitor used in cancer treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Talazoparib">
      <data key="d0">Talazoparib</data>
      <data key="d1">content</data>
      <data key="d2">Talazoparib, also called Talzenna, is a PARP inhibitor used in cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="PIK3CA">
      <data key="d0">PIK3CA</data>
      <data key="d1">concept</data>
      <data key="d2">PIK3CA is a gene frequently mutated in breast cancer, leading to increased growth and treatment resistance.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Alpelisib">
      <data key="d0">Alpelisib</data>
      <data key="d1">content</data>
      <data key="d2">Alpelisib, also called Piqray, is a PIK3CA inhibitor used in breast cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="CTLA">
      <data key="d0">CTLA</data>
      <data key="d1">concept</data>
      <data key="d2">CTLA are off switches in the immune system exploited by tumors to evade immune response.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Endocrine Therapy">
      <data key="d0">Endocrine Therapy</data>
      <data key="d1">concept</data>
      <data key="d2">Endocrine therapy involves blocking hormones or preventing their action to slow or shrink breast cancer tumors.&lt;SEP&gt;Endocrine therapy blocks estrogen or progesterone to treat hormone receptor-positive breast cancer.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Ovarian">
      <data key="d0">Ovarian</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Ovaries are organs that produce estrogen and progesterone, targeted by endocrine therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="LHRH">
      <data key="d0">LHRH</data>
      <data key="d1">method</data>
      <data key="d2">Luteinizing hormone-releasing hormone (LHRH) is made by the hypothalamus and stimulates ovaries/testicles to produce hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="GnRH">
      <data key="d0">GnRH</data>
      <data key="d1">method</data>
      <data key="d2">Gonadotropin-releasing hormone (GnRH) is another name for LHRH.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Aromatase">
      <data key="d0">Aromatase</data>
      <data key="d1">concept</data>
      <data key="d2">Aromatase is an enzyme that converts androgen into estrogen; targeted by aromatase inhibitors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560702</data>
      <data key="d6" />
    </node>
    <node id="Anastrozole">
      <data key="d0">Anastrozole</data>
      <data key="d1">content</data>
      <data key="d2">Anastrozole (Arimidex) is a non-steroidal aromatase inhibitor.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Letrozole">
      <data key="d0">Letrozole</data>
      <data key="d1">content</data>
      <data key="d2">Letrozole (Femara) is a non-steroidal aromatase inhibitor.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="SERMs">
      <data key="d0">SERMs</data>
      <data key="d1">method</data>
      <data key="d2">Selective estrogen receptor modulators (SERMs) block estrogen from attaching to receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Serds">
      <data key="d0">Serds</data>
      <data key="d1">method</data>
      <data key="d2">Selective estrogen receptor degraders (SERDs) destroy estrogen receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Elacestrant">
      <data key="d0">Elacestrant</data>
      <data key="d1">content</data>
      <data key="d2">Elacestrant (Orserdu) is a SERD that blocks and destroys estrogen receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Premenopause">
      <data key="d0">Premenopause</data>
      <data key="d1">concept</data>
      <data key="d2">Premenopause is a phase where the ovaries are the main source of estrogen and progesterone, and menstrual periods may stop temporarily.&lt;SEP&gt;Premenopause refers to the phase where menstrual periods occur; ovaries mainly produce estrogen and progesterone.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Surgical">
      <data key="d0">Surgical</data>
      <data key="d1">method</data>
      <data key="d2">Bilateral oophorectomy is surgical removal of both ovaries.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Ovarian Ablation">
      <data key="d0">Ovarian Ablation</data>
      <data key="d1">method</data>
      <data key="d2">Ovarian ablation uses radiation to permanently stop ovaries from producing hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560703</data>
      <data key="d6" />
    </node>
    <node id="Ovarian Suppression">
      <data key="d0">Ovarian Suppression</data>
      <data key="d1">method</data>
      <data key="d2">Ovarian suppression uses drugs (LHRH agonists) to temporarily stop ovaries from making hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Menopause">
      <data key="d0">Menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Menopause is the natural cessation of menstrual periods, typically occurring around age 50, but women under 35 may still experience return of periods.&lt;SEP&gt;Menopause involves cessation of menstrual periods; premenopause is the phase before this occurs.&lt;SEP&gt;The hormonal change experienced after ovary removal, leading to symptoms like hot flashes and osteoporosis.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Hormonal">
      <data key="d0">Hormonal</data>
      <data key="d1">concept</data>
      <data key="d2">Hormonal refers to substances or therapies that influence hormones or hormone receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Menstrual periods">
      <data key="d0">Menstrual periods</data>
      <data key="d1">other</data>
      <data key="d2">Menstrual periods may stop during treatment (amenorrhea) and for up to 2 years after treatment, often returning in women aged 35 and under.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Endocrine therapy">
      <data key="d0">Endocrine therapy</data>
      <data key="d1">method</data>
      <data key="d2">Endocrine therapy is a treatment approach affecting hormone production related to premenopause.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Primary CNS lymphoma">
      <data key="d0">Primary CNS lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">Primary central nervous system lymphoma is a rare, aggressive cancer originating in the lymphocytes of the central nervous system.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Central nervous system">
      <data key="d0">Central nervous system</data>
      <data key="d1">location</data>
      <data key="d2">The CNS consists of the brain, spinal cord, cerebrospinal fluid, and eyes, and processes signals, controls responses, and is protected by membranes, bones, and fluids.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Spinal cord">
      <data key="d0">Spinal cord</data>
      <data key="d1">location</data>
      <data key="d2">The spinal cord, part of the CNS, transmits signals between the brain and body and can be involved in primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Cerebrospinal fluid">
      <data key="d0">Cerebrospinal fluid</data>
      <data key="d1">content</data>
      <data key="d2">Cerebrospinal fluid surrounds the brain and spinal cord, providing cushioning and potentially involved in lymphoma spread.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Meninges">
      <data key="d0">Meninges</data>
      <data key="d1">artifact</data>
      <data key="d2">Meninges are membranes that cover the brain and spinal cord, providing a protective layer.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Genetic abnormality">
      <data key="d0">Genetic abnormality</data>
      <data key="d1">concept</data>
      <data key="d2">A genetic abnormality or mutation in lymphocytes can initiate lymphoma development.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Impaired immune system">
      <data key="d0">Impaired immune system</data>
      <data key="d1">concept</data>
      <data key="d2">Having a weakened immune system may increase the risk of developing primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Epstein-Barr virus">
      <data key="d0">Epstein-Barr virus</data>
      <data key="d1">organization</data>
      <data key="d2">Epstein-Barr virus causes mononucleosis and may increase the risk of primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Autoimmune disease">
      <data key="d0">Autoimmune disease</data>
      <data key="d1">concept</data>
      <data key="d2">Autoimmune diseases like lupus may elevate the risk of developing primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Organ transplant">
      <data key="d0">Organ transplant</data>
      <data key="d1">organization</data>
      <data key="d2">Organ transplants require medications that suppress the immune system, increasing lymphoma risk.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Nerve changes">
      <data key="d0">Nerve changes</data>
      <data key="d1">other</data>
      <data key="d2">Symptoms such as weakness, coordination problems, and movement issues can result from the lymphoma’s location.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560704</data>
      <data key="d6" />
    </node>
    <node id="Neurological symptoms">
      <data key="d0">Neurological symptoms</data>
      <data key="d1">content</data>
      <data key="d2">Headaches, nausea, vomiting, and seizures are common neurological symptoms caused by tumor pressure.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Vision changes">
      <data key="d0">Vision changes</data>
      <data key="d1">content</data>
      <data key="d2">Changes like blurry vision can occur if the lymphoma affects the eyes or visual pathways.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Amenorrhea">
      <data key="d0">Amenorrhea</data>
      <data key="d1">other</data>
      <data key="d2">Amenorrhea refers to the temporary or lasting stop of menstruation, which may be related to treatments in premenopausal women.&lt;SEP&gt;Amenorrhea is the absence of menstruation, which may occur during and after treatment in premenopausal women.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Immunodeficiency">
      <data key="d0">Immunodeficiency</data>
      <data key="d1">concept</data>
      <data key="d2">Immunodeficiency disorders weaken the immune system, increasing the risk of primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Object">
      <data key="d0">Object</data>
      <data key="d1">thelymphomatumor</data>
      <data key="d2">is an abnormal growth within the CNS in primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Central Nervous System">
      <data key="d0">Central Nervous System</data>
      <data key="d1">location</data>
      <data key="d2">The central nervous system includes the brain and spinal cord, which can be affected by primary CNS lymphoma.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Therapy">
      <data key="d0">Therapy</data>
      <data key="d1">content</data>
      <data key="d2">Treatments can slow lymphoma growth, reduce symptoms, and prolong life; cure is rare but possible if diagnosed early.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560705</data>
      <data key="d6" />
    </node>
    <node id="Relapse">
      <data key="d0">Relapse</data>
      <data key="d1">concept</data>
      <data key="d2">Relapse refers to the return of primary CNS lymphoma after treatment.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Headaches">
      <data key="d0">Headaches</data>
      <data key="d1">concept</data>
      <data key="d2">Headaches are neurological symptoms resulting from increased pressure or tumor growth in the brain.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Seizures">
      <data key="d0">Seizures</data>
      <data key="d1">concept</data>
      <data key="d2">Seizures result from neurological disruptions related to lymphoma pressing on the CNS.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Eye Exam">
      <data key="d0">Eye Exam</data>
      <data key="d1">method</data>
      <data key="d2">An eye exam is a diagnostic test to evaluate vision issues related to CNS lymphoma spread to the eyes.&lt;SEP&gt;An eye exam may be recommended if nasopharyngeal cancer potentially affects vision and eye health.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Imaging (MRI or CT scan)">
      <data key="d0">Imaging (MRI or CT scan)</data>
      <data key="d1">method</data>
      <data key="d2">Imaging tests help visualize CNS involvement and the spread of lymphoma.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Treatment in Clinical Trials">
      <data key="d0">Treatment in Clinical Trials</data>
      <data key="d1">content</data>
      <data key="d2">Participating in clinical trials offers access to new therapies that might improve outcomes.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Gadolinium">
      <data key="d0">Gadolinium</data>
      <data key="d1">content</data>
      <data key="d2">Gadolinium is a contrast agent used in MRI scans to highlight areas in the brain affected by primary CNS lymphoma, enhancing imaging results.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Stephanie E. Weiss">
      <data key="d0">Stephanie E. Weiss</data>
      <data key="d1">person</data>
      <data key="d2">Stephanie E.. Weiss, MD, FASTRO, is a medical doctor involved in the diagnosis or treatment of lymphoma and related procedures.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="CNS Lymphoma">
      <data key="d0">CNS Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">CNS lymphoma, also known as primary CNS lymphoma, is a type of lymphoma that occurs in the brain, spinal cord, and sometimes in the eyes.</data>
      <data key="d3">chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Ophthalmologist">
      <data key="d0">Ophthalmologist</data>
      <data key="d1">person</data>
      <data key="d2">An ophthalmologist is a medical specialist who performs eye exams and procedures such as slit lamp examination, vitreous biopsy, and vitrectomy.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Vitreous">
      <data key="d0">Vitreous</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The vitreous is the clear gel filling the eye, which can be tested for cancer cells in ophthalmologic diagnosis.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Vitreoretinal Lymphoma">
      <data key="d0">Vitreoretinal Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">Vitreoretinal lymphoma is a subtype of primary CNS lymphoma involving the eye's vitreous or retina.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Cerebrospinal Fluid">
      <data key="d0">Cerebrospinal Fluid</data>
      <data key="d1">naturalobject</data>
      <data key="d2">CSF is a liquid surrounding the brain and spinal cord, tested to detect cancer cells or spread of lymphoma.&lt;SEP&gt;Cerebrospinal fluid surrounds the brain and spinal cord, serving as a medium for intrathecal chemotherapy.&lt;SEP&gt;Cerebrospinal fluid is a clear fluid that surrounds the brain and spinal cord, involved in intracerebral delivery of chemotherapy.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Retina">
      <data key="d0">Retina</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The retina is the light-sensitive layer of tissue at the back of the eye where lymphoma can form in the vitreoretinal lymphoma.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560706</data>
      <data key="d6" />
    </node>
    <node id="Optic Nerve">
      <data key="d0">Optic Nerve</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The optic nerve connects the eye to the brain and is involved in the spread of lymphoma from the eye to the brain.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="Slit Lamp">
      <data key="d0">Slit Lamp</data>
      <data key="d1">method</data>
      <data key="d2">A slit lamp is a microscope with a bright light used during eye examinations to visualize the retina, optic nerve, and other eye structures.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="Testicular">
      <data key="d0">Testicular</data>
      <data key="d1">location</data>
      <data key="d2">Testicles are a location where lymphoma may spread and be evaluated via imaging and testing.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="PET">
      <data key="d0">PET</data>
      <data key="d1">method</data>
      <data key="d2">Positron Emission Tomography (PET) is an imaging technique using radioactive tracers to detect cancer cells in the body.&lt;SEP&gt;Positron emission tomography used to detect cancer spread.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="Ultrasound of Testicles">
      <data key="d0">Ultrasound of Testicles</data>
      <data key="d1">content</data>
      <data key="d2">An ultrasound of the testicles is used as an additional imaging test after diagnosis of cancer.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="Lactate Dehydrogenase Test">
      <data key="d0">Lactate Dehydrogenase Test</data>
      <data key="d1">method</data>
      <data key="d2">A test measuring levels of the enzyme LDH, which can indicate cell damage caused by cancer.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="HIV Blood Test">
      <data key="d0">HIV Blood Test</data>
      <data key="d1">content</data>
      <data key="d2">A blood test for HIV that is necessary for everyone with primary CNS lymphoma, related to specialized care.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560707</data>
      <data key="d6" />
    </node>
    <node id="Hepatitis B Test">
      <data key="d0">Hepatitis B Test</data>
      <data key="d1">content</data>
      <data key="d2">A test needed if immunotherapy is to be administered and there is prior risk or history of hepatitis B.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Marrow">
      <data key="d0">Marrow</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Spongy core of bones where blood cells are produced, involved in testing for lymphoma spread.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Eye Examination">
      <data key="d0">Eye Examination</data>
      <data key="d1">method</data>
      <data key="d2">A thorough examination to detect lymphoma in the eyes post-diagnosis.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Stem Cell Rescue">
      <data key="d0">Stem Cell Rescue</data>
      <data key="d1">method</data>
      <data key="d2">A procedure that involves transplanting stem cells to restore bone marrow after intensive treatment.&lt;SEP&gt;Stem cell rescue involves using chemotherapy to destroy cancer cells, followed by restoring the patient's stem cells to rebuild blood and immune systems.&lt;SEP&gt;Stem cell rescue involves removing, freezing, and then transplanting healthy stem cells back into the patient after chemotherapy to restore blood cell production.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Immunotherapy Drugs">
      <data key="d0">Immunotherapy Drugs</data>
      <data key="d1">concept</data>
      <data key="d2">Immunotherapy drugs are treatments that use the immune system to fight cancer, sometimes given with chemotherapy drugs.</data>
      <data key="d3">chunk-725b48dc82aad42ba3dc14f4b5207551</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Corticosteroids">
      <data key="d0">Corticosteroids</data>
      <data key="d1">method</data>
      <data key="d2">Corticosteroids are medications used long-term that can suppress immune function, thereby increasing cancer risk.&lt;SEP&gt;Steroids are drugs used to shrink lymphomas and reduce brain swelling, typically given temporarily in newly diagnosed patients.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Side Effects of Steroids">
      <data key="d0">Side Effects of Steroids</data>
      <data key="d1">concept</data>
      <data key="d2">Possible adverse effects include hunger, sleep trouble, mood changes, swelling, and increased blood sugar.</data>
      <data key="d3">chunk-725b48dc82aad42ba3dc14f4b5207551</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Blood Sugar Levels">
      <data key="d0">Blood Sugar Levels</data>
      <data key="d1">data</data>
      <data key="d2">Blood sugar levels can significantly increase due to steroid treatment, reflecting metabolic side effects.</data>
      <data key="d3">chunk-725b48dc82aad42ba3dc14f4b5207551</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Intraocular Chemotherapy">
      <data key="d0">Intraocular Chemotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Intraocular chemotherapy involves infusing drugs into the eye or vein to treat primary CNS lymphoma when it occurs in the eye.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Whole-Brain Radiation Therapy">
      <data key="d0">Whole-Brain Radiation Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Whole-brain radiation therapy involves administering radiation to the entire brain to treat primary CNS lymphoma.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Federal Reserve">
      <data key="d0">Federal Reserve</data>
      <data key="d1">organization</data>
      <data key="d2">The Federal Reserve is the central banking system of the United States, whose policy decisions influence investor confidence and market stability.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Systemic Therapies">
      <data key="d0">Systemic Therapies</data>
      <data key="d1">concept</data>
      <data key="d2">Systemic therapies are treatments that affect both cancer cells and normal cells, administered intravenously or orally, with various categories including chemotherapy, targeted therapy, and immunotherapy.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="EGFR">
      <data key="d0">EGFR</data>
      <data key="d1">concept</data>
      <data key="d2">The epidermal growth factor receptor (EGFR) is a protein on cell surfaces that causes cell division, and its inhibition can prevent cancer growth.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="Cetuximab">
      <data key="d0">Cetuximab</data>
      <data key="d1">content</data>
      <data key="d2">Cetuximab (Erbitux) is an EGFR inhibitor used to treat squamous cell skin cancer and other cancers.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560708</data>
      <data key="d6" />
    </node>
    <node id="PD-1 Inhibitors">
      <data key="d0">PD-1 Inhibitors</data>
      <data key="d1">concept</data>
      <data key="d2">PD-1 inhibitors are immune checkpoint inhibitors that stimulate the immune system to attack cancer cells, used in treating squamous cell skin cancer and other cancers.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Cemiplimab">
      <data key="d0">Cemiplimab</data>
      <data key="d1">content</data>
      <data key="d2">Cemiplimab (Libtayo) is a PD-1 inhibitor used for treating squamous cell skin cancer and other cancers.&lt;SEP&gt;Cemiplimab (Libtayo) is a targeted therapy option for certain cancers.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Lung and Breathing Problems">
      <data key="d0">Lung and Breathing Problems</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Lung and breathing problems such as cough, shortness of breath, and chest pain can be side effects of systemic therapy.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Organ Damage">
      <data key="d0">Organ Damage</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Damage to major organs including the liver and kidneys can result from systemic therapy.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="High Blood Pressure">
      <data key="d0">High Blood Pressure</data>
      <data key="d1">naturalobject</data>
      <data key="d2">High blood pressure is a serious side effect associated with systemic therapy.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Infertility">
      <data key="d0">Infertility</data>
      <data key="d1">concept</data>
      <data key="d2">Long-term side effect of systemic therapy involving potential loss of reproductive capability.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Phase 1">
      <data key="d0">Phase 1</data>
      <data key="d1">event</data>
      <data key="d2">Initial trial phase focusing on dosing, safety, and side effects of experimental treatments.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
      <data key="d6" />
    </node>
    <node id="Phase 2">
      <data key="d0">Phase 2</data>
      <data key="d1">event</data>
      <data key="d2">Trial phase that evaluates how well a treatment works against a specific cancer.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560709</data>
