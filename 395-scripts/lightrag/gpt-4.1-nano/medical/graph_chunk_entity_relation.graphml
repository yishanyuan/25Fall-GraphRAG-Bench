      <data key="d13" />
    </edge>
    <edge source="Hormones" target="Estrogen">
      <data key="d7">1.0</data>
      <data key="d8">Estrogen is primarily produced by ovaries and influences breast cancer growth; targeted by endocrine therapy.</data>
