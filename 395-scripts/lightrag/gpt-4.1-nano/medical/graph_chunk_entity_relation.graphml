    </edge>
    <edge source="Cancer" target="Sentinel Lymph Node">
      <data key="d7">2.0</data>
      <data key="d8">Sentinel lymph nodes are the first sites cancer cells tend to spread to from a primary tumor.&lt;SEP&gt;Biopsying the sentinel lymph node helps determine early spread of cancer via lymphatic system.</data>
      <data key="d9">monitoring,spread,spread pathway</data>
      <data key="d10">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561007</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Sentinel Lymph Nodes">
      <data key="d7">1.0</data>
      <data key="d8">Sentinel lymph node biopsies identify the first nodes that cancer cells are likely to spread to from the primary tumor.</data>
      <data key="d9">metastasis tracking</data>
      <data key="d10">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d11">unknown_source</data>
