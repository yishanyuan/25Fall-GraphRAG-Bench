    <node id="Standard Treatment">
      <data key="d0">Standard Treatment</data>
      <data key="d1">concept</data>
      <data key="d2">Mainstream cancer therapy that is usually covered by insurance, sometimes combined with experimental treatments in trials.&lt;SEP&gt;The commonly accepted medical treatment used as a comparison or control in clinical trials.&lt;SEP&gt;Accepted and established medical procedures used to treat cancer.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551</data>
