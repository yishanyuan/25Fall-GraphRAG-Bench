    </edge>
    <edge source="Alveoli" target="Oxygen">
      <data key="d7">1.0</data>
      <data key="d8">Oxygen is transferred from air into the blood in the alveoli, the sacs at the end of bronchioli.</data>
      <data key="d9">gas exchange,structural</data>
      <data key="d10">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
