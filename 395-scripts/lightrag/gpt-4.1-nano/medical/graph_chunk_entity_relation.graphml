      <data key="d1">location</data>
      <data key="d2">Infraclavicular nodes are lymph nodes located below the clavicle, involved in the spread of breast cancer.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560699</data>
