      <data key="d11">unknown_source</data>
      <data key="d12">1764561014</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Distress">
      <data key="d7">1.0</data>
      <data key="d8">A cancer diagnosis can cause emotional, mental, physical, social, or spiritual distress in affected individuals.</data>
