    <edge source="Pheochromocytoma" target="Adrenal Medulla">
      <data key="d7">1.0</data>
      <data key="d8">Pheochromocytoma begins in the adrenal medulla and produces excess catecholamines leading to symptoms like high blood pressure.</data>
