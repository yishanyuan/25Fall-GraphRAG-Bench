      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
      <data key="d2">Superficial treatments are used for early forms like Bowen’s disease and actinic keratoses.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560753</data>
      <data key="d6" />
    </node>
    <node id="Active Cancer Cells">
      <data key="d0">Active Cancer Cells</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
      <data key="d2">FDG-PET detects cancer cells based on their increased sugar consumption, appearing brighter in scans.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560756</data>
      <data key="d6" />
    </node>
