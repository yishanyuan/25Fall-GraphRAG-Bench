      <data key="d12">1764561046</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Blood Vessels">
      <data key="d7">1.0</data>
      <data key="d8">Cancer can spread into blood vessels, the liver, or structures outside the liver.</data>
      <data key="d9">spread_into</data>
