      <data key="d4">unknown_source</data>
      <data key="d5">1764561079</data>
      <data key="d6" />
    </node>
    <node id="Electrons">
      <data key="d0">Electrons</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
      <data key="d2">Electrons are used to treat superficial tumors in external beam radiation therapy.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561083</data>
      <data key="d6" />
    </node>
    <node id="Photons">
      <data key="d0">Photons</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
      <data key="d2">Photons are used in external beam radiation therapy to treat deeper, invasive tumors.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561084</data>
      <data key="d6" />
    </node>
    <node id="Recurrent Ovarian Cancer">
      <data key="d0">Recurrent Ovarian Cancer</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d2">Biomarkers like BRCA1/2, HRD, HER2, MSI, MMR, TMB, BRAF V600E, FRα, RET, and NTRK influence targeted treatment options.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561087</data>
      <data key="d6" />
    </node>
    <node id="Hypersensitivity Reactions">
      <data key="d0">Hypersensitivity Reactions</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d2">Risk of allergic reactions to carboplatin and cisplatin increases with repeat use.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561087</data>
      <data key="d6" />
    </node>
    <node id="Post-Surgery">
      <data key="d0">Post-Surgery</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
      <data key="d2">If no cancer is detected beyond the cervix, options after surgery include observation or EBRT with chemoradiation.&lt;SEP&gt;If no cancer or spread is detected after surgery, observation or EBRT with chemoradiation are treatment options.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561088</data>
      <data key="d6" />
    </node>
    <node id="Extrafascial (simple) hysterectomy">
      <data key="d0">Extrafascial (simple) hysterectomy</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
      <data key="d2">Extrafascial hysterectomy is commonly recommended for certain early-stage cervical cancers.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561089</data>
      <data key="d6" />
    </node>
    <node id="Overall">
      <data key="d0">Overall</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
      <data key="d2">Treatment options depend on cancer stage, spread, and patient preferences, including surgery, radiation, and chemoradiation.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561090</data>
      <data key="d6" />
    </node>
