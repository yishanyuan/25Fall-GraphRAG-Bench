      <data key="d0">Medicine</data>
      <data key="d1">concept</data>
      <data key="d2">A type of medicine called a sedative is used to help patients relax if they get nervous in enclosed spaces.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
