    <node id="LEF1">
      <data key="d0">LEF1</data>
      <data key="d1">content</data>
      <data key="d2">LEF1 is a marker protein found on CLL cells for identification.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
      <data key="d4">unknown_source</data>
