    </edge>
    <edge source="Smoking" target="Lung Cancer">
      <data key="d7">1.0</data>
      <data key="d8">Smoking or vaping nicotine is a major risk factor for developing lung cancer.</data>
      <data key="d9">causation,risk</data>
