    <node id="Breast Cancer Staging">
      <data key="d0">Breast Cancer Staging</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer staging is the process of assessing tumor extent, lymph node involvement, and metastasis to guide prognosis and treatment.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
      <data key="d6" />
    </node>
    <node id="TNM Score">
      <data key="d0">TNM Score</data>
      <data key="d1">method</data>
      <data key="d2">The TNM scoring system assesses tumor size (T), lymph node involvement (N), and metastasis (M) in cancer staging.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
      <data key="d6" />
