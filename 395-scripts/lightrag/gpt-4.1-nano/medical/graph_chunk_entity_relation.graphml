    <node id="Supraclavicular Nodes">
      <data key="d0">Supraclavicular Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Supraclavicular nodes are lymph nodes positioned above the clavicle that can be involved in advanced breast cancer.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560699</data>
      <data key="d6" />
    </node>
    <node id="GX">
      <data key="d0">GX</data>
      <data key="d1">concept</data>
      <data key="d2">GX means the tumor grade cannot be determined.</data>
