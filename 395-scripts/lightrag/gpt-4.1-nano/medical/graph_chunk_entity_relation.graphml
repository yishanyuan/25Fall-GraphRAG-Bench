      <data key="d12">1764561015</data>
      <data key="d13" />
    </edge>
    <edge source="NSCLC" target="Lung Cancer">
      <data key="d7">1.0</data>
      <data key="d8">NSCLC is the most common form of lung cancer, arising from airway lining cells.</data>
      <data key="d9">lung,type</data>
