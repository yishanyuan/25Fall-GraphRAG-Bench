    <node id="Carotid Artery">
      <data key="d0">Carotid Artery</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The carotid artery is a major blood vessel in the neck that supplies blood to the brain, neck, and face.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e</data>
