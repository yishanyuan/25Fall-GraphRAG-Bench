      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Stages">
      <data key="d7">1.0</data>
      <data key="d8">From early localized stages like 1A to advanced metastatic stages like 4B, cervical cancer progresses based on tumor growth and spread.</data>
      <data key="d9">progression</data>
      <data key="d10">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561081</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Lymphadenectomy">
      <data key="d7">1.0</data>
      <data key="d8">Lymphadenectomy is performed to assess the spread of cervical cancer.</data>
      <data key="d9">cancer staging,surgical intervention</data>
      <data key="d10">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561082</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="EBRT">
      <data key="d7">1.0</data>
      <data key="d8">EBRT is a key component of chemoradiation used to target the tumor externally.</data>
      <data key="d9">treatment</data>
      <data key="d10">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561082</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Brachytherapy">
      <data key="d7">1.0</data>
      <data key="d8">Brachytherapy involves placing radioactive sources inside or near the tumor for targeted internal radiation.</data>
      <data key="d9">internal radiation</data>
      <data key="d10">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561082</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Intracavitary Brachytherapy">
      <data key="d7">1.0</data>
      <data key="d8">A form of brachytherapy where radioactive sources are placed within body cavities close to the cervix and uterus.</data>
      <data key="d9">method</data>
      <data key="d10">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561082</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Interstitial Brachytherapy">
      <data key="d7">1.0</data>
      <data key="d8">Involves placing radioactive sources directly into tissues adjacent to or within the tumor for more advanced cancers.</data>
      <data key="d9">method</data>
      <data key="d10">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561082</data>
      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Treatment Duration">
      <data key="d7">1.0</data>
      <data key="d8">The duration of 7 to 8 weeks encompasses both EBRT and brachytherapy treatments for cervical cancer.</data>
