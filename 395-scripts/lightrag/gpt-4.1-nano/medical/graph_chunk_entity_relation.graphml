    <node id="Care Team Members">
      <data key="d0">Care Team Members</data>
      <data key="d1">organization</data>
      <data key="d2">Care team members include radiologists, pathologists, oncologists, surgeons, nurses, pharmacists, psychologists, social workers, dietitians, and researchers.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560700</data>
