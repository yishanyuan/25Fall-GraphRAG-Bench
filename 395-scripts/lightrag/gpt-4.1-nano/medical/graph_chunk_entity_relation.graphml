    </node>
    <node id="Cramping">
      <data key="d0">Cramping</data>
      <data key="d1">other</data>
      <data key="d2">A symptom of nerve damage, including muscle spasms related to oxaliplatin.</data>
      <data key="d3">chunk-c35816f05289661283f683145d9f395f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560605</data>
      <data key="d6" />
    </node>
    <node id="Pain">
