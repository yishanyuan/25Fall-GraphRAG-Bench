      <data key="d0">Anal Melanoma</data>
      <data key="d1">other</data>
      <data key="d2">Anal melanoma is a rare type of anal cancer originating from melanocytes.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
