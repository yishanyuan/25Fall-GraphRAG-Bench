      <data key="d0">ECOG (Eastern Cooperative Oncology Group)</data>
      <data key="d1">method</data>
      <data key="d2">ECOG is a performance status scale used to evaluate a person's level of activity and health in an oncology setting.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
