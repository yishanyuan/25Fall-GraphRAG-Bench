      <data key="d12">1764560821</data>
      <data key="d13" />
    </edge>
    <edge source="Bladder Cancer" target="Tests">
      <data key="d7">1.0</data>
      <data key="d8">Various tests are required to confirm diagnosis, determine extent, and plan treatment for bladder cancer.</data>
      <data key="d9">diagnosis</data>
