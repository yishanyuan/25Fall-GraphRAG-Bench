    <node id="Family Members or Relatives">
      <data key="d0">Family Members or Relatives</data>
      <data key="d1">other</data>
      <data key="d2">Family members or relatives who have or had prostate, breast, ovarian, or intestinal cancer are relevant for genetic risk assessment.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560672</data>
