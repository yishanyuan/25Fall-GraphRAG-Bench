      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
      <data key="d2">Gliomas invade normal brain tissue and often have vague borders, making complete removal difficult.&lt;SEP&gt;Gliomas often invade and blend into normal brain tissue, complicating treatment.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560781</data>
      <data key="d6" />
    </node>
    <node id="Gli seeing">
      <data key="d0">Gli seeing</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
      <data key="d2">Gliomas usually grow back after treatment, requiring continuous monitoring and additional therapy.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560782</data>
      <data key="d6" />
    </node>
