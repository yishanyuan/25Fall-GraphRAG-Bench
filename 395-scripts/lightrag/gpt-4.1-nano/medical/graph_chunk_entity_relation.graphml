      <data key="d12">1764561057</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Follow-up">
      <data key="d7">1.0</data>
      <data key="d8">Follow-up testing, such as colonoscopy, is conducted after treatment to detect cancer recurrence early.</data>
      <data key="d9">monitoring</data>
      <data key="d10">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764561057</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Biomarker">
      <data key="d7">1.0</data>
      <data key="d8">Biomarkers are used in cancer diagnosis, treatment monitoring, and assessing disease progression.</data>
      <data key="d9">monitoring</data>
