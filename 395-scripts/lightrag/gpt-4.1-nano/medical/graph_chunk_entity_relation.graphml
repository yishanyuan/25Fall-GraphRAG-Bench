      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
      <data key="d2">Glioblastomas are the most destructive and dangerous type of glioma, highly malignant.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560780</data>
      <data key="d6" />
    </node>
    <node id="Invasion">
