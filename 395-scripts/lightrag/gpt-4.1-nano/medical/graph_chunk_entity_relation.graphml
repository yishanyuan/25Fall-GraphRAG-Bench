      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
      <data key="d6" />
    </node>
    <node id="Contrast Agents">
      <data key="d0">Contrast Agents</data>
      <data key="d1">data</data>
      <data key="d2">Substances used in imaging techniques to improve image clarity and visibility of internal organs and tissues.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560698</data>
