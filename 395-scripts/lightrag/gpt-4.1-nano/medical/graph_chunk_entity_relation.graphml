    <node id="Abnormal Skin Growths">
      <data key="d0">Abnormal Skin Growths</data>
      <data key="d1">content</data>
      <data key="d2">Warts are abnormal skin growths caused by HPV infection that can develop on the anus or genitals.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
