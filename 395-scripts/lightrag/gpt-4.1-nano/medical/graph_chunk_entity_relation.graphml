    <node id="Direct Antiglobulin Test">
      <data key="d0">Direct Antiglobulin Test</data>
      <data key="d1">method</data>
      <data key="d2">Also known as Coombs’ test, used to detect immune-related red blood cell destruction.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560528</data>
