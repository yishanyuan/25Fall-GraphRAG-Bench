      <data key="d0">LVSI</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
      <data key="d2">Stage 1A1 cancers with LVSI are managed with modified radical hysterectomy and lymph node evaluation.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561091</data>
      <data key="d6" />
