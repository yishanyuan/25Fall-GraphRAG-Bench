    <node id="Core Biopsy">
      <data key="d0">Core Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">Involves removing tissue with a hollow needle for examination.&lt;SEP&gt;Uses a needle to remove a larger tissue sample, possibly with vacuum assistance.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560684</data>
      <data key="d6" />
    </node>
    <node id="Paracentesis">
      <data key="d0">Paracentesis</data>
      <data key="d1">method</data>
      <data key="d2">A technique involving a thin needle to extract fluid from the abdomen for testing.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560684</data>
