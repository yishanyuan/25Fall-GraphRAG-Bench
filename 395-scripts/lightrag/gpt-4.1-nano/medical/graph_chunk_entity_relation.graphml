      <data key="d13" />
    </edge>
    <edge source="Airways" target="Alveoli">
      <data key="d7">1.0</data>
      <data key="d8">Alveoli are sacs where oxygen transfer to blood occurs.</data>
      <data key="d9">gas exchange</data>
      <data key="d10">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
      <data key="d11">unknown_source</data>
