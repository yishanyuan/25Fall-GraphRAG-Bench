    <node id="PET CT">
      <data key="d0">PET CT</data>
      <data key="d1">procedure</data>
      <data key="d2">PET CT combines positron emission tomography with computed tomography to provide detailed images of metabolic activity and anatomy.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560683</data>
      <data key="d6" />
    </node>
    <node id="Diagnostic Laparoscopy">
      <data key="d0">Diagnostic Laparoscopy</data>
      <data key="d1">procedure</data>
      <data key="d2">A minimally invasive surgical procedure involving a small abdominal incision and a camera to assess the extent of cancer.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560683</data>
      <data key="d6" />
    </node>
    <node id="Laparoscope">
      <data key="d0">Laparoscope</data>
      <data key="d1">tool</data>
      <data key="d2">A thin tube with a light and camera used during laparoscopy to view abdominal organs and tissues for cancer assessment.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560683</data>
