    </edge>
    <edge source="Cancer" target="Recurrence">
      <data key="d7">1.0</data>
      <data key="d8">Recurrence is the return of cancer after a period of remission, either locally or in distant sites.</data>
      <data key="d9">Return of,after remission</data>
      <data key="d10">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
