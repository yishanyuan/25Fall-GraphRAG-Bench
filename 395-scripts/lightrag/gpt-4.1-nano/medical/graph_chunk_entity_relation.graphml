    <edge source="Neuroblastoma" target="Adrenal Gland">
      <data key="d7">1.0</data>
      <data key="d8">Neuroblastoma is a malignant adrenal tumor affecting children, with potential to spread to bones and other parts of the body.</data>
      <data key="d9">cancer,pediatric</data>
