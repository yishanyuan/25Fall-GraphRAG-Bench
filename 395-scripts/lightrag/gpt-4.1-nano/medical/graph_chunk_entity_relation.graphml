    </edge>
    <edge source="Cancer" target="Stage 1">
      <data key="d7">1.0</data>
      <data key="d8">Stage 1 involves invasion into the connective tissue of the bladder wall without reaching the muscle layer.</data>
      <data key="d9">early invasion</data>
