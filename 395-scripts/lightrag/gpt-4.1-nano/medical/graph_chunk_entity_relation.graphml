    <node id="Vital Signs">
      <data key="d0">Vital Signs</data>
      <data key="d1">method</data>
      <data key="d2">Measurements including blood pressure, heart rate, breathing rate, and body temperature.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
