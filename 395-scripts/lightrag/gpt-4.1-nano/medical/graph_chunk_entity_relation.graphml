      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d2">Physical exams are an essential part of surveillance after cervical cancer treatment.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561093</data>
      <data key="d6" />
    </node>
    <node id="Recurrent cervical cancer">
      <data key="d0">Recurrent cervical cancer</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d2">Biomarker testing is recommended to guide targeted therapy and clinical trial eligibility.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561093</data>
      <data key="d6" />
    </node>
