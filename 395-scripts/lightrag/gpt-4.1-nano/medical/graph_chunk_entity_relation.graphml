    </edge>
    <edge source="Adenoma" target="Adrenal Gland">
      <data key="d7">1.0</data>
      <data key="d8">Adenoma is a common benign adrenal tumor that may not produce hormones or symptoms, often manageable without extensive treatment.</data>
      <data key="d9">benign tumor,noncancerous</data>
      <data key="d10">chunk-7102a43dfb62e649d725bc95ba292688</data>
