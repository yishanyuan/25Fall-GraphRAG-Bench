    <node id="Prior radiation therapy">
      <data key="d0">Prior radiation therapy</data>
      <data key="d1">concept</data>
      <data key="d2">Having prior radiation therapy to the chest increases the risk of SCLC.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560553</data>
