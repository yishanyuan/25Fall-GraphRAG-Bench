    <node id="B Symptoms">
      <data key="d0">B Symptoms</data>
      <data key="d1">concept</data>
      <data key="d2">Symptoms such as fevers, night sweats, and weight loss associated with blood cancers like CLL.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560528</data>
      <data key="d6" />
