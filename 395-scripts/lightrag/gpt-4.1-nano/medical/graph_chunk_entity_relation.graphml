      <data key="d0">Recurrence detection</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d2">Imaging is used to identify tumor recurrence or spread when symptoms or findings suggest it.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561092</data>
      <data key="d6" />
