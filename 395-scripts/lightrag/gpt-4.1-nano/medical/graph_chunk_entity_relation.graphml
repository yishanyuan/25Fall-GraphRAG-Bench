    </node>
    <node id="Doctor Visits">
      <data key="d0">Doctor Visits</data>
      <data key="d1">method</data>
      <data key="d2">Patients are advised to bring someone or have support during medical appointments, including telehealth.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
      <data key="d4">unknown_source</data>
