    <node id="Test Results Access">
      <data key="d0">Test Results Access</data>
      <data key="d1">method</data>
      <data key="d2">Patients are encouraged to keep copies of test results and utilize online portals to access their medical information.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
      <data key="d4">unknown_source</data>
