      <data key="d4">unknown_source</data>
      <data key="d5">1764560684</data>
      <data key="d6" />
    </node>
    <node id="Hereditary Ovarian Cancer">
      <data key="d0">Hereditary Ovarian Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Ovarian cancer caused by inherited gene mutations, often occurring at a younger age.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
      <data key="d4">unknown_source</data>
