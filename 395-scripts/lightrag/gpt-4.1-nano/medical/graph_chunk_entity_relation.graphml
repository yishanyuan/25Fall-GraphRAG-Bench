    </edge>
    <edge source="Adrenal Gland Cancer" target="Signs And Symptoms">
      <data key="d7">1.0</data>
      <data key="d8">Symptoms such as weight gain, hormonal changes, and pain are caused by adrenal cancer and related tumor growth.</data>
      <data key="d9">disease progression,symptomatology</data>
