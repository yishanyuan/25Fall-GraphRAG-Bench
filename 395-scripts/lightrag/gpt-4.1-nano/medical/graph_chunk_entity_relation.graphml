      <data key="d13" />
    </edge>
    <edge source="Hormones" target="Adrenal Cortex">
      <data key="d7">1.0</data>
      <data key="d8">The adrenal cortex produces cortisol, aldosterone, and DHEA, which regulate metabolism, blood pressure, and other functions.</data>
