      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d2">Biomarkers such as MMR, MSI, TMB, NTRK fusion, HER2, and RET can inform treatment options.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561094</data>
      <data key="d6" />
    </node>
