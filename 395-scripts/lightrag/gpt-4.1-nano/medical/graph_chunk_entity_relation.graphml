      <data key="d0">Cells with SSTR</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
      <data key="d2">SSTR-PET uses tracers that bind to somatostatin receptors on certain tumor cells.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560756</data>
      <data key="d6" />
