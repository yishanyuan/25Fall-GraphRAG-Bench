      <data key="d1">person</data>
      <data key="d2">Provides clinical care, manages side effects, and supports patients through treatment.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
