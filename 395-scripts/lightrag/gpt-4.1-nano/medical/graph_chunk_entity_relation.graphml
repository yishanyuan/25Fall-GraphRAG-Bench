      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">Vitamin B12 helps the body make new proteins and is necessary for blood cell formation.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561069</data>
      <data key="d6" />
    </node>
    <node id="Hemoglobin and Body Functions">
      <data key="d0">Hemoglobin and Body Functions</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">Iron is essential for hemoglobin production and maintaining normal body functions.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561069</data>
      <data key="d6" />
    </node>
    <node id="Sampling">
      <data key="d0">Sampling</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">Bone marrow samples are taken for diagnosing leukemia via aspirate or biopsy.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561070</data>
      <data key="d6" />
    </node>
    <node id="Cell Analysis">
      <data key="d0">Cell Analysis</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">Flow cytometry detects and identifies cell types, especially in the immune system.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561070</data>
      <data key="d6" />
    </node>
    <node id="Transplant Compatibility">
      <data key="d0">Transplant Compatibility</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">HLA proteins on cell surfaces are used to match donors and recipients for hematopoietic cell transplants.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561070</data>
      <data key="d6" />
    </node>
    <node id="Donor Matching">
      <data key="d0">Donor Matching</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">HLA typing is performed to find a compatible donor for transplant, comparing HLA proteins.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561071</data>
      <data key="d6" />
    </node>
    <node id="Other Cancers">
      <data key="d0">Other Cancers</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
      <data key="d2">High-risk HPV strains can also cause anal, head and neck, penile, vaginal, and vulvar cancers.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561071</data>
      <data key="d6" />
    </node>
    <node id="Blood Cancer Detection">
      <data key="d0">Blood Cancer Detection</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
      <data key="d2">Flow cytometry detects specific cell markers in blood or bone marrow to identify blood cancers.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561071</data>
      <data key="d6" />
    </node>
    <node id="CIN">
      <data key="d0">CIN</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
      <data key="d2">Long-term HPV infection can lead to cervical intraepithelial neoplasia, which may progress to cancer if untreated.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561072</data>
      <data key="d6" />
    </node>
    <node id="Early Cervical Cancer">
      <data key="d0">Early Cervical Cancer</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
      <data key="d2">Cone biopsy may be sufficient as a sole treatment for early-stage cervical cancer.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561072</data>
      <data key="d6" />
    </node>
    <node id="General Health">
      <data key="d0">General Health</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
      <data key="d2">Blood tests help evaluate organ function and overall health status before treatment.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561072</data>
      <data key="d6" />
    </node>
    <node id="Extent of Cancer">
      <data key="d0">Extent of Cancer</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
      <data key="d2">Imaging techniques like CT, PET/CT, and MRI help determine the size and spread of cervical cancer.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561074</data>
      <data key="d6" />
    </node>
    <node id="Smokers">
      <data key="d0">Smokers</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
      <data key="d2">Almost all individuals with SCLC have smoked or are exposed to tobacco smoke.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561076</data>
      <data key="d6" />
    </node>
    <node id="Tissues">
      <data key="d0">Tissues</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">MRI produces high-resolution images of soft tissues like the uterus, cervix, and vagina without radiation.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561076</data>
      <data key="d6" />
    </node>
    <node id="Combined Small and Non-Small Cell Lung Carcinoma">
      <data key="d0">Combined Small and Non-Small Cell Lung Carcinoma</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
      <data key="d2">Both small cell and non-small cell lung cancer cells, treated as small cell lung cancer.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561077</data>
      <data key="d6" />
    </node>
    <node id="&gt;Surrogacy">
      <data key="d0">&gt;Surrogacy</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">Using frozen eggs or embryos with surrogates enables future pregnancy options when natural conception is not possible.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561077</data>
      <data key="d6" />
    </node>
    <node id="Bladder, Bowel">
      <data key="d0">Bladder, Bowel</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">EUAs like cystoscopy and proctoscopy evaluate the bladder and bowel for signs of cancer while under anesthesia.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561077</data>
      <data key="d6" />
    </node>
    <node id="Eggs or Embryos">
      <data key="d0">Eggs or Embryos</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">Using frozen eggs or embryos with surrogates enables future pregnancy options when natural conception is not possible.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561078</data>
      <data key="d6" />
    </node>
    <node id="bladder">
      <data key="d0">bladder</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">EUAs such as cystoscopy evaluate the bladder under anesthesia for signs of cancer spreading or abnormalities.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561078</data>
      <data key="d6" />
    </node>
    <node id="Surrogacy">
      <data key="d0">Surrogacy</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
      <data key="d2">Cryopreserved eggs or embryos can be used with a surrogate for future pregnancy.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561078</data>
      <data key="d6" />
    </node>
    <node id="treatments">
      <data key="d0">treatments</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
      <data key="d2">Advances in treatments have improved outcomes compared to past.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764561078</data>
      <data key="d6" />
    </node>
