      <data key="d0">Scars and Wounds</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
      <data key="d2">Chronic scars and non-healing wounds can develop into squamous cell carcinoma, known as Marjolin’s ulcer.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560757</data>
      <data key="d6" />
    </node>
