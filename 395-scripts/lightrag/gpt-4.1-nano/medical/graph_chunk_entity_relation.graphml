    <node id="HPV-HPV">
      <data key="d0">HPV-HPV</data>
      <data key="d1">concept</data>
      <data key="d2">Another high-risk strain of HPV associated with anal and related cancers.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560583</data>
