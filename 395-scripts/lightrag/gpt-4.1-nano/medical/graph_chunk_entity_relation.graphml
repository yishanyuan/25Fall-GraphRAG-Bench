    <node id="HPV16">
      <data key="d0">HPV16</data>
      <data key="d1">concept</data>
      <data key="d2">HPV16 is a high-risk HPV type responsible for about 90% of throat cancers related to HPV.&lt;SEP&gt;HPV16 is a high-risk strain of human papillomavirus associated with increased risk of anal cancer.&lt;SEP&gt;HPV16 is a high-risk strain of human papillomavirus associated with increased likelihood of anal cancer.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560581</data>
      <data key="d6" />
