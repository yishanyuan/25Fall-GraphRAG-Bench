    <node id="Testicular Cancer">
      <data key="d0">Testicular Cancer</data>
      <data key="d1">other</data>
      <data key="d2">Testicular cancer is a type of cancer affecting the testicles, which can be diagnosed through various tests and staging procedures.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560749</data>
      <data key="d6" />
    </node>
    <node id="Sharing Decisions">
      <data key="d0">Sharing Decisions</data>
      <data key="d1">concept</data>
      <data key="d2">Sharing decisions involves collaborative discussions between patients and treatment teams to plan cancer care.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560749</data>
      <data key="d6" />
    </node>
    <node id="Specialist">
      <data key="d0">Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A specialist is a medical doctor with expertise in a particular type of bone cancer and is recommended for accurate diagnosis and treatment.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
