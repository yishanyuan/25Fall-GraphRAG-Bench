      <data key="d12">1764560915</data>
      <data key="d13" />
    </edge>
    <edge source="Blood Stem Cells" target="Blood Transfusion">
      <data key="d7">1.0</data>
      <data key="d8">Blood stem cells are transfused into the patient to facilitate the growth of new blood cells after chemotherapy.</data>
      <data key="d9">regeneration,transplant</data>
