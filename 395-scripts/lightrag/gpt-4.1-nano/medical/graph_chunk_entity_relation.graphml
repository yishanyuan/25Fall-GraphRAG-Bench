      <data key="d4">unknown_source</data>
      <data key="d5">1764560604</data>
      <data key="d6" />
    </node>
    <node id="Diarrhea">
      <data key="d0">Diarrhea</data>
      <data key="d1">other</data>
      <data key="d2">A gastrointestinal side effect of radiation therapy.&lt;SEP&gt;A gastrointestinal side effect of chemotherapy involving frequent loose stools.</data>
