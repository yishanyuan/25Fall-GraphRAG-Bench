      <data key="d11">unknown_source</data>
      <data key="d12">1764560839</data>
      <data key="d13" />
    </edge>
    <edge source="Cancer" target="Stage 0">
      <data key="d7">1.0</data>
      <data key="d8">Stage 0 bladder cancer is confined to the inner lining and has not invaded deeper tissues.</data>
      <data key="d9">early stage</data>
      <data key="d10">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
