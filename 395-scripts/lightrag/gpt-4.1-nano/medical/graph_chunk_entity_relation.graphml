    <node id="Health Care Team">
      <data key="d0">Health Care Team</data>
      <data key="d1">organization</data>
      <data key="d2">A group of medical professionals involved in diagnosing, treating, and supporting patients with liver cancer.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
