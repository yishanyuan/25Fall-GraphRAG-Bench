      <data key="d13" />
    </edge>
    <edge source="Cervical Cancer" target="Transformation Zone">
      <data key="d7">1.0</data>
      <data key="d8">Most cervical cancers originate in the transformation zone where the ectocervix and endocervix meet.</data>
      <data key="d9">origin</data>
      <data key="d10">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
