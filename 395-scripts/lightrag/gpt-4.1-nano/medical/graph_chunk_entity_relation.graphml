      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
      <data key="d2">Non-alcoholic fatty liver disease contributes to cirrhosis and subsequent liver cancer risk.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560764</data>
      <data key="d6" />
    </node>
