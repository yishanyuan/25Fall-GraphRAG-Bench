      <data key="d11">unknown_source</data>
      <data key="d12">1764561043</data>
      <data key="d13" />
    </edge>
    <edge source="Smoking" target="Anal Cancer">
      <data key="d7">2.0</data>
      <data key="d8">Smoking is associated with increased risk possibly due to immune suppression.&lt;SEP&gt;Smoking contributes to the risk of developing anal cancer.</data>
      <data key="d9">lifestyle,raises,risk factor</data>
      <data key="d10">chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764560859</data>
      <data key="d13" />
    </edge>
    <edge source="Smoking" target="Cancer Risk">
      <data key="d7">1.0</data>
      <data key="d8">Smoking increases the risk of head, neck, lung, and other cancers and can impair treatment outcomes.</data>
      <data key="d9">cancer development,health risk</data>
      <data key="d10">chunk-3d609bd1a55d409470c55ad55e2d125d</data>
      <data key="d11">unknown_source</data>
      <data key="d12">1764560935</data>
      <data key="d13" />
    </edge>
    <edge source="Smoking" target="Nicotine">
      <data key="d7">2.0</data>
      <data key="d8">Nicotine increases the likelihood of treatment complications and secondary cancers in smokers.&lt;SEP&gt;Nicotine is the addictive chemical in tobacco that promotes smoking and vaping behaviors.</data>
      <data key="d9">addiction,chemical</data>
      <data key="d10">chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
