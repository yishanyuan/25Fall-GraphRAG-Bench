      <data key="d1">person</data>
      <data key="d2">Operators of mammogram, MRI, and ultrasound machines.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Advanced Practice Providers">
      <data key="d0">Advanced Practice Providers</data>
      <data key="d1">organization</data>
      <data key="d2">Includes nurse practitioners, physician assistants, and certified nurse midwives who assist in prevention, evaluation, examination, and diagnosis.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Obstetrician">
      <data key="d0">Obstetrician</data>
      <data key="d1">person</data>
      <data key="d2">Specializes in pregnancy and childbirth.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Primary Care Provider">
      <data key="d0">Primary Care Provider</data>
      <data key="d1">organization</data>
      <data key="d2">A physician or provider who offers wide-ranging care including prevention and treatment.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Ducts">
      <data key="d0">Ducts</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Ducts carry breast milk from lobules to the nipple, playing a crucial role in milk transportation.&lt;SEP&gt;Small tubes that carry milk from lobules to the nipple.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Invasive Ductal Carcinoma">
      <data key="d0">Invasive Ductal Carcinoma</data>
      <data key="d1">other</data>
      <data key="d2">A common type of breast cancer that originates in the milk ducts and has spread into surrounding tissue.&lt;SEP&gt;Invasive ductal carcinoma is a common type of breast cancer originating in milk duct cells and capable of spreading.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Carcinoma">
      <data key="d0">Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">Cancer that starts in the inner or outer surface cells of the body.&lt;SEP&gt;Carcinoma, also called cancer, starts in the nasopharynx and involves abnormal cell growth, with staging information based on tumor size and invasion depth.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Inflammatory Breast Cancer">
      <data key="d0">Inflammatory Breast Cancer</data>
      <data key="d1">other</data>
      <data key="d2">Inflammatory breast cancer (IBC) is a type of breast cancer where cancer cells block lymph vessels in the skin of the breast, causing redness, swelling, and warmth.&lt;SEP&gt;Rare, aggressive breast cancer characterized by blocked lymph vessels causing redness, swelling, warmth, and skin changes.&lt;SEP&gt;A treatable form of breast cancer that may involve local and systemic therapies.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560689</data>
      <data key="d6" />
    </node>
    <node id="Peau dorange">
      <data key="d0">Peau dorange</data>
      <data key="d1">content</data>
      <data key="d2">Pitted or dimpled skin appearance characteristic of inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Skin Thickening">
      <data key="d0">Skin Thickening</data>
      <data key="d1">content</data>
      <data key="d2">Orange-peel texture of the breast skin found in inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Edema">
      <data key="d0">Edema</data>
      <data key="d1">content</data>
      <data key="d2">Swelling caused by excess fluid, common in inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Erythema">
      <data key="d0">Erythema</data>
      <data key="d1">content</data>
      <data key="d2">Redness of skin, often patches, associated with inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Breast Tissue">
      <data key="d0">Breast Tissue</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Includes glands, fat, nerves, vessels, ligaments, and connective tissue.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Breast Milk">
      <data key="d0">Breast Milk</data>
      <data key="d1">concept</data>
      <data key="d2">Breast milk is produced through structures within the breast, specifically ducts and lobules, and is essential for infant nutrition.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Surgeon">
      <data key="d0">Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A surgeon diagnosed the patient with inflammatory breast cancer after multiple office visits.&lt;SEP&gt;A surgeon performs procedures such as thyroidectomy to remove the thyroid gland or cancerous tissues.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Nurse">
      <data key="d0">Nurse</data>
      <data key="d1">person</data>
      <data key="d2">A nurse is involved in the care process but is not aware that breast cancer can occur without a lump.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Medical Record">
      <data key="d0">Medical Record</data>
      <data key="d1">content</data>
      <data key="d2">Organizing blood tests, imaging results, reports, and treatment history in a binder or digital file aids in ongoing care and second opinions.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Clinical Breast Exam">
      <data key="d0">Clinical Breast Exam</data>
      <data key="d1">method</data>
      <data key="d2">A physical exam performed by a healthcare provider to detect lumps or changes in the breasts.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Estrogen Receptor (ER)">
      <data key="d0">Estrogen Receptor (ER)</data>
      <data key="d1">concept</data>
      <data key="d2">Estrogen Receptor testing assesses hormone receptor presence, influencing treatment decisions.&lt;SEP&gt;A receptor that responds to estrogen and influences breast cancer cell proliferation.&lt;SEP&gt;Estrogen receptors are proteins that bind estrogen; targeted by ER modulators and SERDs.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Progesterone Receptor (PR)">
      <data key="d0">Progesterone Receptor (PR)</data>
      <data key="d1">other</data>
      <data key="d2">Progesterone Receptor testing assesses hormone receptor presence, influencing treatment decisions.&lt;SEP&gt;A receptor that responds to progesterone and influences breast cancer cell growth.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="X-Ray">
      <data key="d0">X-Ray</data>
      <data key="d1">method</data>
      <data key="d2">An x-ray uses low-dose radiation to produce images of bones and detect abnormalities or tumors.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Breast MRI">
      <data key="d0">Breast MRI</data>
      <data key="d1">method</data>
      <data key="d2">An MRI of the breast, often with contrast, used to investigate breast tumors and details missed in mammograms.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Spine MRI">
      <data key="d0">Spine MRI</data>
      <data key="d1">method</data>
      <data key="d2">An MRI to detect breast cancer metastasis to the spine, using a device around the head or no device for spinal imaging.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Brain MRI">
      <data key="d0">Brain MRI</data>
      <data key="d1">method</data>
      <data key="d2">Imaging procedure with contrast to investigate leukemic meningitis.&lt;SEP&gt;MRI focused on the brain to detect metastasis or other conditions, with a device around the head.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560690</data>
      <data key="d6" />
    </node>
    <node id="Sodium Fluoride PET-CT">
      <data key="d0">Sodium Fluoride PET-CT</data>
      <data key="d1">method</data>
      <data key="d2">A specialized PET-CT scan using sodium fluoride as a tracer for bone imaging, alternative to bone scan.&lt;SEP&gt;A sodium fluoride PET-CT uses sodium fluoride as a radiotracer and may replace bone scans to detect bone-related abnormalities.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="IntraVenous (IV) Contrast">
      <data key="d0">IntraVenous (IV) Contrast</data>
      <data key="d1">content</data>
      <data key="d2">An injectable contrast agent used during CT and MRI scans to enhance image clarity and detail.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Enclosed MRI">
      <data key="d0">Enclosed MRI</data>
      <data key="d1">method</data>
      <data key="d2">A type of MRI that has a capsule-like design surrounding the patient, often used for patients with claustrophobia.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Metastasize">
      <data key="d0">Metastasize</data>
      <data key="d1">concept</data>
      <data key="d2">The process by which cancer spreads from an original site to other parts of the body, such as the spine or brain.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Intravenous (IV)">
      <data key="d0">Intravenous (IV)</data>
      <data key="d1">method</data>
      <data key="d2">A route of administering contrast agents or tracers directly into a vein for imaging procedures.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Tirbanibulin">
      <data key="d0">Tirbanibulin</data>
      <data key="d1">method</data>
      <data key="d2">Tirbanibulin (Klisyri) is a microtubule inhibitor applied topically to treat actinic keratosis, working by killing fast-growing abnormal cells.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Hyperkeratosis">
      <data key="d0">Hyperkeratosis</data>
      <data key="d1">other</data>
      <data key="d2">Hyperkeratosis is the thickening of the outer layer of skin, which may be softened or broken down before actinic keratosis treatment.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Tazarotene">
      <data key="d0">Tazarotene</data>
      <data key="d1">content</data>
      <data key="d2">Tazarotene is a topical retinoid derived from vitamin A, used in treating actinic keratosis and related skin conditions.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560691</data>
      <data key="d6" />
    </node>
    <node id="Curettage">
      <data key="d0">Curettage</data>
      <data key="d1">method</data>
      <data key="d2">Curettage involves scraping away abnormal skin using a spoon-shaped tool as a treatment for actinic keratosis.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Topical Keratolytics">
      <data key="d0">Topical Keratolytics</data>
      <data key="d1">content</data>
      <data key="d2">Topical keratolytics such as urea, lactic acid, or salicylic acid are used to treat actinic keratosis by softening and removing thickened skin.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Diclofenac">
      <data key="d0">Diclofenac</data>
      <data key="d1">content</data>
      <data key="d2">Diclofenac is a topical medication sometimes used for actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Chemical Peels">
      <data key="d0">Chemical Peels</data>
      <data key="d1">method</data>
      <data key="d2">Chemical peels involve applying trichloroacetic acid to remove sun-damaged skin and treat actinic keratosis.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Laser">
      <data key="d0">Laser</data>
      <data key="d1">method</data>
      <data key="d2">Laser therapy is a resurfacing technique used to treat actinic keratosis and skin irregularities.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Dermabrasion">
      <data key="d0">Dermabrasion</data>
      <data key="d1">method</data>
      <data key="d2">Dermabrasion is a skin resurfacing procedure used for treating actinic keratosis.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Mohs Surgery">
      <data key="d0">Mohs Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Mohs surgery involves removing skin cancer with immediate microscopic examination to ensure complete removal while sparing normal tissue.&lt;SEP&gt;Mohs surgery is a precise surgical technique often attempted first for treating CSCC, especially high-risk cases.&lt;SEP&gt;Mohs surgery is a precise surgical technique used for high-risk and very high-risk cancers, removing tissue layer by layer to ensure complete removal.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Curettage and Electrodesiccation">
      <data key="d0">Curettage and Electrodesiccation</data>
      <data key="d1">method</data>
      <data key="d2">Curettage and electrodesiccation (C&amp;E) involves scraping and burning to remove basal or squamous cell skin cancers.&lt;SEP&gt;Curettage and electrodesiccation is a procedure used to remove early, small, surface tumors like low-risk CSCC.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Excision">
      <data key="d0">Excision</data>
      <data key="d1">method</data>
      <data key="d2">Standard surgical excision involves cutting out the tumor with a margin of normal tissue under local anesthesia.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Sentinel Lymph Node">
      <data key="d0">Sentinel Lymph Node</data>
      <data key="d1">location</data>
      <data key="d2">A sentinel lymph node is the first lymph node to which cancer cells most likely spread from a primary tumor. Sometimes, there is more than one sentinel lymph node.&lt;SEP&gt;The sentinel lymph node is the first lymph node to which cancer cells are most likely to spread from a primary tumor.&lt;SEP&gt;Sentinel lymph nodes are the first nodes to receive lymphatic drainage from a primary tumor and are identified during surgery for cancer staging.&lt;SEP&gt;The first lymph node or nodes that are most likely to contain cancer cells from a primary tumor.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Sentinel Lymph Node Biopsy">
      <data key="d0">Sentinel Lymph Node Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A sentinel lymph node biopsy (SLNB) is a surgical procedure that removes tissue samples to examine sentinel nodes for cancer cells.&lt;SEP&gt;Sentinel lymph node biopsy (SLNB) involves removing and examining tissue samples from sentinel nodes to detect cancer spread.&lt;SEP&gt;A diagnostic procedure that identifies the first lymph nodes likely to contain cancer spread using dye and radioactive solution.&lt;SEP&gt;A surgical procedure involving the removal of sentinel lymph nodes to determine if cancer has spread.&lt;SEP&gt;A surgical procedure to remove sentinel lymph nodes to determine if cancer has spread.&lt;SEP&gt;A procedure involving injection of dye or radioactive substance to identify and remove sentinel lymph nodes for cancer testing.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="National Library of Medicine">
      <data key="d0">National Library of Medicine</data>
      <data key="d1">organization</data>
      <data key="d2">The National Library of Medicine (NLM) hosts the clinicaltrials.gov database for searching clinical trials worldwide.&lt;SEP&gt;NLM is a U.S. federal institution listing clinical trials worldwide through its registry.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Standard Cancer Care">
      <data key="d0">Standard Cancer Care</data>
      <data key="d1">content</data>
      <data key="d2">Standard cancer care refers to the routine treatments (such as surgery, radiation, systemic therapy) provided to patients during clinical trials and outside of trials.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Surgical Options">
      <data key="d0">Surgical Options</data>
      <data key="d1">content</data>
      <data key="d2">Surgical options for squamous cell skin cancer include curettage and electrodesiccation, PDEMA/Mohs surgery, and standard surgical excision.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="High-Risk or Very High-Risk Squamous Cell Skin Cancer">
      <data key="d0">High-Risk or Very High-Risk Squamous Cell Skin Cancer</data>
      <data key="d1">other</data>
      <data key="d2">High-risk or very high-risk SCCs have increased risk of recurrence and metastasis, influencing their treatment approach.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Tumor Location">
      <data key="d0">Tumor Location</data>
      <data key="d1">content</data>
      <data key="d2">The location of a tumor (e.g., head, neck, trunk, arms, legs, sex organs) influences its risk classification and treatment plan.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560692</data>
      <data key="d6" />
    </node>
    <node id="Tumor Border">
      <data key="d0">Tumor Border</data>
      <data key="d1">content</data>
      <data key="d2">The tumor border’s definition (well-defined vs. uneven shape) helps determine risk category.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Tumor Recurrence">
      <data key="d0">Tumor Recurrence</data>
      <data key="d1">content</data>
      <data key="d2">Recurrence refers to the return of cancer after treatment, which elevates the tumor’s risk level.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Tumor in Damaged Skin">
      <data key="d0">Tumor in Damaged Skin</data>
      <data key="d1">other</data>
      <data key="d2">Tumors originating in previously irradiated or damaged skin are classified as high-risk.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Perineural Invasion">
      <data key="d0">Perineural Invasion</data>
      <data key="d1">other</data>
      <data key="d2">Invasion into nerves (perineural invasion) indicates a high or very high risk of aggressive disease.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Tumor Type">
      <data key="d0">Tumor Type</data>
      <data key="d1">content</data>
      <data key="d2">The specific type of squamous cell carcinoma influences diagnosis, prognosis, and treatment options.&lt;SEP&gt;Tumor type refers to the specific classification of cancer based on tissue origin and subtype, determined through biopsy analysis.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Wound">
      <data key="d0">Wound</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A wound is an injury requiring healing procedures, which can include natural healing, linear closure, skin grafts, or flapping.&lt;SEP&gt;A wound is an area of damaged or inflamed skin, which may be a site for tumor development if cancer originates there.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Scar">
      <data key="d0">Scar</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A scar is tissue that forms after skin injury or treatment, where tumors may sometimes originate, classified as high-risk.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="Nerve">
      <data key="d0">Nerve</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Nerves are part of the nervous system; invasion of nerves by tumor indicates high-risk or very high-risk cancer with potential nerve damage symptoms.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560693</data>
      <data key="d6" />
    </node>
    <node id="PET Scanner">
      <data key="d0">PET Scanner</data>
      <data key="d1">device</data>
      <data key="d2">A PET scanner is a medical imaging device used to detect bright spots indicating metabolic activity or abnormalities in the body, such as inflammation or infection.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="Infection">
      <data key="d0">Infection</data>
      <data key="d1">concept</data>
      <data key="d2">Infection is not explicitly mentioned but could be inferred as an adverse effect relevant to immune suppression or side effects.&lt;SEP&gt;Infection can also appear as a bright spot on PET scans, similar to inflammation.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="PET-CT Scan">
      <data key="d0">PET-CT Scan</data>
      <data key="d1">method</data>
      <data key="d2">A PET-CT scan combines PET and CT imaging technologies for more detailed visualization and can be performed with one or two machines depending on the cancer center.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="FDG PET-CT">
      <data key="d0">FDG PET-CT</data>
      <data key="d1">method</data>
      <data key="d2">FDG PET-CT uses F-18 fluorodeoxyglucose, a radiotracer made of fluoride and glucose, helping detect cancer, especially when other imaging results are unclear.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="FES PET-CT">
      <data key="d0">FES PET-CT</data>
      <data key="d1">method</data>
      <data key="d2">FES PET-CT uses a radioactive form of estrogen for detecting estrogen receptor-positive cancer.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="Fine-needle Aspiration">
      <data key="d0">Fine-needle Aspiration</data>
      <data key="d1">method</data>
      <data key="d2">Uses a thin needle to remove a tissue or fluid sample from a tumor or lymph node.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="Vacuum-Assisted Core Biopsy">
      <data key="d0">Vacuum-Assisted Core Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">Uses suction and a vacuum device to remove tissue samples during biopsy.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="Metal Clips">
      <data key="d0">Metal Clips</data>
      <data key="d1">artifact</data>
      <data key="d2">Small metallic markers placed during biopsy to mark the biopsy site for future imaging or surgery.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560694</data>
      <data key="d6" />
    </node>
    <node id="Axillary Lymph Node">
      <data key="d0">Axillary Lymph Node</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes near the armpit involved in draining lymph fluid from the breast.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Axillary Lymph Node Biopsy">
      <data key="d0">Axillary Lymph Node Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">Biopsy of lymph nodes near the armpit using ultrasound-guided needle techniques to detect cancer spread.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Treatment Regimen">
      <data key="d0">Treatment Regimen</data>
      <data key="d1">concept</data>
      <data key="d2">A standard or experimental therapy plan based on clinical trials or guidelines to treat specific diseases.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Biopsy Site">
      <data key="d0">Biopsy Site</data>
      <data key="d1">location</data>
      <data key="d2">The specific area of tissue sampling, including breast, lymph nodes, or other tissues, used for cancer diagnosis.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Dye">
      <data key="d0">Dye</data>
      <data key="d1">content</data>
      <data key="d2">A dye used in surgery to identify sentinel lymph nodes by traveling through lymphatics to make the nodes visible during biopsy.&lt;SEP&gt;A dye used in sentinel lymph node biopsy to visualize lymph nodes containing the substance.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Radioactive Material">
      <data key="d0">Radioactive Material</data>
      <data key="d1">content</data>
      <data key="d2">A radioactive substance injected to help locate sentinel lymph nodes during biopsy.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Hormone">
      <data key="d0">Hormone</data>
      <data key="d1">concept</data>
      <data key="d2">Hormones are substances produced by glands that regulate various body functions and can influence cancer growth.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Receptor">
      <data key="d0">Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">A protein found on or inside cells that binds with hormones and influences cellular activities.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Progesterone">
      <data key="d0">Progesterone</data>
      <data key="d1">concept</data>
      <data key="d2">A hormone involved in menstrual cycle and pregnancy, relevant in breast cancer receptor status.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor">
      <data key="d0">Hormone Receptor</data>
      <data key="d1">concept</data>
      <data key="d2">Proteins on or inside cells that bind hormones like estrogen and progesterone, affecting cancer growth.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor-Positive">
      <data key="d0">Hormone Receptor-Positive</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancers with detectable estrogen or progesterone receptors, often treatable with endocrine therapy.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="Hormone Receptor-Negative">
      <data key="d0">Hormone Receptor-Negative</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancers lacking estrogen and progesterone receptors, often growing faster and not responding to endocrine therapy.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="HER2">
      <data key="d0">HER2</data>
      <data key="d1">concept</data>
      <data key="d2">HER2 expression is a biomarker used to inform targeted treatment strategies in ovarian cancer.&lt;SEP&gt;A protein involved in cell growth; overexpression can lead to aggressive breast cancer.&lt;SEP&gt;A protein that can be overexpressed in some cancers, influencing prognosis and treatment options.&lt;SEP&gt;HER2 is a protein involved in cell growth, with higher levels indicating HER2-positive breast cancer.&lt;SEP&gt;HER2 is a protein receptor; PARP inhibitors are considered for HER2-negative breast cancer.&lt;SEP&gt;HER2 gene status can be tested as a biomarker in cervical cancer.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="HER2-Positive">
      <data key="d0">HER2-Positive</data>
      <data key="d1">concept</data>
      <data key="d2">Breast cancer with high levels of HER2 proteins, often associated with increased cell division.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="HER2 Test">
      <data key="d0">HER2 Test</data>
      <data key="d1">method</data>
      <data key="d2">A diagnostic test measuring HER2 protein levels on cancer cells, including Immunohistochemistry (IHC) and in situ hybridization (ISH).</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="In Situ Hybridization">
      <data key="d0">In Situ Hybridization</data>
      <data key="d1">method</data>
      <data key="d2">A test counting copies of the HER2 gene, mainly used when IHC results are unclear.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560695</data>
      <data key="d6" />
    </node>
    <node id="BRCA">
      <data key="d0">BRCA</data>
      <data key="d1">content</data>
      <data key="d2">A gene associated with increased risk of breast and ovarian cancer; tested as part of molecular profiling.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Infiltrated Lymph Node">
      <data key="d0">Infiltrated Lymph Node</data>
      <data key="d1">location</data>
      <data key="d2">Lymph nodes that contain cancer cells, often assessed during biopsy and testing.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Tissue">
      <data key="d0">Tissue</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Tissue refers to groups of cells that perform specific functions, involved in wound healing and affected by radiation therapy.&lt;SEP&gt;A group of cells working together, examined histologically to identify cancer presence.&lt;SEP&gt;Tissue refers to the layers of cells removed during biopsies and cone procedures to diagnose and treat cervical cancer.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Antibodies">
      <data key="d0">Antibodies</data>
      <data key="d1">method</data>
      <data key="d2">Antibodies are immune proteins used in immunophenotyping to detect specific antigens on cells.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Deletion">
      <data key="d0">Deletion</data>
      <data key="d1">mutation</data>
      <data key="d2">Deletion is when part of a chromosome or gene is missing, such as del(5q).</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Insertion">
      <data key="d0">Insertion</data>
      <data key="d1">mutation</data>
      <data key="d2">Insertion involves adding a segment of DNA into a gene or chromosome.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Inversion">
      <data key="d0">Inversion</data>
      <data key="d1">mutation</data>
      <data key="d2">Inversion is the switching of parts within a chromosome, such as inv(16) and inv(3).</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="Amplification">
      <data key="d0">Amplification</data>
      <data key="d1">mutation</data>
      <data key="d2">Amplification is an increase in the number of copies of a gene or chromosome segment.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560696</data>
      <data key="d6" />
    </node>
    <node id="AML Cell">
      <data key="d0">AML Cell</data>
      <data key="d1">other</data>
      <data key="d2">AML cells are leukemic cells that have genetic mutations, changes in genes or chromosomes, used for diagnosis and targeted therapy.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Genetic Profiling">
      <data key="d0">Genetic Profiling</data>
      <data key="d1">concept</data>
      <data key="d2">Genetic profiling involves analyzing the genetic mutations and expression patterns in leukemia cells to determine subtype, prognosis, and treatment options.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Inheritance">
      <data key="d0">Inheritance</data>
      <data key="d1">concept</data>
      <data key="d2">Inheritance in the context of leukemia refers to the passing down of genetic predisposition genes that can increase leukemia risk.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Leukemia Predisposition Syndrome">
      <data key="d0">Leukemia Predisposition Syndrome</data>
      <data key="d1">other</data>
      <data key="d2">Leukemia predisposition syndrome is a hereditary condition that increases an individual’s risk of developing leukemia.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Hematopoietic Cell Donors">
      <data key="d0">Hematopoietic Cell Donors</data>
      <data key="d1">other</data>
      <data key="d2">Biological family members or donors can be tested for leukemia predisposition syndromes to assess their risk or potential as stem cell donors.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Mutation Testing">
      <data key="d0">Mutation Testing</data>
      <data key="d1">method</data>
      <data key="d2">Mutation testing evaluates leukemia cells’ DNA for specific mutations or genetic abnormalities to determine treatment options.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="NGS">
      <data key="d0">NGS</data>
      <data key="d1">method</data>
      <data key="d2">Next-generation sequencing provides detailed DNA sequencing to identify mutations.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Hereditary Cancer Syndrome">
      <data key="d0">Hereditary Cancer Syndrome</data>
      <data key="d1">other</data>
      <data key="d2">Hereditary cancer syndromes are inherited genetic conditions that increase the risk of developing leukemia and other cancers.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Tumor Markers">
      <data key="d0">Tumor Markers</data>
      <data key="d1">content</data>
      <data key="d2">Tumor markers like CEA, CA 15-3 are substances tested in blood or tissue that may indicate cancer presence or progression.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="PD-1">
      <data key="d0">PD-1</data>
      <data key="d1">content</data>
      <data key="d2">Programmed death protein 1 (PD-1) is an immune protein expressed on cancer cells, impacting immune response and treatment options.&lt;SEP&gt;PD-1 is an off switch in the immune system exploited by tumors to evade immune response.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Next-generation sequencing">
      <data key="d0">Next-generation sequencing</data>
      <data key="d1">method</data>
      <data key="d2">Next-generation sequencing (NGS) is a high-throughput DNA sequencing technique used to analyze gene mutations in tumors.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Family Cancer Health History">
      <data key="d0">Family Cancer Health History</data>
      <data key="d1">concept</data>
      <data key="d2">Family cancer health history involves collecting information about cancer occurrences in relatives to assess genetic risk.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Distress Screening">
      <data key="d0">Distress Screening</data>
      <data key="d1">concept</data>
      <data key="d2">Distress screening evaluates emotional and psychological responses to a cancer diagnosis, aiding supportive care.&lt;SEP&gt;Distress screening involves assessing the level of distress as part of cancer care.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Hereditary Cancers">
      <data key="d0">Hereditary Cancers</data>
      <data key="d1">concept</data>
      <data key="d2">Hereditary cancers are types of cancers caused by inherited gene mutations, such as those involving BRCA genes.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1764560697</data>
      <data key="d6" />
    </node>
    <node id="Cancer Reports">
      <data key="d0">Cancer Reports</data>
      <data key="d1">content</data>
      <data key="d2">Cancer reports document findings from diagnostic tests related to specific cancer types.&lt;SEP&gt;Documents that contain interpretations of diagnostic tests and imaging results about specific cancer types.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
